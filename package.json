{
    "name": "himmelszelt",
    "private": true,
    "description": "Monorepo of the @himmelszelt/* sky-rendering libraries and their site, sternwarte.",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "dev": "pnpm --filter @himmelszelt/sternwarte dev",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "size": "size-limit",
        "size:watch": "pnpm run \"/^size:watch:/\"",
        "size:watch:build": "pnpm --parallel --filter \"./packages/**\" exec rolldown -c rolldown.config.ts --watch",
        "size:watch:measure": "size-limit --watch",
        "format": "biome format --write .",
        "lint": "biome check .",
        "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/dunstkreis/static/bundle.js site/node_modules site/dist site/.astro"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@size-limit/preset-small-lib": "14.2.0",
        "size-limit": "14.2.0"
    },
    "packageManager": "pnpm@11.20.0"
}
