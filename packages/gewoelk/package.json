{
    "name": "@himmelszelt/gewoelk",
    "version": "0.1.0",
    "description": "Clouds on WebGPU after Nubis3: a voxel cloudscape built on the GPU from a cloud map, marched by its distance field and lit per voxel, and sheets of high cloud.",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "author": "Daniel Limberger <cgdaniel@outlook.com> (https://github.com/cgcostume)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cgcostume/himmelszelt.git",
        "directory": "packages/gewoelk"
    },
    "homepage": "https://github.com/cgcostume/himmelszelt/tree/main/packages/gewoelk#readme",
    "keywords": [
        "clouds",
        "volumetric-clouds",
        "nubis",
        "sky-rendering",
        "webgpu",
        "compute-shader"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rolldown -c rolldown.config.ts",
        "typecheck": "tsc --noEmit",
        "test": "pnpm build && playwright test",
        "test:gpu": "pnpm build && GEWOELK_GPU=1 playwright test"
    },
    "devDependencies": {
        "@himmelszelt/dunstkreis": "workspace:*",
        "@himmelszelt/helldunkel": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.6.2",
        "@webgpu/types": "^0.1.71",
        "rolldown": "^1.2.2",
        "rolldown-plugin-dts": "^0.28.0",
        "typescript": "^7.0.2",
        "webgpu": "^0.6.1"
    }
}
