{
    "name": "@himmelszelt/sternenheer",
    "version": "0.1.0",
    "description": "The stars on WebGPU: the nine thousand stars of the Yale Bright Star Catalogue and the Milky Way behind them, drawn by compute passes in cd/m² over your sky, dimmed, bent and twinkling in the air near the horizon, into a texture you own.",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "author": "Daniel Limberger <cgdaniel@outlook.com> (https://github.com/cgcostume)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cgcostume/himmelszelt.git",
        "directory": "packages/sternenheer"
    },
    "homepage": "https://github.com/cgcostume/himmelszelt/tree/main/packages/sternenheer#readme",
    "keywords": [
        "stars",
        "star-catalog",
        "milky-way",
        "night-sky",
        "scintillation",
        "sky-rendering",
        "webgpu",
        "compute-shader"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "bin": {
        "sternenheer": "scripts/data.mjs"
    },
    "files": [
        "dist",
        "scripts",
        "assets.json",
        "data/brightstars.bin.gz",
        "data/brightstars-compact.bin.gz",
        "data/brightstars.csv",
        "data/constellations.bin",
        "data/constellations.csv",
        "data/milkyway-2k.webp",
        "data/milkyway-4k.webp",
        "data/milkyway.json",
        "data/LICENSE.md",
        "data/LICENSE-d3-celestial.txt",
        "data/README.md"
    ],
    "scripts": {
        "build": "rolldown -c rolldown.config.ts",
        "typecheck": "tsc --noEmit",
        "test": "pnpm build && playwright test",
        "test:gpu": "pnpm build && STERNENHEER_GPU=1 playwright test",
        "data:catalog": "node scripts/catalog.mjs",
        "data:constellations": "node scripts/constellations.mjs",
        "data:hipparcos": "node scripts/hipparcos.mjs",
        "data:tycho": "node scripts/tycho.mjs",
        "data:milkyway": "node scripts/milkyway.mjs",
        "assets": "node scripts/data.mjs assets",
        "data": "pnpm data:catalog && pnpm data:hipparcos && pnpm data:tycho && pnpm data:constellations && pnpm data:milkyway"
    },
    "peerDependencies": {
        "sharp": "^0.35.4"
    },
    "peerDependenciesMeta": {
        "sharp": {
            "optional": true
        }
    },
    "devDependencies": {
        "@himmelszelt/dunstkreis": "workspace:*",
        "@himmelszelt/helldunkel": "workspace:*",
        "@himmelszelt/sternzeit": "workspace:*",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.6.2",
        "@webgpu/types": "^0.1.71",
        "rolldown": "^1.2.2",
        "rolldown-plugin-dts": "^0.28.0",
        "sharp": "^0.35.4",
        "typescript": "^7.0.2",
        "webgpu": "^0.6.1"
    }
}
