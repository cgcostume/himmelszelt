---
import Icon from "./Icon.astro";

/** The button that copies all it takes to see its figure again, as JSON (see figure-info.ts); figure-actions.ts puts it
 *  in the figure's actions, after the download. */
---

<button type="button" class="view-icon copy-info" data-field="copyInfo" title="Copy this view: a link to it, its caption and every setting it shows, as JSON" aria-label="Copy this view"><Icon name="copy" /></button>
