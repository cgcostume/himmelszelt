---
/**
 * A figure that is planned but not built yet: what it will show, in a few sentences. Not numbered like a figure. `plan`
 * notes what is likely to happen to it: merged into another figure, dropped or moved elsewhere.
 */
interface Props {
    title: string;
    plan?: string;
}
const { title, plan } = Astro.props;
---

<aside class="planned-figure">
    <p class="planned-figure-title">Planned figure: {title}</p>
    <slot />
    {plan && <p class="planned-figure-plan">Plan: {plan}</p>}
</aside>

<style>
    .planned-figure {
        margin: 1.5rem 0;
        padding: 0.75rem 1rem;
        border: 1px dashed var(--muted);
        border-radius: 6px;
        color: var(--muted);
    }
    .planned-figure-title {
        margin: 0 0 0.25rem;
        font-size: var(--text-small);
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .planned-figure-plan {
        font-size: var(--text-small);
        font-style: normal;
    }
    .planned-figure :global(p:last-child) {
        margin-bottom: 0;
    }
</style>
