---
/** A row of resolutions to choose from, each with a spinner for while it comes, and a progress bar under the row: the
 *  environments' and the Moon's maps'. Whatever holds it sets `data-busy` on the button coming, and `data-progress`
 *  and `--progress` on itself. */
import Icon from "./Icon.astro";
import type { IconName } from "./icons";
import "./resolutions.css";

interface Props {
    options: readonly (readonly [value: string, icon: IconName, title: string])[];
    chosen: string;
}
const { options, chosen } = Astro.props;
---

<span class="view-buttons env-resolutions" style={`--count: ${options.length}`}>
    {options.map(([value, name, title]) => (
        <button type="button" class="view-icon env-resolution" data-resolution={value} aria-pressed={value === chosen ? "true" : "false"} title={title} aria-label={title}>
            <Icon name={name} />
            <Icon name="loading" />
        </button>
    ))}
    <span class="env-progress" aria-hidden="true"><span></span></span>
</span>

<script>
    // Where the row collapses to the chosen resolution, pressing it opens the others under it, and choosing one, or
    // pressing anywhere else, closes them again. The figure itself hears every choice as before.
    const narrow = window.matchMedia("(max-width: 40rem)");
    for (const group of document.querySelectorAll<HTMLElement>(".env-resolutions")) {
        group.addEventListener(
            "click",
            (event) => {
                const button = (event.target as Element).closest<HTMLElement>("[data-resolution]");
                if (!button || !narrow.matches) return;
                if (button.getAttribute("aria-pressed") === "true" && !group.hasAttribute("data-open")) {
                    event.stopImmediatePropagation();
                    group.setAttribute("data-open", "");
                } else group.removeAttribute("data-open");
            },
            { capture: true },
        );
        document.addEventListener("pointerdown", (event) => {
            if (!group.contains(event.target as Node)) group.removeAttribute("data-open");
        });
    }
</script>
