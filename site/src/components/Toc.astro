---
/** The chapter's sections, folded under the lead like the moment and place, for chapters long enough to need them. */
interface Props {
    sections: { slug: string; text: string }[];
}
const { sections } = Astro.props;
const entries = [...sections, { slug: "references", text: "References" }];
---

{
    sections.length >= 3 && (
        <details class="fold toc">
            <summary>
                <span class="fold-title">Contents</span>
            </summary>
            <ol>
                {entries.map((heading) => (
                    <li>
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                ))}
            </ol>
        </details>
    )
}
