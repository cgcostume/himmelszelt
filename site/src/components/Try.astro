---
/**
 * One experiment at the end of a figure's caption: a link that sets the moment and the place (see state.ts), named by
 * `label`, and what the figure then shows, in the slot. `set` is the link's query without the "?", `fig` the figure's
 * id, scrolled to.
 */
interface Props {
    label: string;
    set: string;
    fig: string;
}
const { label, set, fig } = Astro.props;
---

<span class="figure-try"
    ><svg viewBox="0 0 16 16" aria-hidden="true"
        ><path d="M8 1.75a4.25 4.25 0 0 0-2.5 7.7c.45.33.75.8.75 1.35v.7h3.5v-.7c0-.55.3-1.02.75-1.35A4.25 4.25 0 0 0 8 1.75ZM6.5 13.75h3"
        ></path></svg
    ><a href={`?${set}#${fig}`}>{label}</a>: <slot /></span
>

<style>
    /* On a line of its own under the caption, in the text's color rather than the caption's muted one, behind a bulb in
       the Sun's low gold. */
    .figure-try {
        display: block;
        margin-top: 0.4em;
        color: var(--text);
    }
    svg {
        width: 1.1em;
        height: 1.1em;
        margin-right: 0.3em;
        vertical-align: -0.2em;
        fill: none;
        stroke: var(--golden-hour);
        stroke-width: 1.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
</style>
