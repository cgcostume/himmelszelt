---
/**
 * One experiment at the end of a figure's caption: a link that sets the moment and the place (see state.ts), named by
 * `label`, and what the figure then shows, in the slot. `set` is the link's query without the "?", `fig` the figure's
 * id, scrolled to.
 */
interface Props {
    label: string;
    set: string;
    fig: string;
}
const { label, set, fig } = Astro.props;
---

<span class="figure-try"
    ><b class="figure-try-label">Try</b><a href={`?${set}#${fig}`}>{label}</a>: <slot /></span
>

<style>
    /* On a line of its own under the caption, in the text's color rather than the caption's muted one, behind a label
       in the mono of the figure's number, in the Sun's low gold. */
    .figure-try {
        display: block;
        margin-top: 0.4em;
        color: var(--text);
    }
    .figure-try-label {
        margin-right: 0.8ch;
        color: var(--golden-hour);
        font-family: var(--font-mono);
        font-weight: inherit;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
</style>
