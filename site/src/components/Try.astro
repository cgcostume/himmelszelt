---
import Icon from "./Icon.astro";

/**
 * One experiment at the end of a figure's caption: a link that sets the moment and the place (see state.ts), named by
 * `label`, and what the figure then shows, in the slot. `set` is the link's query without the "?", `fig` the figure's
 * id, scrolled to.
 */
interface Props {
    label: string;
    set: string;
    fig: string;
}
const { label, set, fig } = Astro.props;
---

<span class="figure-try"
    ><Icon name="bulb" /><a href={`?${set}#${fig}`}>{label}</a>: <slot /></span
>

<style>
    /* On a line of its own under the caption, in the text's color rather than the caption's muted one, behind a bulb in
       the Sun's low gold. */
    .figure-try {
        display: block;
        margin-top: 0.4em;
        color: var(--text);
    }
    .figure-try > :global(.icon) {
        width: 1.1em;
        height: 1.1em;
        margin-right: 0.3em;
        vertical-align: -0.2em;
        fill: none;
        stroke: var(--golden-hour);
        stroke-width: 1.05;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
</style>
