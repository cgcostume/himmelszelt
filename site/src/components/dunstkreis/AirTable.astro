---
import Term from "../Term.astro";
import "./dunstkreis.css";
import "./flicker.css";
import "./airtable.css";

/** The air table of one observer height, texel by texel, and what it does to the Moon low over the horizon: lifted,
 *  squeezed, reddened and its colors spread. From `airTable` on the CPU, no GPU. */
const at = (value: number, min: number, max: number) => `left: ${(((value - min) / (max - min)) * 100).toFixed(2)}%`;
const TEMPERATURE = { min: -30, max: 40 };
---

<figure class="fig scene-frame air-table" id="air-table" data-air-table>
    <div class="air-table-export" data-export="air-table" data-export-timeless data-actions-in=".air-table-views">
        <figure class="fig-tile air-table-texels">
            <svg data-field="texels" role="img" aria-label="The air table's 256 by 5 texels, each channel a stripe of its own, over the apparent altitude"></svg>
            <figcaption>
                <span><span class="subfigure-title">the table</span>, 256 × 5 texels of four floats</span>
                <span class="air-table-views" role="group" aria-label="How the table is shown">
                    <button type="button" class="view-toggle" data-view="texels" aria-pressed="true" title="The texels as a texture viewer shows them, each channel normalized to its own range">texels</button>
                    <button type="button" class="view-toggle" data-view="values" aria-pressed="false" title="The bend as the table holds it, in arcminutes, and how far the air shows red and blue from green, in arcseconds">values</button>
                </span>
            </figcaption>
        </figure>
        <div class="fig-row">
            <figure class="fig-tile">
                <div class="flicker-panel as-seen">
                    <svg data-field="moon" role="img" aria-label="The Moon low over the horizon, lifted and squeezed by the air, its true place dashed"></svg>
                </div>
                <figcaption><span class="subfigure-title">the Moon</span>, to scale</figcaption>
            </figure>
            <figure class="fig-tile">
                <div class="flicker-panel as-seen">
                    <svg data-field="limb" role="img" aria-label="The Moon's limb, magnified, its red, green and blue images apart"></svg>
                </div>
                <figcaption><span class="subfigure-title">its <span data-field="limbName">lower</span> limb</span>, magnified</figcaption>
            </figure>
        </div>
    </div>
    <label class="figure-slider" title="The true altitude of the Moon's center, where it would be without the air, the horizon end stretched">
        <span class="note">Altitude</span>
        <span class="figure-slider-rail">
            <input type="range" data-field="altitude" min="0" max="1" step="0.001" value="0.27" aria-label="The Moon's true altitude, on a stretched scale" />
            <span class="figure-slider-scale" aria-hidden="true">
                <span class="figure-slider-mark" style="left: 0%">set</span>
                <span class="figure-slider-mark" style="left: 100%">high</span>
            </span>
        </span>
        <output data-field="altitudeValue"></output>
    </label>
    <label class="figure-slider" title="How high the observer stands, from the ground to the space station's orbit">
        <span class="note">Observer</span>
        <span class="figure-slider-rail">
            <input type="range" data-field="height" min="0" max="5.61" step="0.01" value="0" aria-label="The observer's height, on a scale of powers of ten" />
            <span class="figure-slider-scale" aria-hidden="true">
                <span class="figure-slider-mark" style="left: 0%">1 m</span>
                <span class="figure-slider-mark" style="left: 53.5%">1 km</span>
                <span class="figure-slider-mark" style="left: 100%">orbit</span>
            </span>
        </span>
        <output data-field="heightValue"></output>
    </label>
    <label class="figure-slider" title="The air's temperature at sea level, at a pressure of 1013 hPa: colder air is denser and bends light more">
        <span class="note">Air</span>
        <span class="figure-slider-rail">
            <input type="range" data-field="temperature" min={TEMPERATURE.min} max={TEMPERATURE.max} step="1" value="15" aria-label="The air's temperature at sea level, in degrees Celsius" />
            <span class="figure-slider-scale" aria-hidden="true">
                <span class="figure-slider-mark" style={at(-20, TEMPERATURE.min, TEMPERATURE.max)}>winter</span>
                <span class="figure-slider-mark" style={at(15, TEMPERATURE.min, TEMPERATURE.max)}>standard</span>
            </span>
        </span>
        <output data-field="temperatureValue"></output>
    </label>
    <p class="view-status" data-field="note" aria-live="polite"></p>
    <figcaption class="figure-caption">
        The air table of one observer height. (a) Its texels, each channel normalized, logarithmic for
        the <Term of="Airmass">airmass</Term> and the turbulence, or its values; the accent marks the Moon. (b) The
        Moon, its true place dashed. (c) Its lower limb, or the upper one if hidden, magnified: the air parts its colors.
    </figcaption>
</figure>

<script>
    import { airTableFigure } from "./airtable";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-air-table]")) airTableFigure(root);
</script>
