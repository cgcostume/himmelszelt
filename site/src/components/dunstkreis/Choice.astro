---
/** A row of buttons of which one is chosen, over the lighting figure: a radio group styled as steps. */
interface Props {
    name: string;
    label: string;
    title: string;
    options: string[][];
    checked: string;
}
const { name, label, title, options, checked } = Astro.props;
---

<span class="steps" role="radiogroup" aria-label={label} title={title}>
    {
        options.map(([value, text]) => (
            <label>
                <input type="radio" name={`lighting-${name}`} value={value} checked={value === checked} />
                <span>{text}</span>
            </label>
        ))
    }
</span>
