---
import "../sternzeit/sternzeit.css";
import Try from "../Try.astro";
import Choice from "./Choice.astro";
import "./dunstkreis.css";
import OptionGroup from "./OptionGroup.astro";
import SkyFrame from "./SkyFrame.astro";
import "./projections.css";

const PROJECTION = {
    figure: "projections",
    name: "projection",
    label: "Projection",
    title: "How the sphere of directions is laid out on the texture",
    options: [
        ["cube", "cube map", "Six perspective views, the sides of a cube, as createCubePass writes them"],
        ["cubified", "cubified", "Texels spread evenly over the sphere, as osgHimmel's CubeMappedHimmel did"],
        ["equirectangular", "equirectangular", "Azimuth across, zenith angle down, 2:1, as HDRIs are shared"],
        ["octahedral", "octahedral", "The sphere onto an octahedron, unfolded into a square, the zenith in the middle"],
        ["fisheye", "fisheye", "The upper hemisphere as an all-sky camera sees it, azimuthal equidistant"],
        [
            "sphere",
            "sphere map",
            "The whole sphere as a mirror ball shows it, equal in area, the nadir all round the rim",
        ],
    ],
    checked: "cube",
};
const SIZE = {
    figure: "projections",
    name: "budget",
    label: "Size",
    title: "XS to L about as many texels in each projection, to compare them; HD and UHD the sizes maps commonly come in",
    options: [
        ["xs", "XS", "About 400 texels"],
        ["s", "S", "About 1,600 texels"],
        ["m", "M", "About 6,400 texels"],
        ["l", "L", "About 25,600 texels"],
        ["hd", "HD", "Faces of 1024 for a cube map, 2048 across for the others"],
        ["uhd", "UHD", "Faces of 2048 for a cube map, 4096 across for the others"],
    ],
    checked: "xs",
};
const FILTER = {
    figure: "projections",
    name: "filter",
    label: "Filter",
    title: "Texel by texel, bilinear by the hardware's sampler as a renderer reads it, or bicubic",
    options: [
        ["nearest", "nearest"],
        ["linear", "bilinear"],
        [
            "cubic",
            "bicubic",
            "Catmull-Rom over 4 by 4 texels, by hand in the shader: smooth where texels meet and across the cube's edges, where bilinear bends",
        ],
    ],
    checked: "nearest",
};
---

<figure class="scene-frame wide" id="projections">
    <SkyFrame viewClass="projections-view" panel="inside" locked={false} lockTitle="Look towards the Sun's true direction; dragging lets go" gridTitle="Grid: lines of altitude every 10°, the compass directions, the zenith and the nadir, and the Sun's symbol where it truly is">
        <canvas aria-label="The sky's texels seen from inside, looking around"></canvas>
        <div class="projections-marks" aria-hidden="true"></div>
        <div class="projections-inset" data-panel="flat">
            <canvas aria-label="The same texture as stored"></canvas>
            <div class="projections-marks" aria-hidden="true"></div>
        </div>
        <p class="projections-legend note" hidden>
            <span>4 times sparser</span><span class="projections-ramp" aria-hidden="true"></span><span>4 times denser</span>
        </p>
        <Fragment slot="options">
            <OptionGroup name="projection">
                <Choice {...PROJECTION} />
            </OptionGroup>
            <OptionGroup name="size">
                <Choice {...SIZE} />
            </OptionGroup>
            <OptionGroup name="filtering">
                <Choice {...FILTER} />
            </OptionGroup>
            <OptionGroup name="shown">
                <button type="button" class="view-toggle" data-field="sunDisc" aria-pressed="true" title="Draw the Sun's disc over the view from inside, pixel by pixel, as the sky figure does: never stored in the texture, where it would be one bright texel">sun disc</button>
                <button type="button" class="view-toggle" data-field="edges" aria-pressed="true" title="Outline every texel in the view from inside">texel edges</button>
                <button type="button" class="view-toggle" data-field="dither" aria-pressed="true" title="Dither the 8-bit output by a step of noise, against banding in the sky's smooth gradients">dither</button>
                <button type="button" class="view-toggle" data-field="density" aria-pressed="false" title="Color every direction by how densely the projection packs its texels there, against the same texels spread evenly over what it covers">density</button>
            </OptionGroup>
        </Fragment>
    </SkyFrame>
    <p class="view-status"><span data-field="info"></span> <span data-field="timing"></span></p>
    <div class="lut-call" data-field="call"></div>
    <figcaption class="figure-caption">
        One sky in six projections, from XS to L each in a texture of about as many texels, at HD and UHD in the sizes maps
        commonly come in, shown texel by texel, filtered bilinearly
        by the hardware or bicubically by hand: seen from inside, as from the ground, in perspective, and in the corner
        the texture as stored, a cube map as its six faces in a row, north, east, south and west upright as seen from
        inside, then the zenith and the nadir, with what the view shows outlined and the rest dimmed. Below the horizon,
        the fisheye shows the ground it stores in its corner. With the density on, every direction is colored by how many texels the
        projection packs there against the same texels spread evenly over what it covers, in ColorBrewer's RdBu: blue
        where they are sparse, red where dense.
        <Try label="Midnight sun" set="date=2026-06-21T22:46:00Z&lat=69.65&lon=18.96&h=1" fig="projections">
            In Tromsø the Sun stands low in the north, its glow split between the equirectangular's two edges and whole
            at the top of the fisheye.
        </Try>
    </figcaption>
</figure>

<script>
    import "./projections";
</script>
