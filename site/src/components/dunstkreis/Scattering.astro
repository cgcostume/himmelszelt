---
import "../sternzeit/sternzeit.css";
import Term from "../Term.astro";
import "./dunstkreis.css";
---

<figure class="strip-figure" id="scattering">
    <div class="strip-panel scattering-panel" data-export="scattering" data-export-timeless>
        <svg aria-hidden="true"></svg>
    </div>
    <figcaption class="figure-caption">
        How strongly the air scatters each wavelength at sea level, its <Term of="Scattering coefficient">scattering coefficient</Term>,
        per km and, on the right, as multiples of red's: by air molecules, <Term of="Rayleigh scattering">Rayleigh scattering</Term>,
        steeply more towards the violet, and by haze, <Term of="Mie scattering">Mie scattering</Term>, in the model the same at
        every wavelength. The sunlight above the air is the plot's baseline, as colors.
    </figcaption>
</figure>

<script>
    import "./scattering";
</script>
