---
import "../sternzeit/sternzeit.css";
import "./dunstkreis.css";

/** Every table with the range of sizes and sample counts it can be set to; the defaults are dunstkreis' own. */
const TABLES = [
    {
        name: "transmittance",
        title: "Transmittance",
        axes: "view angle × altitude",
        width: { min: 8, max: 1024, presets: [64, 128, 256, 512, 1024] },
        height: { min: 4, max: 256, presets: [16, 32, 64, 128, 256] },
        samples: {
            min: 1,
            max: 500,
            step: 1,
            label: "steps per ray to the top",
            title: "Integration steps along the ray from the texel's point to the top of the atmosphere. With refraction, 18 bent rays per texel find the one arriving from its direction.",
        },
        x: ["straight up", "view angle, spaced by the distance to the top", "just below the horizon"],
        y: ["top", "altitude", "ground"],
    },
    {
        name: "multiScattering",
        title: "Multiple scattering",
        axes: "sun angle × altitude",
        width: { min: 4, max: 128, presets: [8, 16, 32, 64, 128] },
        height: { min: 4, max: 128, presets: [8, 16, 32, 64, 128] },
        samples: {
            min: 1,
            max: 64,
            step: 1,
            label: "steps per ray, 64 rays",
            title: "Integration steps along each of the 8 × 8 rays a texel sends out over the sphere to gather light scattered once more.",
        },
        x: ["sun −90°", "sun elevation", "sun +90°"],
        y: ["top", "altitude", "ground"],
    },
    {
        name: "skyView",
        title: "Sky view",
        axes: "azimuth from the sun × angle from the horizon",
        width: { min: 8, max: 1024, presets: [48, 96, 192, 384, 768] },
        height: { min: 4, max: 576, presets: [27, 54, 108, 216, 432] },
        samples: {
            min: 1,
            max: 128,
            step: 1,
            label: "steps per view ray",
            title: "Integration steps along each texel's view ray, out to the ground or the top of the atmosphere. From above the atmosphere the sky pass raymarches every pixel with as many.",
        },
        x: ["towards the sun", "azimuth from the sun", "away from it"],
        y: ["zenith", "angle from the horizon, which is in the middle", "nadir"],
    },
];
---

<figure class="scene-frame" id="tables">
    <div class="lut-bar">
        <button type="button" class="view-toggle" data-field="refraction" aria-pressed="true" title="Let the air bend the light, recomputing the tables">refraction</button>
        <span class="note">ground light</span>
        <span class="steps" role="radiogroup" aria-label="Ground light" title="Samples of the sky lighting the ground below the horizon, as well as the sun: none, or 8 or 64 spread over the sky above by the golden sets">
            {
                [
                    [0, "none"],
                    [8, "8"],
                    [64, "64"],
                ].map(([value, label]) => (
                    <label>
                        <input type="radio" name="ground-light" value={value} checked={value === 64} />
                        <span>{label}</span>
                    </label>
                ))
            }
        </span>
        <button type="button" class="view-toggle" data-field="reset" title="Back to dunstkreis' defaults">defaults</button>
        <span class="note" data-field="timing"></span>
    </div>
    {
        TABLES.map((table) => (
            <section class="lut" data-lut={table.name}>
                <p class="lut-head">
                    <strong>{table.title}</strong> <span class="note">{table.axes}</span>
                </p>
                <p class="lut-controls">
                    <input
                        type="number"
                        data-config={`${table.name}.width`}
                        min={table.width.min}
                        max={table.width.max}
                        step="1"
                        aria-label={`${table.title} width`}
                    />
                    ×
                    <input
                        type="number"
                        data-config={`${table.name}.height`}
                        min={table.height.min}
                        max={table.height.max}
                        step="1"
                        aria-label={`${table.title} height`}
                    />
                    <label title={table.samples.title}>
                        {table.samples.label}
                        <input
                            type="range"
                            data-config={`integralSamples.${table.name}`}
                            min={table.samples.min}
                            max={table.samples.max}
                            step={table.samples.step}
                        />
                        <output />
                    </label>
                    <span class="note" data-field="info" />
                </p>
                <p class="lut-controls lut-presets">
                    {(["width", "height"] as const).map((axis) => (
                        <span class="steps" role="radiogroup" aria-label={`${table.title} ${axis}`}>
                            {table[axis].presets.map((n) => (
                                <label>
                                    <input
                                        type="radio"
                                        name={`${table.name}-${axis}`}
                                        value={n}
                                        data-preset={`${table.name}.${axis}`}
                                    />
                                    <span>{n}</span>
                                </label>
                            ))}
                        </span>
                    ))}
                </p>
                <div class="lut-plot">
                    <span class="lut-axis lut-y">
                        <span>{table.y[0]}</span>
                        <span>{table.y[1]}</span>
                        <span>{table.y[2]}</span>
                    </span>
                    <div class="lut-stage">
                        <canvas data-field="image" aria-label={`The ${table.title.toLowerCase()} table`} />
                        <canvas data-field="overlay" aria-hidden="true" />
                        <div class="lut-tip" data-field="tip" hidden />
                    </div>
                    <span class="lut-axis lut-x">
                        <span>{table.x[0]}</span>
                        <span>{table.x[1]}</span>
                        <span>{table.x[2]}</span>
                    </span>
                </div>
            </section>
        ))
    }
    <figcaption class="figure-caption">
        The tables behind the sky above, as they are right now, and what they are computed with. Transmittance and
        multiple scattering change only with the air; the sky view with every move of the Sun or the observer. Shown
        tone mapped, each by its own scale; point at a texel to read what it stands for.
    </figcaption>
</figure>

<script>
    import "./tables.js";
</script>
