---
import "../sternzeit/controls.css";
import "./environments.css";

/**
 * The HDRI, as the moment and place are: one choice for the whole page, set from any of its boxes,
 * under every figure that shows it. Beside the rail, which holds the same choice, folded but on the first visit.
 */
interface Props {
    /** Starts unfolded; folded shows a one-line summary of the current choice. */
    open?: boolean;
}
const { open = false } = Astro.props;
---

<details class="moment environments" data-environments open={open}>
    <summary>
        <span class="moment-title">Environment</span> <span class="note" data-field="summary">Loading…</span>
    </summary>
    <div class="environments-gallery" data-field="gallery" role="group" aria-label="HDRIs"></div>
    <input type="search" data-field="search" placeholder="Search Poly Haven" aria-label="Search Poly Haven's HDRIs by name, category or tag" />
    <p class="environments-own">
        <label class="environments-action">your own .hdr<input type="file" accept=".hdr" data-field="file" hidden /></label>
        <span>or drop one on this box or on a figure showing the image</span>
    </p>
    <p class="environments-status" data-field="status"></p>
    <p class="environments-thanks">
        These skies are from <a href="https://polyhaven.com/hdris"><strong>Poly Haven</strong></a>, thank you. They give away some thousand HDRIs, textures and models for anyone to use under <a href="https://polyhaven.com/license">CC0</a>: <a href="https://polyhaven.com/">go and have a look</a>, and if they help you, <a href="https://www.patreon.com/polyhaven">support them on Patreon</a>. Fetched live through <a href="https://polyhaven.com/our-api">their API</a>: this site is powered by it, not made, owned or endorsed by Poly Haven, and hosts none of the files.
    </p>
</details>
{/* Beside the rail folded, as authored on a chapter's first visit only, set before the first paint so that nothing moves. */}
<script is:inline>
    try {
        const box = document.currentScript.previousElementSibling;
        if (matchMedia("(min-width: 80rem)").matches && document.querySelector(".rail [data-environments]")) {
            const key = `sternwarte:hdri-seen:${location.pathname.replace(/\/$/, "")}`;
            window.sternwarteHdriSeen ??= localStorage.getItem(key) === "1";
            if (window.sternwarteHdriSeen) box.open = false;
            else localStorage.setItem(key, "1");
        }
    } catch {}
</script>

<script>
    import "./environments";
</script>
