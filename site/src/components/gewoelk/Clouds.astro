---
import "../sternzeit/sternzeit.css";
import "../dunstkreis/dunstkreis.css";
import "./clouds.css";
import Choice from "../dunstkreis/Choice.astro";
import OptionGroup from "../dunstkreis/OptionGroup.astro";
import SkyFrame from "../dunstkreis/SkyFrame.astro";
import Try from "../Try.astro";

/**
 * The clouds figure: dunstkreis' sky in cd/m² behind gewoelk's clouds, composed and tone mapped by the cloud pass, in
 * the shared frame. Its options set the cloudscape, the sheet, the light's parts and the render's cost.
 */
interface Props {
    id?: string;
    caption?: string;
    try?: { label: string; set: string; text: string };
}
const {
    id = "clouds",
    caption = "The clouds at the chosen moment and place over dunstkreis' sky: a cloudscape of low clouds marched through its voxel volume, and a sheet of cirrus above. The compass directions on the horizon.",
    try: experiment,
} = Astro.props;

type Slider = [param: string, label: string, min: number, max: number, step: number, value: number, title: string];
const CLOUDSCAPE: Slider[] = [
    ["cloudscape.coverage", "coverage", 0, 1, 0.01, 0.42, "How much of the sky the low clouds cover"],
    ["cloudscape.sharpness", "sharpness", 0, 0.9, 0.01, 0.35, "How hard their edges are"],
    [
        "cloudscape.size",
        "size",
        0.5,
        3,
        0.05,
        1,
        "How much larger the clouds are, every length of them but the base's height: plusher, not nearer",
    ],
    [
        "cloudscape.extinction",
        "density",
        4,
        128,
        1,
        32,
        "Extinction per km of full density: less lets the light deeper in and the clouds glow, more makes them opaque, their undersides darker, their edges harder",
    ],
    [
        "cloudscape.towers",
        "towers",
        0,
        1,
        0.01,
        0.3,
        "How much of the layer grows into towers that rise through it and spread at the top",
    ],
    ["cloudscape.towerScale", "tower height", 1, 4, 0.1, 1.5, "How many times taller than the layer the towers grow"],
    [
        "cloudscape.billows",
        "billows",
        0,
        0.3,
        0.01,
        0.12,
        "How deep billows heap up the clouds' surface, as a share of the layer's height",
    ],
    ["cloudscape.baseKm", "base", 0.3, 4, 0.1, 1.2, "The height of the layer's base, in km"],
    ["cloudscape.heightKm", "height", 0.5, 5, 0.1, 2.4, "How tall the layer is, in km"],
    [
        "cloudscape.offset",
        "offset",
        0,
        0.6,
        0.01,
        0.25,
        "How far the bottoms dip below the base level: 0 for bottoms as rounded as the tops",
    ],
    [
        "cloudscape.windSpeed",
        "wind",
        0,
        40,
        1,
        8,
        "The wind the low clouds drift with, in m/s; the time slider and play move them",
    ],
    [
        "cloudscape.windFrom",
        "from",
        0,
        360,
        5,
        70,
        "Where the low clouds' wind blows from, in degrees from north through east",
    ],
    [
        "cloudscape.evolution",
        "change",
        0,
        4,
        0.1,
        0,
        "How fast the low clouds change shape, in changes per hour: 0 keeps them",
    ],
    [
        "cloudscape.clearingFromKm",
        "clear from",
        0,
        100,
        1,
        10,
        "How far around you the low clouds are all there, in km; beyond, they grow fewer towards the clearing",
    ],
    [
        "cloudscape.clearingKm",
        "clearing",
        0,
        400,
        5,
        150,
        "Where the low clouds have cleared away, in km, so a low sun reaches them; 0 keeps them to the horizon",
    ],
    [
        "cloudscape.variation",
        "variation",
        0,
        1,
        0.05,
        0.5,
        "How far a broad field 40 km across thins the clouds out in places, so the volume's repetition hides",
    ],
];
const SHEET: Slider[] = [
    ["sheet.coverage", "coverage", 0, 1, 0.01, 0.35, "How much of the sky the high sheet covers"],
    ["sheet.altitudeKm", "altitude", 5, 12, 0.1, 9, "The sheet's height, in km"],
    ["sheet.opticalDepth", "depth", 0.1, 3, 0.1, 0.5, "The sheet's optical depth where its map reads 1"],
    [
        "sheet.ripples",
        "ripples",
        0,
        1,
        0.05,
        0,
        "How far ripples across the wind break the sheet into the waves of cirrocumulus",
    ],
    ["sheet.windSpeed", "wind", 0, 60, 1, 25, "The wind the sheet drifts with, in m/s"],
    [
        "sheet.windFrom",
        "from",
        0,
        360,
        5,
        90,
        "Where the sheet's wind blows from, in degrees from north through east: its strands run along it",
    ],
];
// The cirrus' layers of noise, broad to fine, as gewoelk's SheetNoise; sizes in km.
const NOISE: Slider[] = [
    [
        "sheet.noise.broad",
        "broad",
        0,
        1,
        0.05,
        0.4,
        "How far the sheet is denser and thinner by turns over a broad field",
    ],
    ["sheet.noise.broadKm", "broad size", 2, 40, 1, 12, "The broad field's size, in km"],
    ["sheet.noise.sweep", "sweep", 0, 3, 0.05, 1, "How far the strands sweep along a broad flow, some 15 km across"],
    ["sheet.noise.hook", "hooks", 0, 3, 0.05, 1, "How far the strands curl into hooks, some 3 km across"],
    [
        "sheet.noise.bundles",
        "bundles",
        0,
        1,
        0.05,
        0.5,
        "How strongly the strands gather into bundles, feathers with sky between",
    ],
    ["sheet.noise.bundleKm", "bundle size", 0.5, 10, 0.1, 3, "A bundle's width across the wind, in km"],
    [
        "sheet.noise.fiberPower",
        "fiber sharpness",
        1,
        12,
        0.5,
        4,
        "The power the fibers' ridges are raised to: higher, thinner strands",
    ],
    ["sheet.noise.fiberStretch", "fiber stretch", 2, 30, 1, 10, "How many times as long as wide the fibers start"],
    ["sheet.noise.flocks", "flocks", 0, 1, 0.05, 0.15, "How far tufts of turbulence break the sheet"],
    ["sheet.noise.flockKm", "flock size", 0.02, 1, 0.01, 0.15, "A tuft's size, in km"],
    ["sheet.noise.grain", "grain", 0, 1, 0.05, 0.5, "How far a fine grain of four turned octaves roughens the sheet"],
    ["sheet.noise.grainKm", "grain size", 0.01, 0.5, 0.01, 0.1, "The grain's coarsest size, in km"],
];
const SCALE = {
    name: "scale",
    label: "Render scale",
    title: "The share of the frame's pixels the clouds are marched at, then composed bilinearly: a quarter costs a quarter",
    options: [
        ["1", "full"],
        ["0.5", "half"],
        ["0.25", "quarter"],
    ],
    checked: "0.5",
};
const STEPS = {
    name: "steps",
    label: "Steps",
    title: "Steps a ray takes at most through the cloudscape",
    options: [
        ["128", "128"],
        ["256", "256"],
        ["512", "512"],
    ],
    checked: "256",
};
const WEATHER = {
    name: "weather",
    label: "Weather",
    title: "Presets of the clouds' shape, low and high: a click blends the sliders over to one",
    options: [
        ["clear", "clear"],
        ["fair", "fair"],
        ["scattered", "scattered"],
        ["towering", "towering"],
        ["overcast", "overcast"],
        ["mackerel", "mackerel"],
        ["cirrus", "cirrus"],
    ],
    checked: "scattered",
};
const AIR = {
    name: "air",
    label: "Air",
    title: "The air in front of the clouds: dunstkreis' aerial perspective volume, or a blend into the sky behind, as for a baked background",
    options: [
        ["volume", "in-scattering"],
        ["blend", "blend"],
    ],
    checked: "volume",
};
const LAYERS = {
    name: "layers",
    label: "Voxel layers",
    title: "Layers of voxels over the slab's height: towers several times the layer's height need more, at more memory",
    options: [
        ["32", "32"],
        ["48", "48"],
        ["64", "64"],
        ["96", "96"],
        ["128", "128"],
    ],
    checked: "64",
};
---

<figure class="scene-frame wide" id={id} data-clouds>
    <SkyFrame png grid={false} locked={false} hint="Drag to look around, scroll to zoom. Rendered with WebGPU, the clouds after Nubis3.">
        <canvas data-field="canvas" aria-label="Clouds over the sky at the chosen moment and place"></canvas>
        <div class="sky-compass" data-field="compassLabels"></div>
        <Fragment slot="options">
            <OptionGroup name="weather">
                <Choice figure={id} {...WEATHER} />
            </OptionGroup>
            <OptionGroup name="cloudscape">
                <button type="button" class="view-toggle" data-field="cloudscape.enabled" aria-pressed="true" title="The low clouds, a voxel volume marched by its distance field">low clouds</button>
                <button type="button" class="view-toggle" data-copy="cloudscape" title="Copies the low clouds' sliders as a preset for gewoelk's WEATHER">copy</button>
                {CLOUDSCAPE.map(([param, label, min, max, step, value, title]) => (
                    <label class="sky-ev clouds-slider" title={title}>{label} <input data-param={param} type="range" min={min} max={max} step={step} value={value} /> <output /></label>
                ))}
            </OptionGroup>
            <OptionGroup name="sheet">
                <button type="button" class="view-toggle" data-field="sheet.enabled" aria-pressed="true" title="A thin sheet of high cloud, read once where a ray crosses it">cirrus</button>
                <button type="button" class="view-toggle" data-copy="sheet" title="Copies the cirrus' and its noise's sliders as a preset for gewoelk's WEATHER">copy</button>
                {SHEET.map(([param, label, min, max, step, value, title]) => (
                    <label class="sky-ev clouds-slider" title={title}>{label} <input data-param={param} type="range" min={min} max={max} step={step} value={value} /> <output /></label>
                ))}
            </OptionGroup>
            <OptionGroup name="cirrus noise">
                {NOISE.map(([param, label, min, max, step, value, title]) => (
                    <label class="sky-ev clouds-slider" title={title}>{label} <input data-param={param} type="range" min={min} max={max} step={step} value={value} /> <output /></label>
                ))}
            </OptionGroup>
            <OptionGroup name="light">
                <button type="button" class="view-toggle" data-field="light.sun" aria-pressed="true" title="The Sun's light, through the summed density towards it, with its forward lobe">sun</button>
                <button type="button" class="view-toggle" data-field="light.multi" aria-pressed="true" title="The orders of scattering after the first, as octaves: each a share of the one before, through less cloud, with a wider lobe">multiple</button>
                <button type="button" class="view-toggle" data-field="light.ambient" aria-pressed="true" title="The sky's light from above and the ground's from below, fading with depth">ambient</button>
            </OptionGroup>
            <OptionGroup name="render">
                <Choice figure={id} {...SCALE} />
                <Choice figure={id} {...STEPS} />
                <Choice figure={id} {...LAYERS} />
                <Choice figure={id} {...AIR} />
            </OptionGroup>
        </Fragment>
    </SkyFrame>
    <p class="view-status"><span data-field="sun" /> <span class="sky-timing" data-field="timing" /></p>
    <figcaption class="figure-caption">
        {caption}
        {experiment && <Try label={experiment.label} set={experiment.set} fig={id}>{experiment.text}</Try>}
    </figcaption>
</figure>

<script>
    import { cloudsFigure } from "./clouds";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-clouds]")) cloudsFigure(root);
</script>
