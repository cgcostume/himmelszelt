---
import "../sternzeit/sternzeit.css";
import "../dunstkreis/dunstkreis.css";
import "./clouds.css";
import Choice from "../dunstkreis/Choice.astro";
import Hdr from "../dunstkreis/Hdr.astro";
import OptionGroup from "../dunstkreis/OptionGroup.astro";
import SkyFrame from "../dunstkreis/SkyFrame.astro";
import Try from "../Try.astro";

/**
 * The clouds figure: dunstkreis' sky in cd/m² behind gewoelk's clouds, composed and tone mapped by the cloud pass, in
 * the shared frame. Its options set the cloudscape, the sheet, the light's parts and the render's cost.
 */
interface Props {
    id?: string;
    caption?: string;
    try?: { label: string; set: string; text: string };
    /** The lab: the figure with a clock of its own, the cloudscape changing by keyframes, and what each part costs. */
    lab?: boolean;
}
const {
    lab = false,
    id = "clouds",
    caption = "The clouds at the chosen moment and place over dunstkreis' sky: a cloudscape of low clouds marched through its voxel volume, and a sheet of high cloud above. The compass directions on the horizon.",
    try: experiment,
} = Astro.props;

type Slider = [param: string, label: string, min: number, max: number, step: number, value: number, title: string];
const CLOUDSCAPE: Slider[] = [
    ["cloudscape.coverage", "coverage", 0, 1, 0.01, 0.42, "How much of the sky the low clouds cover"],
    ["cloudscape.sharpness", "sharpness", 0, 0.9, 0.01, 0.35, "How hard their edges are"],
    [
        "cloudscape.size",
        "size",
        0.5,
        3,
        0.05,
        1,
        "How much larger the clouds are, every length of them but the base's height: plusher, not nearer",
    ],
    [
        "cloudscape.extinction",
        "density",
        4,
        128,
        1,
        32,
        "Extinction per km of full density: less lets the light deeper in and the clouds glow, more makes them opaque, their undersides darker, their edges harder",
    ],
    [
        "cloudscape.towers",
        "towers",
        0,
        1,
        0.01,
        0.3,
        "How much of the layer grows into towers that rise through it and spread at the top",
    ],
    ["cloudscape.towerScale", "tower height", 1, 4, 0.1, 1.5, "How many times taller than the layer the towers grow"],
    [
        "cloudscape.billows",
        "billows",
        0,
        1,
        0.01,
        0.12,
        "How deep billows heap up the clouds' surface, as a share of the layer's height",
    ],
    ["cloudscape.baseKm", "base", 0.3, 4, 0.1, 1.2, "The height of the layer's base, in km"],
    ["cloudscape.heightKm", "height", 0.5, 5, 0.1, 2.4, "How tall the layer is, in km"],
    [
        "cloudscape.offset",
        "offset",
        0,
        0.6,
        0.01,
        0.25,
        "How far the bottoms dip below the base level: 0 for bottoms as rounded as the tops",
    ],
    [
        "cloudscape.windSpeed",
        "wind",
        0,
        40,
        1,
        8,
        "The wind the low clouds drift with, in m/s; the time slider and play move them",
    ],
    [
        "cloudscape.windFrom",
        "from",
        0,
        360,
        5,
        70,
        "Where the low clouds' wind blows from, in degrees from north through east",
    ],
    [
        "cloudscape.evolution",
        "change",
        0,
        4,
        0.1,
        0,
        "How fast the low clouds change shape, in changes per hour: 0 keeps them",
    ],
    [
        "cloudscape.clearingFromKm",
        "clear from",
        0,
        100,
        1,
        10,
        "How far around you the low clouds are all there, in km; beyond, they grow fewer towards the clearing",
    ],
    [
        "cloudscape.clearingKm",
        "clearing",
        0,
        400,
        5,
        150,
        "Where the low clouds have cleared away, in km, so a low sun reaches them; 0 keeps them to the horizon",
    ],
];
const SHEET: Slider[] = [
    ["sheet.coverage", "coverage", 0, 1, 0.01, 0.7, "How much of the sky the high sheet's patches and bands cover"],
    ["sheet.altitudeKm", "altitude", 5, 12, 0.1, 7, "The sheet's height, in km"],
    ["sheet.opticalDepth", "depth", 0.1, 3, 0.1, 1.2, "The sheet's optical depth where its map reads 1"],
    ["sheet.windSpeed", "wind", 0, 60, 1, 25, "The wind the sheet drifts with, in m/s"],
    [
        "sheet.windFrom",
        "from",
        0,
        360,
        5,
        90,
        "Where the sheet's wind blows from, in degrees from north through east: its rows and trails run along it",
    ],
];
// The kinds of high cloud, gewoelk's CLOUD_TYPES.high.
const HIGH = {
    name: "high",
    label: "Kind",
    title: "What the sheet of high cloud is made of: a click bakes its map anew",
    options: [
        ["mackerel", "mackerel", "Cirrocumulus, puffs in rows"],
        ["ripples", "ripples", "A patch of fine ripples"],
        ["ribbed", "ribbed", "A band broken into ribs across it"],
        ["puffsAndVeil", "puffs and veil", "Puffs under a veil with trails"],
        ["veil", "veil", "A veil of cirrostratus, combed along the wind"],
    ],
    checked: "puffsAndVeil",
};
// Two of gewoelk's dials of quality, `cloudQuality`'s: each a level of four.
const REACH = {
    name: "reach",
    label: "Reach",
    title: "How far the clouds are seen: sets the clearing's sliders",
    options: [
        ["low", "low", "Clouds out to 40 km"],
        ["medium", "medium", "Clouds out to 150 km"],
        ["high", "high", "Clouds to the horizon"],
        ["ultra", "ultra", "Clouds to the horizon"],
    ],
    checked: "medium",
};
const SAMPLING = {
    name: "sampling",
    label: "Sampling",
    title: "How finely the clouds are marched and stored: the share of the frame, a ray's steps, the voxels and the noise",
    options: [
        ["low", "low", "A third of the frame, 128 steps, 128 x 128 x 32 voxels"],
        ["medium", "medium", "Half the frame, 256 steps, 256 x 256 x 64 voxels"],
        ["high", "high", "The whole frame, 256 steps, 256 x 256 x 64 voxels"],
        ["ultra", "ultra", "The whole frame, 512 steps, 384 x 384 x 96 voxels"],
    ],
    checked: "medium",
};
const WEATHER = {
    name: "weather",
    label: "Weather",
    title: "Presets of the clouds' shape, low and high: a click blends the sliders over to one",
    options: [
        ["clear", "clear"],
        ["fair", "fair"],
        ["scattered", "scattered"],
        ["towering", "towering"],
        ["overcast", "overcast"],
        [
            "frontAhead",
            "front ahead",
            "A front coming on: the voxels' low clouds under a front of the layered model, marched beside them",
        ],
        [
            "underFront",
            "under the front",
            "The front overhead: a closed, dark sky, its rain where the tall columns stand",
        ],
        ["mackerel", "mackerel"],
        ["cirrus", "cirrus"],
    ],
    checked: "scattered",
};
const AIR = {
    name: "air",
    label: "Air",
    title: "The air in front of the clouds: dunstkreis' aerial perspective volume, or a blend into the sky behind, as for a baked background",
    options: [
        ["volume", "in-scattering"],
        ["blend", "blend"],
    ],
    checked: "volume",
};
// The lab's choices and sliders: how the cloudscape changes, how fast, and how much of a keyframe a frame may build.
const MODE = {
    name: "mode",
    label: "Change",
    title: "How a change of the clouds' shape or of the Sun reaches the volumes: rebuilt at once in the frame that asks, or built ahead as a keyframe, a few steps a frame, and blended in",
    options: [
        ["immediate", "immediate"],
        ["keyframes", "keyframes"],
    ],
    checked: "keyframes",
};
const SPEED = {
    name: "speed",
    label: "Speed",
    title: "How fast the lab's clock runs while it animates: the wind, the change of shape and the billows follow it",
    options: [
        ["1", "1x"],
        ["60", "60x"],
        ["360", "360x"],
        ["3600", "3600x"],
    ],
    checked: "60",
};
const BUDGET = {
    name: "budget",
    label: "Steps per frame",
    title: "How many of a keyframe's steps a frame may run: fewer spread its cost over more frames",
    options: [
        ["1", "1"],
        ["2", "2"],
        ["4", "4"],
        ["all", "all"],
    ],
    checked: "2",
};
const GRID = {
    name: "grid",
    label: "Voxels across",
    title: "Voxels east and north over the cloudscape's extent: four times the voxels and the memory per doubling",
    options: [
        ["128", "128"],
        ["256", "256"],
        ["512", "512"],
    ],
    checked: "256",
};
type LabSlider = [name: string, label: string, min: number, max: number, step: number, value: number, title: string];
const LAB: LabSlider[] = [
    [
        "billowSpeed",
        "billow speed",
        0,
        5,
        0.1,
        0.5,
        "How fast the detail noise rises through the clouds, in m/s of the lab's clock: free, nothing is rebuilt for it",
    ],
    [
        "interval",
        "keyframe",
        0.1,
        5,
        0.1,
        1,
        "How long the blend from one keyframe to the next takes, in seconds as you watch",
    ],
];
---

<figure class="fig scene-frame wide" id={id} data-clouds data-lab={lab ? "" : undefined}>
    <SkyFrame png fly ownHeight grid={false} locked={false} hint="Drag to look around, scroll to zoom. Rendered with WebGPU, the clouds after Nubis3.">
        <canvas data-field="canvas" aria-label="Clouds over the sky at the chosen moment and place"></canvas>
        <div class="cloud-textures" data-field="textures"></div>
        <div class="sky-compass" data-field="compassLabels"></div>
        <Fragment slot="options">
            {lab && (
                <OptionGroup name="change">
                    <button type="button" class="view-toggle" data-field="lab.animate" aria-pressed="false" title="Animate: the lab's clock runs, frame after frame, until switched off">animate</button>
                    <button type="button" class="view-toggle" data-field="lab.cycle" aria-pressed="false" title="While it animates, the weather moves on to the next preset every 6 seconds">cycle weather</button>
                    <Choice figure={id} {...MODE} />
                    <Choice figure={id} {...SPEED} />
                    <Choice figure={id} {...BUDGET} />
                    {LAB.map(([name, label, min, max, step, value, title]) => (
                        <label class="sky-ev clouds-slider" title={title}>{label} <input data-lab={name} type="range" min={min} max={max} step={step} value={value} /> <output /></label>
                    ))}
                </OptionGroup>
            )}
            <OptionGroup name="weather">
                <Choice figure={id} {...WEATHER} />
            </OptionGroup>
            <OptionGroup name="cloudscape · 3D">
                <button type="button" class="view-toggle" data-field="cloudscape.enabled" aria-pressed="true" title="The low clouds, a voxel volume marched by its distance field: 3D, any shape its grid can hold">low clouds</button>
                <button type="button" class="view-toggle" data-copy="cloudscape" title="Copies the low clouds' sliders as a preset for gewoelk's WEATHER">copy</button>
                {CLOUDSCAPE.map(([param, label, min, max, step, value, title]) => (
                    <label class="sky-ev clouds-slider" title={title}>{label} <input data-param={param} type="range" min={min} max={max} step={step} value={value} /> <output /></label>
                ))}
            </OptionGroup>
            <OptionGroup name="sheet · 2D">
                <button type="button" class="view-toggle" data-field="sheet.enabled" aria-pressed="true" title="A thin sheet of high cloud from a baked map, read once where a ray crosses it: 2D">high cloud</button>
                <Choice figure={id} {...HIGH} />
                {SHEET.map(([param, label, min, max, step, value, title]) => (
                    <label class="sky-ev clouds-slider" title={title}>{label} <input data-param={param} type="range" min={min} max={max} step={step} value={value} /> <output /></label>
                ))}
            </OptionGroup>
            <OptionGroup name="light">
                <button type="button" class="view-toggle" data-field="light.sun" aria-pressed="true" title="The Sun's light, through the summed density towards it, with its forward lobe">sun</button>
                <button type="button" class="view-toggle" data-field="light.multi" aria-pressed="true" title="The orders of scattering after the first, as octaves: each a share of the one before, through less cloud, with a wider lobe">multiple</button>
                <button type="button" class="view-toggle" data-field="light.ambient" aria-pressed="true" title="The sky's light from above and the ground's from below, fading with depth">ambient</button>
            </OptionGroup>
            <OptionGroup name="reach">
                <Choice figure={id} {...REACH} />
            </OptionGroup>
            <OptionGroup name="sampling">
                <Choice figure={id} {...SAMPLING} />
            </OptionGroup>
            <OptionGroup name="render">
                {lab && <Choice figure={id} {...GRID} />}
                <Choice figure={id} {...AIR} />
                <button type="button" class="view-toggle" data-field="textures.on" aria-pressed="false" title="The textures the figure renders from, down the left of the view: hover one for what it is for">textures</button>
                <button type="button" class="view-toggle" data-field="ground.grid" aria-pressed="true" title="A grid on the ground, for orientation, speed and height: thin lines every 10 km, 1 km, 100 m and on down to 1 mm, each level showing once its cells are a few pixels across">grid</button>
            </OptionGroup>
            <OptionGroup name="HDR (× SDR white)">
                <Hdr figure={id} />
            </OptionGroup>
        </Fragment>
    </SkyFrame>
    <p class="view-status"><span data-field="sun" /> <span class="sky-timing" data-field="timing" /></p>
    {lab && <p class="view-status"><span data-field="lab.cost" /></p>}
    {lab && <p class="view-status footnote"><span data-field="lab.steps" /></p>}
    <figcaption class="figure-caption">
        {caption}
        {experiment && <Try label={experiment.label} set={experiment.set} fig={id}>{experiment.text}</Try>}
    </figcaption>
</figure>

<script>
    import { cloudsFigure } from "./clouds";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-clouds]")) cloudsFigure(root);
</script>
