---
import "../../sternzeit/sternzeit.css";
import "../../dunstkreis/dunstkreis.css";
import "../clouds.css";
import Choice from "../../dunstkreis/Choice.astro";
import OptionGroup from "../../dunstkreis/OptionGroup.astro";
import SkyFrame from "../../dunstkreis/SkyFrame.astro";
import LabSliders, { type LabSlider } from "./LabSliders.astro";

/**
 * A research figure for the high cloud: a sheet as a map baked on the GPU when its sliders change, read once per pixel
 * over a stand-in sky. For finding a generator worth moving into gewoelk; nothing here is the library's yet.
 */
interface Props {
    id?: string;
    caption?: string;
}
const {
    id = "cirrus-lab",
    caption = "A sheet of high cloud from a baked map: puffs in rows, lanes of sky between ripples, a veil with striations, ribs across a band, and trails combed along the wind. The map view shows the tile itself.",
} = Astro.props;

const SHEET: LabSlider[] = [
    ["c.altitude", "altitude", 4, 12, 0.1, 7, "The sheet's height, in km"],
    ["c.opticalDepth", "depth", 0.1, 4, 0.1, 1.4, "The sheet's optical depth where the map reads 1"],
    ["c.tile", "tile", 8, 80, 1, 32, "One tile of the map, in km: larger tiles, coarser texels"],
    [
        "wind.from",
        "wind from",
        0,
        360,
        5,
        250,
        "Where the wind blows from, in degrees from north through east: the map's x axis runs along it",
    ],
    ["wind.speed", "wind", 0, 60, 1, 20, "The wind the sheet drifts with while the animation runs, in m/s"],
];
const PATCHES: LabSlider[] = [
    ["c.coverage", "coverage", 0, 1, 0.01, 0.8, "How much of the sky the sheet's patches and bands cover"],
    ["c.patchKm", "patch size", 10, 300, 5, 60, "A patch's size across, in km"],
    ["c.bandStretch", "band stretch", 1, 10, 0.1, 2, "How many times as long as wide the patches are: bands"],
    ["c.bandAngle", "band angle", 0, 180, 5, 20, "The bands' angle to the wind, in degrees"],
    ["c.edge", "edge", 0, 1, 0.05, 0.6, "How far a patch thins out towards its edge, where the puffs shrink"],
];
const CELLS: LabSlider[] = [
    ["c.cells", "puffs", 0, 1, 0.05, 1, "How much of the sheet is puffs, the cells of cirrocumulus and altocumulus"],
    ["c.cellKm", "puff size", 0.1, 1.5, 0.01, 0.32, "A puff's size across the wind, in km"],
    ["c.elongation", "elongation", 0.5, 4, 0.1, 1.1, "How many times as long along the wind as across the puffs are"],
    ["c.rows", "rows", 0, 1, 0.05, 0.7, "How regular the puffs stand, 0 scattered, 1 in rows"],
    ["c.grain", "grain", 0, 1, 0.05, 0.5, "How far lumps and a fine grain break each puff"],
    [
        "c.soft",
        "softness",
        0,
        1,
        0.05,
        0.5,
        "How far a puff fades out past its rim, read from a coarser level of the map: 0 a hard edge",
    ],
    ["c.billows", "billows", 0, 1, 0.05, 0.5, "How deep billows eat into the puffs from their rims, read per pixel"],
    ["c.billowKm", "billow size", 0.03, 0.6, 0.01, 0.14, "The largest billows' size, in km"],
    [
        "billowSpeed",
        "billow speed",
        0,
        5,
        0.1,
        0.5,
        "How fast the billows creep while the animation runs, in m/s: free, the map is not baked again for it",
    ],
];
const RIPPLES: LabSlider[] = [
    ["c.ripples", "ripples", 0, 1, 0.05, 0.7, "How far lanes of sky across the wind cut the puffs into rows"],
    ["c.rippleKm", "ripple spacing", 0.3, 6, 0.1, 1.1, "From crest to crest, in km"],
    ["c.curve", "curve", 0, 1, 0.05, 0.6, "How far the rows bend"],
    [
        "c.ribs",
        "ribs",
        0,
        1,
        0.05,
        0,
        "How far billows across a band break it into ribs, each with a sharp front and a tail",
    ],
    ["c.ribKm", "rib spacing", 1, 10, 0.1, 3.5, "From rib to rib, in km"],
];
const VEIL: LabSlider[] = [
    ["c.veil", "veil", 0, 1, 0.05, 0.08, "How much of the sheet is a veil without puffs"],
    ["c.striation", "striation", 0, 1, 0.05, 0.3, "How far the veil is drawn into fine lines along the wind"],
    ["c.stretch", "stretch", 2, 30, 1, 10, "How many times as long as wide the veil's lines are"],
    [
        "comb",
        "combing",
        0,
        48,
        2,
        0,
        "Steps of combing along the wind: each lets what lies upwind trail a little farther",
    ],
    ["c.streaks", "trail length", 0, 1, 0.05, 0.3, "How slowly a trail fades behind what it trails from"],
    ["c.bend", "trail bend", 0, 1, 0.05, 0.1, "How far the trails bend off the wind: 0 for straight, combed lines"],
];
const TIME: LabSlider[] = [
    [
        "phase",
        "phase",
        0,
        8,
        0.05,
        0,
        "The map's evolution, which loops every 8: puffs swell and fade, the fields shift",
    ],
    ["change", "change", 0, 20, 0.5, 2, "How fast the phase runs while the animation does, in steps per hour"],
    ["c.seed", "seed", 1, 99, 1, 7, "Another sky of the same kind"],
];
const LIGHT: LabSlider[] = [
    ["sun.elevation", "sun elevation", -2, 90, 1, 38, "The Sun's elevation, in degrees"],
    ["sun.azimuth", "sun azimuth", 0, 360, 5, 150, "The Sun's azimuth, in degrees from north through east"],
    ["c.relief", "relief", 0, 3, 0.1, 1, "How far a puff's sunward neighbors shade it"],
    [
        "c.forwardG",
        "forward lobe",
        0.3,
        0.95,
        0.01,
        0.8,
        "The phase function's forward asymmetry, Henyey and Greenstein's g",
    ],
    ["view.ev", "exposure", 11, 17, 0.1, 14.2, "The exposure, in EV100"],
];
const PRESET = {
    name: "preset",
    label: "Sky",
    title: "Skies to start from, after photographs: a click eases the sliders over to one",
    options: [
        ["mackerel", "mackerel"],
        ["ripples", "ripple patch"],
        ["ribbed", "ribbed band"],
        ["mixed", "puffs and veil"],
        ["veil", "veil"],
    ],
    checked: "mackerel",
};
const SIZE = {
    name: "size",
    label: "Map size",
    title: "Texels across the baked map",
    options: [
        ["1024", "1024"],
        ["2048", "2048"],
        ["4096", "4096"],
    ],
    checked: "2048",
};
const VIEW = {
    name: "view",
    label: "View",
    title: "The sheet in the sky, or its map from above, a tile as tall as the view",
    options: [
        ["sky", "sky"],
        ["map", "map"],
    ],
    checked: "sky",
};
const SPEED = {
    name: "speed",
    label: "Speed",
    title: "How fast the figure's clock runs while its animation does",
    options: [
        ["1", "1x"],
        ["60", "60x"],
        ["600", "600x"],
    ],
    checked: "60",
};
---

<figure class="scene-frame wide" id={id} data-cirrus-lab>
    <SkyFrame fly ownHeight grid={false} locked={false} hint="Drag to look around, scroll to zoom. A research figure: the sky behind is a stand-in.">
        <canvas data-field="canvas" aria-label="A sheet of high cloud from a baked map"></canvas>
        <div class="cloud-textures" data-field="textures"></div>
        <div class="sky-compass" data-field="compassLabels"></div>
        <Fragment slot="options">
            <OptionGroup name="sky">
                <Choice figure={id} {...PRESET} />
                <button type="button" class="view-toggle" data-copy title="Copies every slider as a preset, to paste into the figure's list">copy</button>
            </OptionGroup>
            <OptionGroup name="sheet"><LabSliders sliders={SHEET} /></OptionGroup>
            <OptionGroup name="patches"><LabSliders sliders={PATCHES} /></OptionGroup>
            <OptionGroup name="puffs"><LabSliders sliders={CELLS} /></OptionGroup>
            <OptionGroup name="waves"><LabSliders sliders={RIPPLES} /></OptionGroup>
            <OptionGroup name="veil"><LabSliders sliders={VEIL} /></OptionGroup>
            <OptionGroup name="time">
                <button type="button" class="view-toggle" data-field="animate" aria-pressed="false" title="Runs the figure's clock: the sheet drifts with its wind and its billows creep, which costs nothing, and it changes with its phase, for which the map is baked again every frame; set change to 0 to see the free part alone">animate</button>
                <Choice figure={id} {...SPEED} />
                <LabSliders sliders={TIME} />
            </OptionGroup>
            <OptionGroup name="light">
                <button type="button" class="view-toggle" data-field="sun.page" aria-pressed="false" title="Take the Sun from the page's moment and place instead of the two sliders">page's Sun</button>
                <LabSliders sliders={LIGHT} />
            </OptionGroup>
            <OptionGroup name="render">
                <Choice figure={id} {...SIZE} />
                <Choice figure={id} {...VIEW} />
                <button type="button" class="view-toggle" data-field="textures.on" aria-pressed="true" title="The textures the figure renders from, down the left of the view: hover one for what it is for">textures</button>
                <button type="button" class="view-toggle" data-field="ground.grid" aria-pressed="true" title="A grid on the ground, for orientation, speed and height: thin lines every 10 km, 1 km, 100 m and on down to 1 mm, each level showing once its cells are a few pixels across">grid</button>
            </OptionGroup>
        </Fragment>
    </SkyFrame>
    <p class="view-status"><span class="sky-timing" data-field="timing"></span></p>
    <figcaption class="figure-caption">{caption}</figcaption>
</figure>

<script>
    import { cirrusFigure } from "./cirrus";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-cirrus-lab]")) cirrusFigure(root);
</script>
