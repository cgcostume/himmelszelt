---
import type { LabSlider } from "./sliders";

interface Props {
    sliders: LabSlider[];
}
const { sliders } = Astro.props;
---

{
    sliders.map(([param, label, min, max, step, value, title]) => (
        <label class="sky-ev clouds-slider" title={title}>
            {label} <input data-param={param} type="range" min={min} max={max} step={step} value={value} /> <output />
        </label>
    ))
}
