---
import "../../sternzeit/sternzeit.css";
import "../../dunstkreis/dunstkreis.css";
import "../clouds.css";
import Choice from "../../dunstkreis/Choice.astro";
import Hdr from "../../dunstkreis/Hdr.astro";
import OptionGroup from "../../dunstkreis/OptionGroup.astro";
import SkyFrame from "../../dunstkreis/SkyFrame.astro";
import StarGroups from "../../sternenheer/StarGroups.astro";
import LabSliders from "./LabSliders.astro";
import type { LabSlider } from "./sliders";
import * as all from "./sliders";

/**
 * A research figure for the whole sky: gewoelk's three marched layers and its sheet of high cloud over dunstkreis' sky
 * with the stars and the Moon, at the page's moment and place. It composes weathers, a kind of cloud for each place of
 * the sky, the library's or one saved in a designer, and shows what they cost; the clouds' sliders are the designers',
 * and here only held, hidden. The stars are the Yale catalog's and Hipparcos', their light and the Milky Way's off or
 * brighter by stops, as in the stars figures.
 */
interface Props {
    id?: string;
    caption?: string;
}
const {
    id = "weather-lab",
    caption = "A weather composed, a kind of cloud for each place of the sky: three marched layers and a sheet of high cloud over dunstkreis' air, sternenheer's stars and nachtgestirn's Moon, exposed by the stars figure's meter. The clouds' own light is still a stand-in for the Sun's, and by night the Moon's share of it.",
} = Astro.props;

// Every slider of the two figures, once: held hidden, so the weathers set them as they do there.
const SHOWN = new Set(["clearFrom", "clearing"]);
const HELD = [
    ...new Map(
        Object.values(all)
            .flatMap((sliders) => sliders as LabSlider[])
            .map((slider) => [slider[0], slider]),
    ).values(),
].filter(([param]) => !SHOWN.has(param) && param !== "view.ev");
const CONTRAILS: LabSlider[] = [
    [
        "contrails.minutes",
        "lasting",
        0.5,
        60,
        0.5,
        12,
        "How long a trail lasts, in minutes: half a minute in dry air, an hour where the air up there is moist enough for the ice to stay",
    ],
];
const CLEARING: LabSlider[] = [
    ["clearFrom", "clear from", 0, 200, 5, 60, "The distance from which the clouds thin out, in km"],
    [
        "clearing",
        "clearing",
        0,
        400,
        10,
        160,
        "The distance at which the last cloud is gone, in km, so the horizon stays clear and a low sun shines in under the clouds: 0 for clouds all the way",
    ],
];
const kinds = (i: number, options: string[][], checked: string) => ({
    name: `kind${i}`,
    label: "Kind",
    title: "What the layer's map is made of",
    options,
    checked,
});
const TOWERS = ["2", "towers", "A few cells of many grow tall and spread into anvils"];
const FRONTS = [
    "3",
    "front",
    "A band placed in the world: a wall of towers behind its leading edge, a shield of cloud to the rear",
];
// The library's weathers by name, `WEATHER`'s: what a button reads, and what the weather is.
const WEATHERS = {
    name: "weather",
    label: "Weather",
    title: "The library's weathers: each names a kind of cloud for every place of the sky",
    options: [
        ["clear", "clear", "Blue sky, a few wisps"],
        ["fair", "fair", "Fair-weather cumulus: small, flat, spread out"],
        ["scattered", "scattered", "Scattered cumulus, some of it growing"],
        ["towering", "towering", "Towering cumulus: tall, heaped, an afternoon in summer"],
        ["overcast", "overcast", "A deck of stratocumulus under a veil of cirrostratus"],
        ["mackerel", "mackerel", "A mackerel sky over a few low clouds"],
        ["cirrus", "cirrus", "High cloud ahead of a front, over a few low clouds"],
        ["altocumulus", "altocumulus", "A sky of altocumulus over a few low heaps"],
        ["showers", "showers", "Showers under an open sky: rain under every tower"],
        ["frontAhead", "front ahead", "A front coming on: its shield ahead, the low clouds thinning out under it"],
        ["underFront", "under the front", "Under the front: a closed, dark sky, ragged cloud hanging low"],
    ],
    checked: "towering",
};
// The places of the sky, each with a kind of cloud to choose: the library's, or one saved in a designer.
const PLACES = [
    ["low", "low", "The low layer, heaps or a deck: a height field, 2.5D", "2.5D"],
    ["deep", "deep", "The deep layer, towers or a front: a height field, 2.5D", "2.5D"],
    ["middle", "middle", "The middle layer: a height field, 2.5D", "2.5D"],
    ["high", "high", "The sheet of high cloud: 2D", "2D"],
];
const choice = (name: string, label: string, title: string, options: string[][], checked: string) => ({
    name,
    label,
    title,
    options,
    checked,
});
// gewoelk's three dials of quality, `cloudQuality`'s: each a level of four.
const REACH = choice(
    "reach",
    "Reach",
    "How far the clouds are seen: sets the clearing and the march's reach",
    [
        ["low", "low", "Clouds out to 40 km"],
        ["medium", "medium", "Clouds out to 120 km"],
        ["high", "high", "Clouds to the horizon, marched 200 km"],
        ["ultra", "ultra", "Clouds to the horizon, marched 320 km"],
    ],
    "medium",
);
const SAMPLING = choice(
    "sampling",
    "Sampling",
    "How finely the clouds are marched and stored: the share of the frame, a ray's steps and the maps' sizes",
    [
        ["low", "low", "A third of the frame, 64 steps, maps of 256 and 512"],
        ["medium", "medium", "Half the frame, 128 steps, maps of 512 and 1024"],
        ["high", "high", "The whole frame, 256 steps, maps of 1024 and 2048"],
        ["ultra", "ultra", "The whole frame, 384 steps, maps of 2048"],
    ],
    "medium",
);
const MOTION = choice(
    "motion",
    "Motion",
    "How the clouds' shape changes while the clock runs: drift and billows are free at every level",
    [
        ["low", "low", "No change of shape"],
        ["medium", "medium", "The maps baked every 2 s"],
        ["high", "high", "The maps baked every half second"],
        ["ultra", "ultra", "The maps baked every frame"],
    ],
    "medium",
);
const SPEED = choice(
    "speed",
    "Speed",
    "How fast the figure's clock runs while its animation does",
    [
        ["1", "1x"],
        ["60", "60x"],
        ["600", "600x"],
    ],
    "60",
);
---

<figure class="fig scene-frame wide" id={id} data-weather-lab>
    <SkyFrame fly ownHeight grid={false} locked={false} hint="Drag to look around, scroll to zoom. The sky is dunstkreis', at the page's moment and place.">
        <canvas data-field="canvas" aria-label="The research's clouds over a real sky"></canvas>
        <div class="cloud-textures" data-field="textures"></div>
        <div class="sky-compass" data-field="compassLabels"></div>
        <Fragment slot="bar">
            <StarGroups catalog={null} />
        </Fragment>
        <Fragment slot="options">
            <OptionGroup name="weather">
                <Choice figure={id} {...WEATHERS} />
            </OptionGroup>
            <OptionGroup name="a kind for each place">
                {PLACES.map(([place, label, title, model]) => <label class="composer-place" title={title}>{label} <select data-place={place} aria-label={title}></select> <span class="cloud-model">{model}</span></label>)}
            </OptionGroup>
            <OptionGroup name="your weathers">
                <span class="own-weathers" data-field="ownWeathers"></span>
            </OptionGroup>
            <OptionGroup name="clearing">
                <LabSliders sliders={CLEARING} />
            </OptionGroup>
            <OptionGroup name="contrails">
                <button type="button" class="view-toggle" data-field="contrails.on" aria-pressed="false" title="Contrails behind aircraft on five invented routes over the place, at the high sheet's altitude: run the clock to see them fly">contrails</button>
                <LabSliders sliders={CONTRAILS} />
            </OptionGroup>
            <OptionGroup name="time">
                <button type="button" class="view-toggle" data-field="animate" aria-pressed="false" title="Runs the figure's clock: the layers drift, the billows creep and the maps change, baked again every frame">animate</button>
                <Choice figure={id} {...SPEED} />
            </OptionGroup>
            <OptionGroup name="reach">
                <Choice figure={id} {...REACH} />
            </OptionGroup>
            <OptionGroup name="sampling">
                <Choice figure={id} {...SAMPLING} />
            </OptionGroup>
            <OptionGroup name="motion">
                <Choice figure={id} {...MOTION} />
            </OptionGroup>
            <OptionGroup name="render">
                <button type="button" class="view-toggle" data-field="rays.on" aria-pressed="false" title="God rays: the shafts of sunlight and of the clouds' shade in the air, from a table of the layers' shade made with every march. Clearest towards a low Sun in hazy air">god rays</button>
                <button type="button" class="view-toggle" data-field="noise.blue" aria-pressed="false" title="Jitters the rays by blue noise, the same every frame, not by interleaved gradient noise: grain without a lattice where a few steps decide what a ray sees">blue noise</button>
                <button type="button" class="view-toggle" data-field="stride.adaptive" aria-pressed="false" title="An adaptive stride: a max pyramid of every layer's map tells a ray where the air ahead is clear, and there it strides as far as 32 km at once">adaptive stride</button>
                <button type="button" class="view-toggle" data-field="filter.box" aria-pressed="false" title="Brings the marched layers to the frame's size by a box of three of their texels at every pixel: the grain of the rays' jitter evens out, where four plain taps leave a raster of dots at half and at quarter scale">box filter</button>
                <button type="button" class="view-toggle" data-field="textures.on" aria-pressed="false" title="The textures the figure renders from, down the left of the view: hover one for what it is for">textures</button>
                <button type="button" class="view-toggle" data-field="ground.grid" aria-pressed="true" title="A grid on the ground, for orientation, speed and height: thin lines every 10 km, 1 km, 100 m and on down to 1 mm, each level showing once its cells are a few pixels across">grid</button>
            </OptionGroup>
            <OptionGroup name="HDR (× SDR white)">
                <Hdr figure={id} />
            </OptionGroup>
            <div hidden>
                <Choice figure={id} {...kinds(1, [TOWERS, FRONTS], "2")} />
                <LabSliders sliders={HELD} />
            </div>
        </Fragment>
    </SkyFrame>
    <p class="view-status"><span class="sky-timing" data-field="timing"></span></p>
    <figcaption class="figure-caption">{caption}</figcaption>
</figure>

<script>
    import { weatherFigure } from "./weather";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-weather-lab]")) weatherFigure(root);
</script>
