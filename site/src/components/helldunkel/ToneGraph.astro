---
import "./helldunkel.css";

const CURVES = [
    ["clip", "none"],
    ["neutral", "neutral"],
    ["agx", "AgX"],
    ["aces", "ACES"],
];
const COLORS = [
    ["sunset", "sunset"],
    ["sky", "sky"],
    ["leaf", "leaf"],
    ["gray", "gray"],
];
---

<figure class="fig scene-frame" id="curves">
    <p class="hdri-controls">
        <span class="steps" role="radiogroup" aria-label="The light's color">
            <span class="steps-heading" aria-hidden="true">light</span>
            {COLORS.map(([value, name]) => (
                <label>
                    <input type="radio" name="curves-color" value={value} checked={value === "sunset"} />
                    <span>{name}</span>
                </label>
            ))}
        </span>
        <span class="steps" role="radiogroup" aria-label="The tone curve in the plot">
            <span class="steps-heading" aria-hidden="true">curve</span>
            {CURVES.map(([value, name]) => (
                <label>
                    <input type="radio" name="curves-curve" value={value} checked={value === "neutral"} />
                    <span>{name}</span>
                </label>
            ))}
        </span>
    </p>
    <div class="curves-plot" data-export="tone-curves" data-export-timeless data-actions-in=".hdri-controls"><svg data-field="plot" aria-label="What the chosen tone curve makes of each channel of the chosen light"></svg></div>
    <div class="curves-strips">
        {CURVES.map(([value, name]) => (
            <Fragment>
                <span class="note">{name}</span>
                <canvas data-strip={value} aria-label={`The chosen light from dark to bright through ${name}`}></canvas>
            </Fragment>
        ))}
    </div>
    <figcaption class="figure-caption">
        One color of light growing brighter from left to right, in stops from white: what the chosen curve writes for each
        channel, computed by the shaders themselves, and that color through every curve in the strips. A line flat at 1 has
        clipped.
    </figcaption>
</figure>

<script>
    import "./tonegraph";
</script>
