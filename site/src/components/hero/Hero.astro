---
import "../sternzeit/sternzeit.css";
import "../dunstkreis/dunstkreis.css";
import "../gewoelk/clouds.css";
import Choice from "../dunstkreis/Choice.astro";
import Hdr from "../dunstkreis/Hdr.astro";
import OptionGroup from "../dunstkreis/OptionGroup.astro";
import SkyFrame from "../dunstkreis/SkyFrame.astro";
import Icon from "../Icon.astro";

/**
 * The landing page's figure: everything the libraries draw at once, at the page's moment and place. dunstkreis' sky,
 * sternenheer's stars, nachtgestirn's Moon and gewoelk's clouds, with their sheet of high cloud, contrails and the
 * rain's bows, in the shared frame at the reading column's width.
 */
interface Props {
    id?: string;
    caption?: string;
}
const {
    id = "sky",
    caption = "The sky at the chosen moment and place, by every library at once: dunstkreis' air, sternenheer's stars, nachtgestirn's Moon and gewoelk's clouds, with contrails over eight invented routes.",
} = Astro.props;

// How fast the figure's clock runs while it plays.
const SPEEDS = [
    { speed: 1, icon: "speedClock", title: "As fast as a clock" },
    { speed: 60, icon: "speedMinute", title: "A minute a second" },
    { speed: 3600, icon: "speedHour", title: "An hour a second" },
] as const;
const WEATHER = {
    name: "weather",
    label: "Weather",
    title: "gewoelk's weathers: each names a kind of cloud for every place of the sky",
    options: [
        ["clear", "clear", "Blue sky, a few wisps"],
        ["fair", "fair", "Fair-weather cumulus: small, flat, spread out"],
        ["scattered", "scattered", "Scattered cumulus, some of it growing"],
        ["towering", "towering", "Towering cumulus: tall, heaped, an afternoon in summer"],
        ["overcast", "overcast", "A deck of stratocumulus under a veil of cirrostratus"],
        ["mackerel", "mackerel", "A mackerel sky over a few low clouds"],
        ["cirrus", "cirrus", "High cloud ahead of a front, over a few low clouds"],
        ["altocumulus", "altocumulus", "A sky of altocumulus over a few low heaps"],
        ["showers", "showers", "Showers under an open sky: rain under every tower, and its bows opposite a low Sun"],
        ["frontAhead", "front ahead", "A front coming on: its shield ahead, the low clouds thinning out under it"],
        ["underFront", "under the front", "Under the front: a closed, dark sky, ragged cloud hanging low"],
    ],
    checked: "frontAhead",
};
const MODEL = {
    name: "model",
    label: "Cloud model",
    title: "Which of gewoelk's two models draws the low clouds: both under the same sheet of high cloud",
    options: [
        [
            "voxel",
            "voxels",
            "A voxel volume marched by its distance field, 3D: clouds to fly through, a front marched beside them",
        ],
        [
            "layered",
            "layers",
            "Three layers marched as height fields, 2.5D: every kind of cloud to the horizon, rain and its bows",
        ],
    ],
    checked: "voxel",
};
// gewoelk's cost, dial by dial: what its quality levels set together, each on its own here.
const dial = (name: string, label: string, title: string, checked: string, options: string[][]) => ({
    ...{ name, label, heading: label, title, checked, options },
});
const DIALS = [
    dial(
        "clearAt",
        "clear at",
        "The distance at which the last cloud is gone, for a clear horizon: clouds repeat less visibly and cost less far off",
        "150",
        [
            ["40", "40 km"],
            ["80", "80 km"],
            ["150", "150 km"],
            ["300", "300 km"],
            ["0", "never", "Clouds all the way to the horizon"],
        ],
    ),
    dial(
        "clearFrom",
        "clear from",
        "The distance from which the clouds thin out towards where they are gone: at most that distance",
        "40",
        [
            ["10", "10 km"],
            ["20", "20 km"],
            ["40", "40 km"],
            ["80", "80 km"],
            ["150", "150 km"],
        ],
    ),
    dial("reach", "march", "How far the layered model's rays are marched through its layers", "160", [
        ["60", "60 km"],
        ["160", "160 km"],
        ["200", "200 km"],
        ["320", "320 km"],
    ]),
    dial("scale", "frame", "The share of the frame's width and height the clouds are marched at", "0.5", [
        ["0.3333", "1/3", "A ninth of the pixels"],
        ["0.5", "1/2", "A quarter of the pixels"],
        ["1", "1", "Every pixel"],
    ]),
    dial("steps", "steps", "The most steps a ray takes through the clouds", "256", [
        ["64", "64"],
        ["128", "128"],
        ["256", "256"],
        ["384", "384"],
        ["512", "512"],
    ]),
    dial("grid", "voxels", "The voxel volume's size: its cells across and up. Remade when changed", "256", [
        ["128", "128 × 32"],
        ["256", "256 × 64"],
        ["384", "384 × 96"],
    ]),
    dial(
        "noise",
        "detail noise",
        "The size of the 3D noise that carves the clouds' detail, in the voxel model",
        "128",
        [
            ["64", "64"],
            ["128", "128"],
        ],
    ),
    dial("map", "cloud map", "The size of the maps the clouds stand on: at most 1024 in the voxel model", "512", [
        ["256", "256"],
        ["512", "512"],
        ["1024", "1024"],
        ["2048", "2048"],
    ]),
    dial("highMap", "sheet map", "The size of the high sheet's map", "1024", [
        ["512", "512"],
        ["1024", "1024"],
        ["2048", "2048"],
    ]),
    dial(
        "light",
        "light samples",
        "Detailed samples towards the Sun at every step in a cloud, in the voxel model",
        "2",
        [
            ["1", "1"],
            ["2", "2"],
            ["3", "3"],
        ],
    ),
    dial("near", "near detail", "How far from the eye a second, finer noise is read, in the voxel model", "0", [
        ["0", "off"],
        ["2", "2 km"],
        ["4", "4 km"],
    ]),
    dial(
        "change",
        "change",
        "How often the clouds' shape changes while the figure plays: they drift and billow either way",
        "2",
        [
            ["off", "off", "No change of shape"],
            ["2", "2 s", "The layers' maps baked every 2 s; the voxels keep their shape"],
            ["0.5", "0.5 s", "The layers' maps baked every 0.5 s; the voxels keep their shape"],
            ["0", "frame", "Every frame: the layers' maps baked and the voxels rebuilt"],
        ],
    ),
];
---

<figure class="fig scene-frame" id={id} data-hero>
    <SkyFrame fly ownHeight ownPlay marks={1} locked={false} lockIcon="moonLock" sunLock lockTitle="Keep the view on the Moon; dragging lets go" gridTitle="Grid: lines of altitude every 10° and of azimuth over the hemisphere, and the Sun's symbol where it truly is" compassTitle="The compass directions on the horizon, and the Sun's and the Moon's names under them" hint="Drag to look around, scroll to zoom.">
        <canvas data-field="canvas" aria-label="The sky at the chosen moment and place, with clouds, stars and the Moon"></canvas>
        <div class="sky-compass" data-field="compassLabels"></div>
        <div class="sky-compass" data-field="bodyLabels"></div>
        <Fragment slot="bar">
            <span class="view-buttons">
                <button type="button" class="view-icon" data-field="geolocate" title="Use the browser's location as the place" aria-label="Use the browser's location"><Icon name="locate" /></button>
            </span>
            <span class="view-buttons">
                <button type="button" class="view-icon" data-field="animate" aria-pressed="false" title="Play: the clouds drift and change, the aircraft fly, and the moment runs on with them" aria-label="Play"><Icon name="play" /></button>
                <button type="button" class="view-icon" data-field="timeLock" aria-pressed="false" title="Hold the moment while the figure plays: the clouds drift and change, the Sun, the Moon and the stars stay where they are" aria-label="Hold the moment"><Icon name="timeLock" /></button>
                {SPEEDS.map(({ speed, icon, title }) => <button type="button" class="view-icon" data-speed={speed} aria-pressed={speed === 1 ? "true" : "false"} title={title} aria-label={title}><Icon name={icon} /></button>)}
            </span>
        </Fragment>
        <Fragment slot="options">
            <OptionGroup name="weather">
                <Choice figure={id} {...WEATHER} combo />
            </OptionGroup>
            <OptionGroup name="clouds">
                <Choice figure={id} {...MODEL} />
                <button type="button" class="view-toggle" data-field="contrails.on" aria-pressed="true" title="Contrails behind aircraft on eight invented routes over the place, at the high sheet's altitude: play to see them fly">contrails</button>
            </OptionGroup>
            <OptionGroup name="performance">
                {DIALS.map((d) => <Choice figure={id} {...d} combo />)}
                <button type="button" class="view-toggle" data-field="godRays.on" aria-pressed="false" title="Shafts of light under the clouds, in the layered model: a pass of its own">god rays</button>
                <button type="button" class="view-toggle" data-field="smooth.on" aria-pressed="true" title="Antialiasing: the Moon's disc by four rays a pixel, and the layered clouds brought to the frame's size by a box of three texels. The passes are compute passes, which have no MSAA: each smooths its own edges">antialiasing</button>
                <button type="button" class="view-toggle" data-field="ground.grid" aria-pressed="true" title="A grid on the ground, for orientation, speed and height: thin lines every 10 km, 1 km, 100 m and on down, each level showing once its cells are a few pixels across">ground grid</button>
            </OptionGroup>
            <OptionGroup name="HDR (× SDR white)">
                <Hdr figure={id} combo />
            </OptionGroup>
        </Fragment>
    </SkyFrame>
    <p class="view-status"><span data-field="place"></span> <span class="sky-timing" data-field="timing"></span></p>
    <figcaption class="figure-caption">{caption}</figcaption>
</figure>

<script>
    import { heroFigure } from "./hero";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-hero]")) heroFigure(root);
</script>
