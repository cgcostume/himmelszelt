---
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";

/**
 * What the pass costs and what its defaults miss, a disc for each size of the maps, as large as it gets before they
 * give less than a texel to a pixel at its middle: its defaults against everything switched on with the next finer
 * maps, shadows, displacement and soft shadows. Measured with timestamp queries in Chromium 153 over Vulkan on an AMD
 * Radeon RX 7900 XT, a 1920 by 1080 target, a waxing gibbous Moon, medians of 2,000 frames after 100 to warm up; the
 * error from both drawn linear, per pixel the disc covers, against everything on.
 */
interface Props {
    id?: string;
}
const { id = "budget" } = Astro.props;

type Memory = [color: number, colorBc1: number, relief: number, shadowMap: number];
// Per disc: its size, the view's width, what the defaults draw it with, the milliseconds a frame takes and the memory in MB, the color map's as it is and
// as BC1, with the defaults and with everything on, and the share of the disc's pixels the defaults draw more than a third of a stop off, in percent.
const ROWS: {
    disc: number;
    view: string;
    defaults: string;
    ms: [number, number];
    mb: [Memory, Memory];
    off: number;
}[] = [
    {
        disc: 162,
        view: "6.1°",
        defaults: "512 maps, hard shadows, against 1K",
        ms: [0.052, 0.143],
        mb: [
            [0.7, 0.087, 1.4, 0.13],
            [2.8, 0.35, 5.6, 0.13],
        ],
        off: 1.17,
    },
    {
        disc: 325,
        view: "3.1°",
        defaults: "1K maps, hard shadows, against 2K",
        ms: [0.067, 0.254],
        mb: [
            [2.8, 0.35, 5.6, 0.52],
            [11.2, 1.4, 22.4, 0.52],
        ],
        off: 1.07,
    },
    {
        disc: 651,
        view: "1.5°",
        defaults: "2K maps, hard shadows, against 4K",
        ms: [0.121, 0.379],
        mb: [
            [11.2, 1.4, 22.4, 1.57],
            [44.7, 5.6, 89.5, 1.57],
        ],
        off: 1.4,
    },
    {
        disc: 1303,
        view: "0.76°",
        defaults: "4K maps, displaced, against 8K",
        ms: [0.686, 0.665],
        mb: [
            [44.7, 5.6, 89.5, 6.29],
            [179, 22.4, 357.9, 6.29],
        ],
        off: 0.64,
    },
    {
        disc: 2607,
        view: "0.38°",
        defaults: "4K maps, displaced, against 8K",
        ms: [0.947, 0.831],
        mb: [
            [44.7, 5.6, 89.5, 9.44],
            [179, 22.4, 357.9, 9.44],
        ],
        off: 3.33,
    },
];
const PARTS = ["color map", "relief", "shadow map"] as const;
const CONFIGS = ["the defaults", "everything on"] as const;
// Each panel's axis: its end and the step of its grid.
const AXES = { ms: [1, 0.25], mb: [600, 100], off: [3.5, 1] } as const;
type Axis = keyof typeof AXES;
const pct = (v: number, axis: Axis) => `${((100 * v) / AXES[axis][0]).toFixed(3)}%`;
const ticks = (axis: Axis) =>
    Array.from({ length: Math.floor(AXES[axis][0] / AXES[axis][1]) + 1 }, (_, i) => i * AXES[axis][1]);
const grid = (axis: Axis) => `--grid: ${(100 * AXES[axis][1]) / AXES[axis][0]}%`;
const ms = (v: number) => (v < 1 ? v.toFixed(2) : v.toFixed(1));
const mb = (v: number) => (v < 10 ? v.toFixed(1) : v.toFixed(0));
// The bar's parts and their colors: the defaults' color map as BC1 and what BC1 saves of it outlined next to it, or
// everything on's color map whole, as its reference is drawn; the relief and the shadow map.
const parts = ([color, bc1, relief, shadowMap]: Memory, compressed: boolean) =>
    compressed ? [bc1, color - bc1, relief, shadowMap] : [color, 0, relief, shadowMap];
const PART_OF = [0, 0, 1, 2];
// The whole, the color map as it is, as the pass takes it by default.
const total = ([color, , relief, shadowMap]: Memory) => color + relief + shadowMap;
---

<figure class="budget-figure wide" id={id}>
    <div class="budget-legend note" aria-hidden="true">
        <span><i class="budget-swatch budget-defaults"></i>the defaults</span>
        <span><i class="budget-swatch"></i>everything on</span>
        {PARTS.map((part, i) => <span><i class={`budget-swatch budget-part-${i}`}></i>{part}</span>)}
        <span><i class="budget-swatch budget-part-0 budget-saved"></i>BC1 would save</span>
    </div>
    <div class="budget-grid" role="img" aria-label="Bar charts of the time a frame takes, the GPU memory, and the share of pixels the defaults draw off, for discs of 162 to 2,607 pixels">
        <span></span>
        <span class="budget-head note">time a frame, ms</span>
        <span class="budget-head note">GPU memory, MB</span>
        <span class="budget-head note">pixels 1/3 stop off, %</span>
        {ROWS.map((row) => (
            <>
                <span class="budget-size">
                    <span>{row.disc.toLocaleString("en-US")} pixels <span class="note">in {row.view}</span></span>
                    <span class="budget-defaults-note note">{row.defaults}</span>
                </span>
                <span class="budget-cell" style={grid("ms")} data-label="time a frame, ms">
                    {row.ms.map((v, c) => (
                        <span class="budget-line" title={`${CONFIGS[c]}: ${v} ms`}>
                            <i class:list={["budget-bar", c === 0 && "budget-defaults"]} style={`width: ${pct(v, "ms")}`}></i>
                            <span class="budget-value">{ms(v)}</span>
                        </span>
                    ))}
                </span>
                <span class="budget-cell" style={grid("mb")} data-label="GPU memory, MB">
                    {row.mb.map((m, c) => (
                        <span class="budget-line" title={c === 0 ? `the defaults: color map ${m[0]} MB, as BC1 ${m[1]}, relief ${m[2]}, shadow map ${m[3]}` : `everything on: color map ${m[0]} MB, relief ${m[2]}, shadow map ${m[3]}`}>
                            {parts(m, c === 0).map((v, i) => v > 0 && (
                                <i class:list={["budget-bar", `budget-part-${PART_OF[i]}`, i === 1 && "budget-saved", c === 0 && i !== 1 && "budget-defaults"]} style={`width: ${pct(v, "mb")}`}></i>
                            ))}
                            <span class="budget-value">{mb(total(m))}</span>
                        </span>
                    ))}
                </span>
                <span class="budget-cell" style={grid("off")} data-label="pixels a third of a stop off, %">
                    <span class="budget-line" title={`the defaults: ${row.off}% of the disc's pixels`}>
                        <i class="budget-bar budget-defaults" style={`width: ${pct(row.off, "off")}`}></i>
                        <span class="budget-value">{row.off.toFixed(1)}</span>
                    </span>
                </span>
            </>
        ))}
        <span></span>
        {(["ms", "mb", "off"] as const).map((axis) => (
            <span class="budget-axis note" aria-hidden="true">
                {ticks(axis).map((t) => <span style={`left: ${pct(t, axis)}`}>{t}</span>)}
            </span>
        ))}
    </div>
    <figcaption class="figure-caption">
        The cost of nachtgestirn's Moon and what its defaults leave out, a disc for each size of the maps, 512 to 8K
        texels across, as large as it gets before its maps give less than a texel to a pixel at its middle, π times the
        disc's pixels: the time on the GPU a frame takes and the GPU memory of the maps and the shadow map, with the
        pass' defaults, hatched, what they draw each disc with, and with everything on, solid, the next finer maps,
        shadows, displacement and soft shadows; outlined next to the defaults' color map what BC1 would save of it; and
        the share of the disc's pixels the defaults draw more than a third of a stop off from everything on. BC1 colors
        cost no time and draw no pixel that far off. The 8K maps are this site's, the rest ship with the package: past
        4K the defaults keep the 4K maps, magnified. A view of 1920 by 1080 pixels, as many degrees wide as under each
        disc, the Moon waxing gibbous; an AMD Radeon RX 7900 XT in Chromium, medians of 2,000 frames after 100 to warm
        up.
    </figcaption>
</figure>
