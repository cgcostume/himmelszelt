---
import "../costs.css";
import reference from "./bench.json";
import { type BenchResult, BUDGET_ROWS, type Config, frameKey, type Maps, type Variant } from "./budget-rows";
import "./nachtgestirn.css";

/**
 * What the pass costs and what its defaults miss, a disc for each size of the maps, as large as it gets before they
 * give less than a texel to a pixel at its middle: its defaults against everything switched on with the next finer
 * maps, shadows and displacement. The time a frame and the loads are bench.json's, written by `pnpm bench nachtgestirn
 * --write` (scripts/bench.mjs and bench.ts): timestamp queries, the cases in turn round after round, a waxing gibbous
 * Moon ten days old in a 1920 by 1080 target; the download and the loading, seen or whole as the switch says, the files'
 * bytes and the wall clock to decode both from memory and to upload them, mips and relief built, until the GPU is done.
 * The memory is counted from the textures' sizes and the shadow map's, and the error from both drawn linear, per pixel
 * the disc covers, against everything on (2026-11-15).
 */
interface Props {
    id?: string;
}
const { id = "budget" } = Astro.props;

const measure = reference as BenchResult;
type Memory = [color: number, colorBc1: number, relief: number, shadowMap: number];
// Per set of maps: the color map's and the heights' bytes, and the ms to decode both and to upload them; zeros for a set
// the run did not have.
const loadOf = (variant: Variant, maps: Maps): [color: number, heights: number, decode: number, upload: number] => {
    const set = measure.loads[variant][maps];
    return set ? [set.color, set.heights, set.decode.median, set.upload.median] : [0, 0, 0, 0];
};
const msOf = (disc: number, config: Config) => measure.frameTimes[frameKey(disc, config)]?.ms.median ?? 0;
const VARIANTS = ["seen", "whole"] as const;
// Per disc, as BUDGET_ROWS has them: the view's width, what the defaults draw it with, the memory in MiB, the color
// map's as it is and as BC1, with the defaults and with everything on, and the share of the disc's pixels the defaults
// draw more than a third of a stop off, in percent.
const LABELS: Record<number, { view: string; defaults: string; mb: [Memory, Memory]; off: number }> = {
    162: {
        view: "6.1°",
        defaults: "512 maps, against 1K",
        mb: [
            [0.668, 0.083, 1.34, 0.124],
            [2.67, 0.334, 5.34, 0.124],
        ],
        off: 1.9,
    },
    325: {
        view: "3.1°",
        defaults: "1K maps, against 2K",
        mb: [
            [2.67, 0.334, 5.34, 0.496],
            [10.7, 1.34, 21.4, 0.496],
        ],
        off: 2.06,
    },
    651: {
        view: "1.5°",
        defaults: "2K maps, against 4K",
        mb: [
            [10.7, 1.34, 21.4, 1.5],
            [42.6, 5.34, 85.4, 1.5],
        ],
        off: 2.44,
    },
    1303: {
        view: "0.76°",
        defaults: "4K maps, displaced, against 8K",
        mb: [
            [42.6, 5.34, 85.4, 6],
            [170.7, 21.4, 341.3, 6],
        ],
        off: 1.7,
    },
    2607: {
        view: "0.38°",
        defaults: "4K maps, displaced, against 8K",
        mb: [
            [42.6, 5.34, 85.4, 9],
            [170.7, 21.4, 341.3, 9],
        ],
        off: 2.85,
    },
};
const ROWS = BUDGET_ROWS.flatMap((row) => {
    const labels = LABELS[row.disc];
    return labels
        ? [{ ...row, ...labels, ms: [msOf(row.disc, "defaults"), msOf(row.disc, "everything")] as const }]
        : [];
});
const GPUS: Record<string, string> = { "amd rdna-3": "an AMD Radeon RX 7900 XT" };
const credit = `${GPUS[measure.gpu] ?? measure.gpu} in ${measure.browser}, medians of ${measure.rounds} rounds of ${measure.frames.toLocaleString("en-US")} frames`;
const PARTS = ["color map", "relief", "shadow map"] as const;
const CONFIGS = ["the defaults", "everything on"] as const;
// Each panel's axis: its end and the step of its grid.
// Each axis a little past its longest bar, so the bar's value fits in its own panel and the panels stand close.
const AXES = { ms: [0.5, 0.1], mb: [600, 100], dl: [45, 10], load: [600, 200], off: [4.5, 1] } as const;
type Axis = keyof typeof AXES;
const pct = (v: number, axis: Axis) => `${((100 * v) / AXES[axis][0]).toFixed(3)}%`;
const ticks = (axis: Axis) =>
    Array.from(
        { length: Math.floor(AXES[axis][0] / AXES[axis][1]) + 1 },
        (_, i) => Math.round(i * AXES[axis][1] * 1e3) / 1e3,
    );
const grid = (axis: Axis) => `--grid: ${(100 * AXES[axis][1]) / AXES[axis][0]}%`;
const ms = (v: number) => (v < 1 ? v.toFixed(2) : v.toFixed(1));
const mb = (v: number) => (v < 10 ? v.toFixed(1) : v.toFixed(0));
// The bar's parts and their colors: the defaults' color map as BC1 and what BC1 saves of it outlined next to it, or
// everything on's color map whole, as its reference is drawn; the relief and the shadow map.
const parts = ([color, bc1, relief, shadowMap]: Memory, compressed: boolean) =>
    compressed ? [bc1, color - bc1, relief, shadowMap] : [color, 0, relief, shadowMap];
const PART_OF = [0, 0, 1, 2];
// The whole, the color map as it is, as the pass takes it by default.
const total = ([color, , relief, shadowMap]: Memory) => color + relief + shadowMap;
const MiB = 2 ** 20;
// Per variant, what the switch sets on a bar or a value: its width, its text, or the line's title.
const download = (maps: Maps, variant: Variant) => {
    const [color, heights] = loadOf(variant, maps);
    return {
        bars: [pct(color / MiB, "dl"), pct(heights / MiB, "dl")],
        value: mb((color + heights) / MiB),
        title: `${variant} ${maps} maps: color map ${(color / MiB).toFixed(2)} MiB, heights ${(heights / MiB).toFixed(2)}`,
    };
};
const loading = (maps: Maps, variant: Variant) => {
    const [, , decode, upload] = loadOf(variant, maps);
    return {
        bar: pct(decode + upload, "load"),
        value: (decode + upload).toFixed(0),
        title: `${variant} ${maps} maps: decoded in ${decode.toFixed(1)} ms, uploaded in ${upload.toFixed(1)}`,
    };
};
---

<figure class="fig budget-figure moon-budget wide" id={id} data-moon-budget data-actions="copy">
    <div class="budget-legend note">
        <span class="view-buttons">
            {VARIANTS.map((variant) => (
                <button type="button" class="view-toggle" data-variant={variant} aria-pressed={variant === "seen" ? "true" : "false"} title={variant === "seen" ? "The seen maps, the package's default: the far side Earth never sees its own mean, at no height" : "The whole maps, the far side too, for a globe or a camera that orbits the Moon"}>{variant}</button>
            ))}
        </span>
        <span><i class="budget-swatch budget-defaults"></i>the defaults</span>
        <span><i class="budget-swatch"></i>everything on</span>
        {PARTS.map((part, i) => <span><i class={`budget-swatch budget-part-${i}`}></i>{part}</span>)}
        <span><i class="budget-swatch budget-part-0 budget-saved"></i>BC1 saves</span>
    </div>
    <div class="budget-grid" role="img" aria-label="Bar charts of the time a frame takes, the GPU memory, the download, the time to decode and upload the maps, and the share of pixels the defaults draw off, for discs of 162 to 2,607 pixels">
        <span></span>
        <span class="budget-head note">time a frame, ms</span>
        <span class="budget-head note">GPU memory, MiB</span>
        <span class="budget-head note">download, MiB</span>
        <span class="budget-head note">decode and upload, ms</span>
        <span class="budget-head note">pixels 1/3 stop off, %</span>
        {ROWS.map((row) => (
            <>
                <span class="budget-size">
                    <span>{row.disc.toLocaleString("en-US")} pixels <span class="note">in {row.view}</span></span>
                    <span class="budget-defaults-note note">{row.defaults}</span>
                </span>
                <span class="budget-cell" style={grid("ms")} data-label="time a frame, ms">
                    {row.ms.map((v, c) => (
                        <span class="budget-line" title={`${CONFIGS[c]}: ${v} ms`}>
                            <i class:list={["budget-bar", c === 0 && "budget-defaults"]} style={`width: ${pct(v, "ms")}`}></i>
                            <span class="budget-value">{ms(v)}</span>
                        </span>
                    ))}
                </span>
                <span class="budget-cell" style={grid("mb")} data-label="GPU memory, MiB">
                    {row.mb.map((m, c) => (
                        <span class="budget-line" title={c === 0 ? `the defaults: color map ${m[0]} MiB, as BC1 ${m[1]}, relief ${m[2]}, shadow map ${m[3]}` : `everything on: color map ${m[0]} MiB, relief ${m[2]}, shadow map ${m[3]}`}>
                            {parts(m, c === 0).map((v, i) => v > 0 && (
                                <i class:list={["budget-bar", `budget-part-${PART_OF[i]}`, i === 1 && "budget-saved", c === 0 && i !== 1 && "budget-defaults"]} style={`width: ${pct(v, "mb")}`}></i>
                            ))}
                            <span class="budget-value">{mb(total(m))}</span>
                        </span>
                    ))}
                </span>
                <span class="budget-cell" style={grid("dl")} data-label="download, MiB">
                    {row.maps.map((maps, c) => {
                        const d = { seen: download(maps, "seen"), whole: download(maps, "whole") };
                        return (
                            <span class="budget-line" title={d.seen.title} data-seen={d.seen.title} data-whole={d.whole.title}>
                                {[0, 1].map((i) => (
                                    <i class:list={["budget-bar", `budget-part-${i}`, c === 0 && "budget-defaults"]} style={`width: ${d.seen.bars[i]}`} data-seen={d.seen.bars[i]} data-whole={d.whole.bars[i]}></i>
                                ))}
                                <span class="budget-value" data-seen={d.seen.value} data-whole={d.whole.value}>{d.seen.value}</span>
                            </span>
                        );
                    })}
                </span>
                <span class="budget-cell" style={grid("load")} data-label="decode and upload, ms">
                    {row.maps.map((maps, c) => {
                        const l = { seen: loading(maps, "seen"), whole: loading(maps, "whole") };
                        return (
                            <span class="budget-line" title={l.seen.title} data-seen={l.seen.title} data-whole={l.whole.title}>
                                <i class:list={["budget-bar", c === 0 && "budget-defaults"]} style={`width: ${l.seen.bar}`} data-seen={l.seen.bar} data-whole={l.whole.bar}></i>
                                <span class="budget-value" data-seen={l.seen.value} data-whole={l.whole.value}>{l.seen.value}</span>
                            </span>
                        );
                    })}
                </span>
                <span class="budget-cell" style={grid("off")} data-label="pixels a third of a stop off, %">
                    <span class="budget-line" title={`the defaults: ${row.off}% of the disc's pixels`}>
                        <i class="budget-bar budget-defaults" style={`width: ${pct(row.off, "off")}`}></i>
                        <span class="budget-value">{row.off.toFixed(1)}</span>
                    </span>
                </span>
            </>
        ))}
        <span></span>
        {(["ms", "mb", "dl", "load", "off"] as const).map((axis) => (
            <span class="budget-axis note" aria-hidden="true">
                {ticks(axis).map((t) => <span style={`left: ${pct(t, axis)}`}>{t}</span>)}
            </span>
        ))}
    </div>
    <figcaption class="figure-caption">
        What nachtgestirn's Moon costs and what its defaults leave out, a disc for each size of the maps, each as large as
        its maps stay sharp. Everything on adds the next finer maps, shadows and displacement. A view of 1920 by 1080
        pixels, the Moon waxing gibbous; {credit}.
    </figcaption>
</figure>

<script>
    // The switch between the seen maps and the whole ones: each bar's width, value and title as the variant has it.
    for (const root of document.querySelectorAll<HTMLElement>("figure[data-moon-budget]")) {
        const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-variant]")];
        const show = (variant: string) => {
            for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.variant === variant));
            for (const el of root.querySelectorAll<HTMLElement>("[data-seen]")) {
                const v = el.dataset[variant] ?? "";
                if (el.classList.contains("budget-bar")) el.style.width = v;
                else if (el.classList.contains("budget-line")) el.title = v;
                else el.textContent = v;
            }
        };
        for (const b of buttons) b.addEventListener("click", () => show(b.dataset.variant ?? "seen"));
    }
</script>
