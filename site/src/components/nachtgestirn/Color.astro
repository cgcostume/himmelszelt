---
import Term from "../Term.astro";
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";
import LunationSlider from "../sternzeit/LunationSlider.astro";

/** The color map read three ways: as gray, as published, and tinted to the Moon's own color. */
interface Props {
    id?: string;
}
const { id = "color" } = Astro.props;
---

<figure class="tiles-figure" id={id} data-color>
    <div class="tiles-panel as-seen split" style="--count: 3">
        <canvas aria-label="The Moon from its color map as gray, as published and tinted to the Moon's color, rendered with WebGPU"></canvas>
        <span class="tiles-start">
            <span class="tiles-hint footnote">Rendered with WebGPU</span>
        </span>
    </div>
    <ul class="tiles-labels" style="grid-template-columns: 1fr 1fr 1fr">
        <li><span class="tiles-name">gray</span> <span class="tiles-value">the map's luminance</span></li>
        <li><span class="tiles-name">as published</span> <span class="tiles-value">NASA's balance</span></li>
        <li><span class="tiles-name">tinted</span> <span class="tiles-value">to B−V 0.92</span></li>
    </ul>
    <LunationSlider own />
    <figcaption class="figure-caption">
        The color map three ways, the Moon from Earth's center, north up, metered: as gray, its luminance
        alone; as NASA balanced it; and scaled to the Moon's own color, a <Term of="Color index">color
        index</Term> B−V of 0.92 against the Sun's 0.65.
    </figcaption>
</figure>

<script>
    import { colorFigure } from "./color";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-color]")) colorFigure(root);
</script>
