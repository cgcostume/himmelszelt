---
import Term from "../Term.astro";
import Try from "../Try.astro";
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";

/** The Moon at perigee, now and at apogee, side by side at one scale. */
interface Props {
    id?: string;
}
const { id = "near-far" } = Astro.props;
---

<figure class="tiles-figure" id={id} data-distance>
    <div class="tiles-panel as-seen">
        <canvas aria-label="The Moon at perigee, at the chosen moment and at apogee, rendered with WebGPU"></canvas>
    </div>
    <ul class="tiles-labels" style="grid-template-columns: 1fr 1fr 1fr">
        <li><span class="tiles-name">perigee</span> <span class="tiles-value"></span></li>
        <li><span class="tiles-name">now</span> <span class="tiles-value"></span></li>
        <li><span class="tiles-name">apogee</span> <span class="tiles-value"></span></li>
    </ul>
    <figcaption class="figure-caption">
        The Moon's face at the chosen moment at three distances, drawn at one scale from Earth's center, north up: at{" "}
        <Term of="Perigee">perigee</Term>, at the moment's own distance, and at <Term of="Apogee">apogee</Term>, each with
        its distance and its angular diameter in arcminutes.
        <Try label="The supermoon of November 2034" set="date=2034-11-25T22:00Z" fig={id}>
            a full Moon within hours of a close perigee, the middle disc as large as the left one.
        </Try>
    </figcaption>
</figure>

<script>
    import { distanceFigure } from "./distance";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-distance]")) distanceFigure(root);
</script>
