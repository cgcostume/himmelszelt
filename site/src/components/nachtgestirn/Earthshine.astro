---
import CopyInfo from "../CopyInfo.astro";
import Icon from "../Icon.astro";
import Term from "../Term.astro";
import "./nachtgestirn.css";
import LunationSlider from "../sternzeit/LunationSlider.astro";

/** The Moon without earthshine and with it, at one exposure, metered on the night side. */
interface Props {
    id?: string;
}
const { id = "earthshine-crescent" } = Astro.props;
---

<figure class="fig tiles-figure" id={id} data-earthshine>
    <div class="tiles-panel as-seen split" style="--count: 2" data-actions="copy">
        <canvas aria-label="The Moon without earthshine and with it, rendered with WebGPU"></canvas>
        <span class="tiles-start">
            <span class="tiles-hint footnote">Rendered with WebGPU</span>
        </span>
        <span class="tiles-ends">
            <span class="view-buttons fig-actions">
                <button type="button" class="view-icon" data-field="download" title="Download both discs as PNG" aria-label="Download as PNG"><Icon name="download" /></button>
                <CopyInfo />
            </span>
        </span>
    </div>
    <ul class="tiles-labels" style="grid-template-columns: 1fr 1fr">
        <li><span class="tiles-name">without earthshine</span> <span class="tiles-value">the night side a hole</span></li>
        <li><span class="tiles-name">with earthshine</span> <span class="tiles-value" data-field="lux"></span></li>
    </ul>
    <LunationSlider own />
    <p class="view-status" data-field="note"></p>
    <figcaption class="figure-caption">
        The Moon from Earth's center, north up, without <Term of="Earthshine">earthshine</Term> and with it, both at
        one exposure, metered on the night side: up to ten stops more open than a photograph of the sunlit part. The
        earthshine a little bluer than the sunlight, as measured.
    </figcaption>
</figure>

<script>
    import { earthshineFigure } from "./earthshine";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-earthshine]")) earthshineFigure(root);
</script>
