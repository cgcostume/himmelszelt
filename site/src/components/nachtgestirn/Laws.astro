---
import Icon from "../Icon.astro";
import Try from "../Try.astro";
import "../sternzeit/sternzeit.css";
import Rays from "./Rays.astro";
import "./nachtgestirn.css";
import LunationSlider from "../sternzeit/LunationSlider.astro";

/** Lambert's law, Oren-Nayar's and Hapke's of 1963 and 2012: the Moon under each, and how far its light is off the Moon's. */
interface Props {
    id?: string;
}
const { id = "laws" } = Astro.props;
const LAWS = [
    ["lambert", "Lambert"],
    ["orenNayar", "Oren-Nayar"],
    ["hapke", "Hapke 1963"],
    ["hapke2012", "Hapke 2012"],
] as const;
---

<figure class="tiles-figure wide" id={id} data-laws>
    <div class="tiles-panel as-seen split">
        <canvas aria-label="The Moon shaded by Lambert's law, Oren-Nayar's, Hapke's of 1963 and Hapke's of 2012, rendered with WebGPU" title="Drag to carry yourself around the Moon, the Sun staying put; double click to come back to Earth"></canvas>
        <ul class="tiles-labels disc-labels">
            {LAWS.map(([law, name]) => (
                <li><span class={`tiles-name law-${law}`}>{name}</span> <span class="tiles-value" data-off={law}></span></li>
            ))}
        </ul>
        <span class="tiles-start">
            <span class="view-buttons">
                <button type="button" class="view-icon" data-field="map" aria-pressed="false" title="NASA's maps, color and relief; off, plain discs of the law alone" aria-label="Maps"><Icon name="moonMap" /></button>
                <button type="button" class="view-icon" data-field="day" aria-pressed="false" title="The same discs over a plain daytime sky, exposed for the sky: the pale Moon by day" aria-label="By day"><Icon name="day" /></button>
                <button type="button" class="view-icon" data-field="deviation" aria-pressed="true" title="Stripe where each disc is more than a third of a stop off Hapke's model of 2012, the nearest to the measured Moon: red where brighter, blue where darker" aria-label="Deviation"><Icon name="clipped" /></button>
            </span>
            <span class="tiles-hint footnote">Drag the discs to go around the Moon. Rendered with WebGPU</span>
        </span>
        <span class="tiles-ends">
            <span class="view-buttons">
                <Rays />
                <button type="button" class="view-icon" data-field="metered" aria-pressed="true" title="Expose all four discs alike by a light meter on the measured Moon's lit part, as a photograph of the Moon is, rather than at the full Moon's exposure" aria-label="Metered"><Icon name="meter" /></button>
            </span>
            <span class="view-buttons">
                <button type="button" class="view-icon" data-field="download" title="Download the discs as PNG" aria-label="Download as PNG"><Icon name="download" /></button>
            </span>
        </span>
    </div>
    <LunationSlider />
    <figcaption class="figure-caption">
        The Moon at the chosen moment under the four laws of the side views, from Earth's center with north up, all
        four exposed alike. Under each disc, how far the whole disc's light is off the measured Moon's, in stops. Striped,
        at a switch, where a disc is more than a third of a stop off Hapke's model of 2012: red brighter, blue darker.
        <Try label="First quarter" set="date=2026-11-17T12:00Z" fig={id}>
            Hapke's half Moon of 1963 stays bright up to the terminator, his half Moon of 2012 fades into it.
        </Try>
    </figcaption>
</figure>

<script>
    import { lawsFigure } from "./laws";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-laws]")) lawsFigure(root);
</script>
