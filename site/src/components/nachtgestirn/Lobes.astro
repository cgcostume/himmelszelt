---
import Icon from "../Icon.astro";
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";

/** The four laws' lobes from the side: a patch of surface, its normal, the light dragged around it, the light sent out. */
interface Props {
    id?: string;
}
const { id = "lobes" } = Astro.props;
const LAWS = [
    ["lambert", "Lambert", "the same to every side"],
    ["metallicRoughness", "PBR", "a rough dielectric"],
    ["orenNayar", "Oren-Nayar", "back towards the light"],
    ["hapke", "Hapke", "back to the light, and flat"],
] as const;
---

<figure class="tiles-figure wide" id={id} data-lobes>
    <div class="lobes-row">
        {LAWS.map(([law, name, what]) => (
            <div class="lobes-panel">
                <svg data-law={law} role="img" aria-label={`The light a patch of surface sends to each side under ${name}'s law`}></svg>
                <p class="lobes-name"><span class="tiles-name">{name}</span> <span class="tiles-value">{what}</span></p>
            </div>
        ))}
    </div>
    <p class="view-status"><span data-field="note"></span> <button type="button" class="view-icon lobes-download" data-field="download" title="Download the four lobes as SVG" aria-label="Download as SVG"><Icon name="download" /></button></p>
    <figcaption class="figure-caption">
        The four laws from the side: a patch of surface, its normal up, the light coming in along the arrow, and around
        the patch how much light it sends to each direction in that plane, all four on one scale. The dashed half
        circle is a Lambert surface lit straight from above. Drag in any of them to move the light; the figure above outlines where on the Moon the Sun stands at that angle
        now. Lambert sends the
        same to every side, only less as the light slants; the PBR surface much the same, a little more towards the
        horizon; Oren-Nayar leans back towards the light; Hapke throws the most straight back along it, the surge,
        and grows towards the horizon, where its patch is seen through as much dust as it is lit through: the reason
        the full Moon's limb is as bright as its middle.
    </figcaption>
</figure>

<script>
    import { lobesFigure } from "./lobes";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-lobes]")) lobesFigure(root);
</script>
