---
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";

/** Lambert's law, Oren-Nayar's and Hapke's of 1963 and 2012 from the side: where each sends the light falling on a patch. */
interface Props {
    id?: string;
}
const { id = "lobes" } = Astro.props;
const LAWS = [
    ["lambert", "Lambert", "a matte ball"],
    ["orenNayar", "Oren-Nayar", "a rough ball"],
    ["hapke", "Hapke 1963", "a powder"],
    ["hapke2012", "Hapke 2012", "a rough powder"],
] as const;
---

<figure class="lobes-figure wide" id={id} data-lobes>
    <div class="lobes-row" data-export="reflectance" data-export-timeless>
        {LAWS.map(([law, name, what]) => (
            <div class="lobes-panel">
                <svg data-law={law} role="img" aria-label={`The light a patch of surface sends to each side under ${name}'s law`}></svg>
                <p class="lobes-label"><span class={`tiles-name law-${law}`}>{name}</span> <span class="tiles-value">{what}</span></p>
            </div>
        ))}
    </div>
    <label class="figure-slider" title="Where the Sun stands over the patch: drag, or drag the Sun in a panel">
        <span class="note">Sun</span>
        <span class="figure-slider-rail">
            <input type="range" data-field="sunAngle" min="-90" max="90" step="1" value="-40" aria-label="The Sun's angle from the normal" />
            <span class="figure-slider-scale" aria-hidden="true">
                <span class="figure-slider-mark" style="left: 0%">left</span>
                <span class="figure-slider-mark" style="left: 50%">overhead</span>
                <span class="figure-slider-mark" style="left: 100%">right</span>
            </span>
        </span>
        <output data-field="sunAngleValue"></output>
    </label>
    <p class="view-status"><span data-field="lobes"></span></p>
    <figcaption class="figure-caption">
        A patch of the Moon's surface from the side under four reflectance laws, its normal up, the arrow to the Sun:
        the shape around the patch is how much light it sends each way in that plane, all four on one scale, the dashed
        half circle a Lambert surface lit from straight above.
    </figcaption>
</figure>

<script>
    import { lobesFigure } from "./lobes";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-lobes]")) lobesFigure(root);
</script>
