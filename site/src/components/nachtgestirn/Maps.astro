---
import Cite from "../Cite.astro";
import "../sternzeit/sternzeit.css";
import LunationSlider from "../sternzeit/LunationSlider.astro";
import "./nachtgestirn.css";

/** The two maps the Moon is drawn from, flat: NASA's color mosaic and LOLA's heights. */
interface Props {
    id?: string;
}
const { id = "maps" } = Astro.props;
---

<figure class="tiles-figure" id={id} data-maps>
    <div class="maps-panel as-seen">
        <img data-field="color" alt="NASA's color map of the Moon, an equirectangular mosaic from the Lunar Reconnaissance Orbiter's wide angle camera" />
        <canvas class="maps-seen" data-field="seen" aria-hidden="true"></canvas>
    </div>
    <div class="maps-panel as-seen">
        <canvas data-field="heights" aria-label="The Moon's heights from the Lunar Orbiter Laser Altimeter, as gray, low to high"></canvas>
        <canvas class="maps-seen" data-field="seen" aria-hidden="true"></canvas>
    </div>
    <LunationSlider />
    <p class="view-status" data-field="note"></p>
    <figcaption class="figure-caption">
        The two maps nachtgestirn ships, at their middle size, laid out flat with 0° longitude in the middle, north up
        and east to the right: (a) the color, from the Lunar Reconnaissance Orbiter's wide angle camera, as NASA's
        Scientific Visualization Studio balanced it; (b) the heights from the Lunar
        Orbiter Laser Altimeter, as gray from the lowest ground to the highest, decoded from the two bytes a texel the
        package stores them in. Over both, what Earth sees of the Moon at the chosen moment, the half around the point
        the librations turn towards it, inside the line; hatched what is turned away, and densely what no libration ever
        brings into view; the slider runs from new moon to new moon. Both from the CGI Moon Kit <Cite id="svs4720" />.
    </figcaption>
</figure>

<script>
    import { mapsFigure } from "./maps";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-maps]")) mapsFigure(root);
</script>
