---
import "../sternzeit/sternzeit.css";
import "../dunstkreis/dunstkreis.css";
import Choice from "../dunstkreis/Choice.astro";
import Hdr from "../dunstkreis/Hdr.astro";
import OptionGroup from "../dunstkreis/OptionGroup.astro";
import SkyFrame from "../dunstkreis/SkyFrame.astro";
import Icon from "../Icon.astro";
import Try from "../Try.astro";
import Rays from "./Rays.astro";

/**
 * The Moon figure: nachtgestirn's disc over dunstkreis' sky in cd/m², composed and tone mapped by the Moon pass, in the
 * shared frame, the view kept on the Moon and zoomed in on it, everything on: Hapke's law, the maps, the relief, the
 * shadows, the earthshine, the eclipse, the air and its shimmer. Its options switch what composes the picture, not the
 * disc, and set the exposure.
 */
interface Props {
    id?: string;
    caption?: string;
    try?: { label: string; set: string; text: string };
}
const {
    id = "moon",
    caption = "The Moon at the chosen moment and place over dunstkreis' sky, through its air: lit by the Sun and by earthshine, in Earth's shadow during an eclipse, exposed for its lit part or for the sky, whichever is brighter. The compass directions on the horizon. Drag to let go of the Moon, scroll to see the sky around it.",
    try: experiment,
} = Astro.props;

const TONE = {
    name: "tone",
    label: "Tone curve",
    title: "Khronos PBR Neutral keeps colors as they are and compresses only the brightest, AgX fades bright colors towards white as film does, ACES is the saturated filmic curve used before, none cuts the light off where it saturates",
    options: [
        ["clip", "none"],
        ["neutral", "neutral"],
        ["agx", "AgX"],
        ["aces", "ACES"],
    ],
    checked: "neutral",
};
---

<figure class="scene-frame wide" id={id} data-moon>
    <SkyFrame png refraction lockIcon="moonLock" sunLock lockTitle="Keep the view on the Moon; dragging lets go" hint="Drag to look around, scroll to zoom. Rendered with WebGPU, the Moon over dunstkreis' sky.">
        <canvas data-field="canvas" aria-label="The Moon at the chosen moment and place"></canvas>
        <div class="sky-compass" data-field="compassLabels"></div>
        <span class="view-buttons" slot="bar"><Rays /><button type="button" class="view-icon" data-field="auto" aria-pressed="true" title="Expose for the Moon's lit surface, a stop brighter than mid gray, as a photographer exposes the Moon, or for the sky around it where that is brighter; off, the exposure slider in the options" aria-label="Metered"><Icon name="meter" /></button></span>
        <Fragment slot="options">
            <OptionGroup name="exposure">
                <label class="sky-ev">EV<sub>100</sub> <input data-field="exposure" type="range" min="-20" max="6" step="0.1" value="-14" title="Brighter to the right: a lower EV lets in more light" /> <output data-field="ev" /></label>
            </OptionGroup>
            <OptionGroup name="light">
                <button type="button" class="view-toggle" data-field="earthshine" aria-pressed="true" title="Earthshine, sunlight reflected by Earth onto the Moon's night side: a full Earth lights it with some 13 lux">earthshine</button>
                <button type="button" class="view-toggle" data-field="eclipse" aria-pressed="true" title="Earth's shadow on the Moon during a lunar eclipse: the penumbra's dimming, the umbra's copper, and the turquoise rim ozone leaves">eclipse</button>
                <button type="button" class="view-toggle" data-field="airDisc" aria-pressed="true" title="The air in front of the Moon: it dims and reddens the disc, more the lower it stands, and bends its rays, so a rising Moon shows squeezed; off, the Moon as it is above the air, the sky behind it unchanged">air</button>
                <button type="button" class="view-toggle" data-field="shimmer" aria-pressed="true" title="The air's shimmer: turbulence moves the image about, half an arcsecond at the zenith, growing with the air the light crosses from where you stand, some 3 arcseconds on the horizon and none above the air, and the air spreads the colors, blue lifted more than red, near the horizon some tens of arcseconds. It moves, so the figure draws on while it is on">shimmer</button>
                <button type="button" class="view-toggle" data-field="night" aria-pressed="false" title="As the eye sees it at night rather than a camera: below some 4 cd/m² the rods take over, colors fade and shift towards blue; the disc, far brighter, keeps its color">night vision</button>
            </OptionGroup>
            <OptionGroup name="HDR (× SDR white)">
                <Hdr figure={id} />
            </OptionGroup>
            <OptionGroup name="tone mapping">
                <Choice figure={id} {...TONE} />
            </OptionGroup>
        </Fragment>
    </SkyFrame>
    <p class="view-status"><span data-field="moon" /> <span class="sky-timing" data-field="timing" /></p>
    <figcaption class="figure-caption">
        {caption}
        {experiment && <Try label={experiment.label} set={experiment.set} fig={id}>{experiment.text}</Try>}
    </figcaption>
</figure>

<script>
    import { moonFigure } from "./moon";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-moon]")) moonFigure(root);
</script>
