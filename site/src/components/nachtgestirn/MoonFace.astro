---
import Icon from "../Icon.astro";
import LunationSlider from "../sternzeit/LunationSlider.astro";
import "../sternzeit/sternzeit.css";
import Term from "../Term.astro";
import Try from "../Try.astro";
import "./moonface.css";

/**
 * sternzeit's Moon view, textured: nachtgestirn's Moon over dunstkreis' sky behind the same overlay of the Moon's grid,
 * its axis, the Sun's direction and the readouts, at the same magnification.
 */
interface Props {
    id?: string;
}
const { id = "moon-face" } = Astro.props;
---

<figure class="moon-figure moon-face" id={id} data-moon-face>
    <div class="moon-view as-seen" data-export="moon">
        <span class="view-buttons">
            <button type="button" class="view-icon" data-field="lockMoon" aria-pressed="false" title="Lock the view to the Moon itself: north up, seen from Earth's center, without the air" aria-label="Moon frame"><Icon name="moonLock" /></button>
            <button type="button" class="view-icon" data-field="opticalLibration" aria-pressed="true" title="The tilt of the Moon's axis against its orbit and its uneven speed along it let us see a little around its edges" aria-label="Optical libration"><Icon name="libration" /></button>
            <button type="button" class="view-icon" data-field="annotations" aria-pressed="true" title="sternzeit's annotations over the Moon: its grid, axis, the arrow to the Sun and the readouts" aria-label="Annotations"><Icon name="labels" /></button>
        </span>
        <div class="moon-panel">
            <canvas aria-label="The Moon as seen from the chosen place, rendered with WebGPU"></canvas>
            <svg viewBox="-100 -100 200 200" aria-hidden="true"></svg>
        </div>
    </div>
    <LunationSlider />
    <figcaption class="figure-caption">
        sternzeit's view of the Moon (<a href="../sternzeit/#moon-view">its figure</a>), now as nachtgestirn draws it:
        NASA's maps under Hapke's law, the night side in <Term of="Earthshine">earthshine</Term>, the air in front
        dimming, reddening and lifting it, over dunstkreis' sky, with sternzeit's grid, axis and arrow to the Sun on
        top, shifted by the <Term of="Libration">libration</Term>. Zenith up, from the place; locked to the Moon frame,
        its north up and seen from Earth's center, where there is no air. The slider runs from new moon to new moon, the full moon in the middle.
        <Try label="A day and a half after new moon" set="date=2026-11-10T18:00Z" fig={id}>
            a thin crescent low in the twilight, its night side faint in the earthshine.
        </Try>
    </figcaption>
</figure>

<script>
    import { moonFace } from "./moonface";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-moon-face]")) moonFace(root);
</script>
