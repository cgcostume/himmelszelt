---
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";

/** Mare Orientale turned from where Earth sees it, on the limb, to face on, closing in on its rings as the Sun sinks
 *  over it. */
interface Props {
    id?: string;
}
const { id = "orientale" } = Astro.props;
---

<figure class="tiles-figure" id={id} data-orientale>
    <div class="tiles-panel as-seen">
        <canvas aria-label="Mare Orientale, turned from the limb to face on, rendered with WebGPU"></canvas>
        <span class="tiles-start">
            <span class="tiles-hint footnote">Rendered with WebGPU</span>
        </span>
    </div>
    <label class="figure-slider" title="From the limb, as Earth sees the basin with the libration at its farthest west and the Sun high in its west, to straight over it in a low Sun">
        <span class="note">from Earth</span>
        <span class="figure-slider-rail">
            <input type="range" data-field="turn" min="0" max="100" step="0.5" value="0" aria-label="How far the Moon is turned to face the basin" />
        </span>
        <span class="note">face on</span>
    </label>
    <figcaption class="figure-caption">
        Mare Orientale turned from the limb, where Earth sees it, to face on, closing in on its rings, the Moon's north
        up, the Sun passing over it as it turns, from 60° in its west to 12° in its east, where the rings cast their
        shadows.
    </figcaption>
</figure>

<script>
    import { orientaleFigure } from "./orientale";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-orientale]")) orientaleFigure(root);
</script>
