---
import Term from "../Term.astro";
import Try from "../Try.astro";
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";

/** The light of the whole disc over the phase angle under each law, against the Moon's measured light. */
interface Props {
    id?: string;
}
const { id = "phases" } = Astro.props;
---

<figure class="plot-figure" id={id} data-phases>
    <div class="tiles-plot" data-export="phase-law" data-export-timeless>
        <svg style="height: 220px" role="img" aria-label="The light of the whole disc over the phase angle under four reflectance laws, and the Moon's as measured by ROLO and by Allen"></svg>
    </div>
    <figcaption class="figure-caption">
        The light the whole disc sends to the viewer over the <Term of="Phase angle">phase angle</Term>, in stops below
        a full Moon, under the four laws, each a plain disc of the law alone, and the Moon as measured: the ROLO model,
        dashed, from 1.55° to 97°, and Allen's older phase law, dotted. The measurement is of the whole disc's light,
        not of how it is spread over the disc, so this is where the laws can be checked against the Moon itself. The readouts stand at the line marked now, the real
        Moon's phase angle at the chosen moment.
        <Try label="First quarter" set="date=2026-11-17T12:00Z" fig={id}>
            Hapke's half Moon of 2012 is a sixth of a stop over ROLO's, his of 1963 a quarter, Lambert's more than one and
            a half stops.
        </Try>
    </figcaption>
</figure>

<script>
    import { phasesFigure } from "./phases";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-phases]")) phasesFigure(root);
</script>
