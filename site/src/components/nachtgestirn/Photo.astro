---
import CopyInfo from "../CopyInfo.astro";
import Icon from "../Icon.astro";
import Resolutions from "../Resolutions.astro";
import "../sternzeit/sternzeit.css";
import "./nachtgestirn.css";
import { PHOTOS } from "./photo-options";
import Rays from "./Rays.astro";
import { WHOLE_RESOLUTIONS } from "./resolution-options";

/** Photographs of the Moon, one at a time, each with nachtgestirn's Moon for its moment and place over it, a split line between. */
interface Props {
    id?: string;
}
const { id = "photo" } = Astro.props;
const first = PHOTOS[0];
---

<figure class="fig tiles-figure" id={id} data-photo>
    <div class="photo-full" data-field="full" style={`--count: ${PHOTOS.length}`}>
        <div class="tiles-panel as-seen photo-stage" data-field="stage" data-actions="copy">
            <div class="photo-compare" style="--photo-aspect: 1">
                <div class="photo-disc">
                    <img src={first?.src} alt="A photograph of the Moon" crossorigin="anonymous" decoding="async" draggable="false" />
                    <svg class="photo-filter" aria-hidden="true"><filter id={`${id}-sharpen`} color-interpolation-filters="sRGB"><feGaussianBlur in="SourceGraphic" stdDeviation="1" result="blur" /><feComposite in="SourceGraphic" in2="blur" operator="arithmetic" k1="0" k2="2" k3="-1" k4="0" result="sharp" /><feMorphology in="SourceGraphic" operator="erode" radius="2" result="low" /><feMorphology in="SourceGraphic" operator="dilate" radius="2" result="high" /><feBlend in="sharp" in2="low" mode="lighten" result="floor" /><feBlend in="floor" in2="high" mode="darken" /></filter></svg>
                    <canvas aria-label="nachtgestirn's Moon for the photograph's moment and place, rendered with WebGPU"></canvas>
                </div>
                <svg class="photo-marks" data-field="marks" aria-hidden="true"></svg>
            </div>
            <span class="photo-note" data-field="note"></span>
            <div class="fig-bar">
                <span class="fig-bar-start">
                    <Resolutions options={WHOLE_RESOLUTIONS} chosen="8k" />
                    <span class="view-buttons">
                        <button type="button" class="view-icon" data-field="annotations" aria-pressed="false" data-setting="labels" title="The face figure's annotations over the Moon: its grid every 30°, its limb, its north and the point of its face nearest the observer" aria-label="Annotations"><Icon name="labels" /></button>
                    </span>
                    <span class="view-buttons">
                        <button type="button" class="view-toggle" data-field="roughness" aria-pressed="false" title="The slopes below the maps' texels, where a pixel is finer, as in full screen on a large screen: octaves of noise as steep as LOLA's statistics of the ground say it is at each scale">rough</button>
                        <button type="button" class="view-toggle" data-field="sharpen" aria-pressed="true" title="An unsharp mask over nachtgestirn's Moon as strong as the photograph's own processing, fitted to each photograph: sharpened, as photographs of the Moon mostly are, the comparison is fair">sharpen</button>
                    </span>
                    <span class="view-buttons"><Rays /></span>
                </span>
                <span class="fig-bar-end">
                    <span class="view-buttons fig-actions">
                        <button type="button" class="view-icon" data-field="download" title="Download the comparison as shown, as PNG" aria-label="Download as PNG"><Icon name="download" /></button>
                        <CopyInfo />
                        <button type="button" class="view-icon" data-field="fullscreen" aria-pressed="false" title="Full screen" aria-label="Full screen"><Icon name="fullscreen" /></button>
                    </span>
                </span>
            </div>
        </div>
        <label class="split-drawn" title="Where the line between the photograph and nachtgestirn's Moon runs">
            <input type="range" data-field="split" min="0" max="100" step="0.5" value="50" aria-label="Where the split runs, from all nachtgestirn to all photograph" />
            <span class="split-ends" aria-hidden="true"><span>nachtgestirn</span><span>photograph</span></span>
        </label>
        <div class="photo-picker">
            <p class="photo-credit" data-field="credit" aria-live="polite"></p>
            <div class="photo-tabs" role="group" aria-label="Photographs">
                {PHOTOS.map((photo, i) => (
                    <button type="button" class="photo-tab" data-pick={i} aria-pressed={i === 0 ? "true" : "false"} title={`${photo.label}: ${photo.when}, ${photo.where}, by ${photo.author}, ${photo.license}`} aria-label={photo.label}>
                        <img src={photo.thumb} alt="" loading="lazy" crossorigin="anonymous" style={`object-position: ${photo.center[0] * 100}% ${photo.center[1] * 100}%`} />
                    </button>
                ))}
            </div>
        </div>
    </div>
    <figcaption class="figure-caption">
        Photographs of the Moon left of the line, and right of it nachtgestirn's Moon for each photograph's moment and
        place, through the air, laid on each other by several hundred craters found in both. The color and the contrast
        are the camera's. Photographs from Wikimedia Commons, each credited over the thumbnails.
    </figcaption>
</figure>

<script>
    import { photoFigure } from "./photo";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-photo]")) photoFigure(root);
</script>
