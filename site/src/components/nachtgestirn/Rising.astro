---
import Slider from "../Slider.astro";
import Term from "../Term.astro";
import "./nachtgestirn.css";

/** A full Moon rising in the east over dunstkreis' sky, its disc above the air and through it, side by side. */
interface Props {
    id?: string;
}
const { id = "rising" } = Astro.props;
---

<figure class="fig tiles-figure" id={id} data-rising>
    <div class="tiles-panel as-seen split" style="--count: 2" data-actions="png copy">
        <canvas aria-label="A full Moon rising through the air, its rays straight and bent by refraction, rendered with WebGPU"></canvas>
        <svg class="tiles-overlay" data-field="outline" aria-hidden="true"></svg>
        <div class="fig-bar">
            <span class="fig-bar-start">
                <span class="fig-hint footnote">Rendered with WebGPU</span>
            </span>
        </div>
    </div>
    <ul class="tiles-labels" style="grid-template-columns: 1fr 1fr">
        <li><span class="tiles-name">straight through the air</span> <span class="tiles-value" data-field="above"></span></li>
        <li><span class="tiles-name">bent by the air</span> <span class="tiles-value" data-field="air"></span></li>
    </ul>
    <Slider
        name="Altitude"
        title="How high the Moon's center truly stands over the horizon, before the air lifts it"
        input={{ "data-field": "altitude", min: -1, max: 10, step: 0.05, value: 0.3, "aria-label": "The Moon's true altitude over the horizon" }}
        marks={[{ at: 9.09, label: "horizon" }, { at: 100, label: "10°" }]}
        output={{ "data-field": "altitudeValue" }}
    />
    <Slider
        name="Observer"
        title="How high the observer stands, from the ground to the space station's orbit"
        input={{ "data-field": "height", min: 0, max: 5.61, step: 0.01, value: 0, "aria-label": "The observer's height, on a scale of powers of ten" }}
        marks={[{ at: 0, label: "1 m" }, { at: 53.5, label: "1 km" }, { at: 100, label: "orbit" }]}
        output={{ "data-field": "heightValue" }}
    />
    <p class="view-status" data-field="note"></p>
    <figcaption class="figure-caption">
        A full Moon rising due east over dunstkreis' sky, the Sun just set opposite, at one exposure: as if its rays went
        straight, and bent by <Term of="Atmospheric refraction">refraction</Term>, dashed where it truly stands. The
        altitude is the center's true one over the horizon.
    </figcaption>
</figure>

<script>
    import { risingFigure } from "./rising";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-rising]")) risingFigure(root);
</script>
