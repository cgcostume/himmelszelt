---
import Fig from "../Fig.astro";
import Icon from "../Icon.astro";
import Term from "../Term.astro";
import "../sternzeit/sternzeit.css";
import Rays from "./Rays.astro";
import "./nachtgestirn.css";
import Resolutions from "../Resolutions.astro";
import LunationSlider from "../sternzeit/LunationSlider.astro";
import { FILTERS } from "./filters";
import { STRIP_RESOLUTIONS } from "./resolution-options";

/** The disc, and the limb near the south pole under four of the maps' filters, one ray a pixel or four. */
interface Props {
    id?: string;
}
const { id = "sampling" } = Astro.props;
---

<figure class="tiles-figure wide" id={id} data-sampling>
    <div class="tiles-panel as-seen split" style={`--count: ${FILTERS.length + 1}`}>
        <canvas aria-label="The Moon with a close-up of its limb near the south pole marked, and the close-up with its maps read by the nearest texel, bilinear, trilinear and anisotropic, rendered with WebGPU"></canvas>
        <svg class="tiles-overlay" data-field="marker" aria-hidden="true"></svg>
        <span class="tiles-start">
            <Resolutions options={STRIP_RESOLUTIONS} chosen="4k" />
            <span class="view-buttons">
                <button type="button" class="view-toggle" data-field="albedo" aria-pressed="true" title="NASA's color map of the Moon; off, a uniform surface of the Moon's albedo, so the relief and its shadows show alone">albedo</button>
                <button type="button" class="view-toggle" data-field="relief" aria-pressed="true" title="The relief from LOLA's heights, shading the surface; off, the smooth sphere under the color map alone">relief</button>
                <button type="button" class="view-toggle" data-field="shadows" aria-pressed="true" title="The shadows the relief casts, marched through the heights towards the Sun">shadows</button>
                <button type="button" class="view-toggle" data-field="displace" aria-pressed="true" title="The relief displaced, each ray marched through the heights, so the limb shows its mountains; off, the slopes shade a smooth sphere">displaced</button>
            </span>
            <span class="tiles-hint footnote">Rendered with WebGPU</span>
        </span>
        <span class="tiles-ends">
            <span class="view-buttons"><Rays pressed={false} /></span>
            <span class="view-buttons">
                <button type="button" class="view-icon" data-field="download" title="Download the disc and the four close-ups as PNG" aria-label="Download as PNG"><Icon name="download" /></button>
            </span>
        </span>
    </div>
    <ul class="tiles-labels" style={`grid-template-columns: repeat(${FILTERS.length + 1}, 1fr)`}>
        <li><span class="tiles-name">the disc</span> <span class="tiles-value">the close-up marked</span></li>
        {FILTERS.map(([, name, what]) => (
            <li><span class="tiles-name">{name}</span> <span class="tiles-value">{what}</span></li>
        ))}
    </ul>
    <LunationSlider own />
    <p class="view-status" data-field="note"></p>
    <figcaption class="figure-caption">
        The maps' filters on the limb near the Moon's south pole: the disc at the moment its slider sets, with
        the close-up marked, and the close-up four times, the nearest texel, bilinear, trilinear and anisotropic, as the pass reads its
        maps; one ray through each pixel's center, or four at the switch.
    </figcaption>
</figure>

<script>
    import { samplingFigure } from "./sampling";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-sampling]")) samplingFigure(root);
</script>
