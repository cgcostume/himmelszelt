---
import Icon from "../Icon.astro";
import Term from "../Term.astro";
import "../sternzeit/sternzeit.css";
import Rays from "./Rays.astro";
import "./nachtgestirn.css";

/** The Moon through Earth's shadow: one lunar eclipse, the eclipses around it to choose another, and the shown one across a row of discs. */
interface Props {
    id?: string;
}
const { id = "eclipse-row" } = Astro.props;
---

<figure class="fig tiles-figure" id={id} data-shadow>
    <div class="tiles-panel as-seen shadow-big" data-actions="png copy">
        <canvas data-field="big" aria-label="The Moon in Earth's shadow at the slider's moment, rendered with WebGPU"></canvas>
        <svg class="tiles-overlay" data-field="outline" aria-hidden="true"></svg>
        <div class="fig-bar">
            <span class="fig-bar-start">
                <span class="view-buttons">
                    <button type="button" class="view-icon" data-field="annotations" aria-pressed="true" data-setting="labels" title="The annotations over the Moon: the edges of the umbra and of the penumbra" aria-label="Annotations"><Icon name="labels" /></button>
                </span>
                <span class="view-buttons">
                    <Rays />
                    <button type="button" class="view-icon" data-field="metered" aria-pressed="true" title="Meter the big Moon and each disc of the row on its own, rather than all at the uneclipsed Moon's exposure, where the umbra's red is barely there" aria-label="Metered"><Icon name="meter" /></button>
                </span>
                <span class="fig-hint footnote">Rendered with WebGPU</span>
            </span>
            <span class="fig-bar-end">
                <span class="view-buttons fig-actions"></span>
            </span>
        </div>
        <span class="eclipse-jump view-buttons">
            <button type="button" class="view-toggle" data-jump="-1" title="The lunar eclipse before the one shown" aria-label="The lunar eclipse before the one shown"><Icon name="earlier" />earlier</button>
            <button type="button" class="view-toggle" data-jump="1" title="The lunar eclipse after the one shown" aria-label="The lunar eclipse after the one shown">later<Icon name="later" /></button>
        </span>
    </div>
    <label class="figure-slider" data-offset title="The moment through the eclipse, four hours either way from its greatest: drag, or turn the mouse wheel for a minute a notch">
        <span class="figure-slider-rail">
            <input type="range" data-field="offset" min="-240" max="240" step="1" value="0" aria-label="Minutes from the greatest eclipse" />
            <span class="figure-slider-scale" aria-hidden="true">{["−4", "0", "+4"].map((mark, i) => <span class="figure-slider-mark" style={`left: ${i * 50}%`}>{mark}{i !== 1 && <span class="figure-slider-unit"> h</span>}</span>)}</span>
        </span>
        <output data-field="offsetValue"></output>
    </label>
    <div class="shadow-timeline" title="The lunar eclipses of twelve years either side of the one shown, a bar each as tall as the umbral magnitude: past the dashed line the Moon is wholly in the umbra. Click one to show it">
        <svg data-field="timeline" aria-label="The lunar eclipses of the years around the one shown"></svg>
    </div>
    <div class="tiles-panel as-seen split" style="--count: 7">
        <canvas data-field="row" aria-label="The Moon at seven moments of a lunar eclipse, rendered with WebGPU"></canvas>
    </div>
    <ul class="tiles-labels" style="grid-template-columns: repeat(7, 1fr)">
        <li></li><li></li><li></li><li></li><li></li><li></li><li></li>
    </ul>
    <p class="view-status" data-field="note"></p>
    <figcaption class="figure-caption">
        Through Earth's shadow, from Earth's center with north up: (a) the Moon at a moment of the eclipse, the{" "}
        <Term of="Umbra">umbra</Term>'s edge solid, the <Term of="Penumbra">penumbra</Term>'s dashed; (b) twelve years of
        lunar eclipses either side, bars as tall as the umbral <Term of="Eclipse magnitude">magnitude</Term>, total past
        the dashed line, this one in the accent; (c) seven moments from the umbra's first contact to its last.
    </figcaption>
</figure>

<script>
    import { shadowFigure } from "./shadow";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-shadow]")) {
        shadowFigure(root);
        const annotations = root.querySelector('[data-field="annotations"]');
        const outline = root.querySelector<SVGSVGElement>('[data-field="outline"]');
        annotations?.addEventListener("click", () => {
            const shown = annotations.getAttribute("aria-pressed") !== "true";
            annotations.setAttribute("aria-pressed", String(shown));
            if (outline) outline.style.display = shown ? "" : "none";
        });
    }
</script>
