---
import EnvironmentFrame from "../environment/EnvironmentFrame.astro";
import Icon from "../Icon.astro";
import "../environment/environments.css";
import "../helldunkel/helldunkel.css";
import "../sternzeit/sternzeit.css";
import "./groundgeometry.css";

// The sliders of the grounded figure, with its ranges, but a dome of some 15 m rather than one without end, the reach at
// its far end, the bend's circle, and how high up the dome the bend climbs.
const SLIDERS = [
    {
        name: "height",
        label: "height",
        title: "How far above the ground the image was taken, in meters",
        min: 0.2,
        max: 8,
        step: 0.1,
        value: 2,
        marks: ["0.2", "8"],
    },
    {
        name: "lift",
        label: "horizon",
        title: "How far the image's horizon is lifted, or lowered, in degrees",
        min: -20,
        max: 20,
        step: 0.5,
        value: 0,
        marks: ["−20°", "+20°"],
    },
    {
        name: "reach",
        label: "reach",
        title: "How far from under the capture point the ground lies flat before it bends up into the dome: at the far end as far as the circle that touches plane and dome, shorter for a flatter bend; under a dome without end, past it the ground falls away like a hilltop",
        min: 0,
        max: 100,
        step: 1,
        value: 100,
        marks: ["3", "circle"],
    },
    {
        name: "soft",
        label: "soft",
        title: "How high up the dome's wall the ground bends into it: a hard corner where the plane meets the dome at the left, at the right up to where the image's horizon meets the dome, as high as the capture point for a level horizon",
        min: 0,
        max: 1,
        step: 0.01,
        value: 0.5,
        marks: ["corner", "round"],
    },
    {
        name: "radius",
        label: "dome",
        title: "The radius of the dome the horizon and the sky lie on, at least two and a half heights; at the far end, without bound",
        min: 0,
        max: 100,
        step: 1,
        value: 24,
        marks: ["5", "∞"],
    },
];
---

<figure class="fig scene-frame wide" id="ground-geometry" data-needs-hdri data-loading>
    <div class="fig-row">
        <figure class="fig-tile">
            <div class="frame-scene" style="aspect-ratio: 4 / 3" data-export="ground-geometry" data-export-timeless>
                <svg class="dome-layer zdog" data-layer="ground" style="height: 100%; aspect-ratio: auto" aria-hidden="true"></svg>
                <svg class="dome-layer zdog" data-layer="above" style="height: 100%; aspect-ratio: auto" aria-label="The ground, the dome and the blend between them around where the image was taken, and two rays from a camera"></svg>
                <div class="frame-labels" aria-hidden="true"></div>
                <div class="scene-bar">
                    <p class="vis-credit footnote">
                        Drag to rotate, scroll to zoom. Visualized with <a href="https://zzz.dog/" target="_blank" rel="noopener">Zdog</a>.
                    </p>
                </div>
            </div>
            <figcaption><span class="subfigure-title">the surface</span>, to scale in meters</figcaption>
        </figure>
        <figure class="fig-tile">
            <EnvironmentFrame fullscreen exposure={false} ownView="Drag to turn the camera. Raytraced with WebGPU.">
                <div class="hdri-view as-seen">
                    <canvas data-field="canvas" style="aspect-ratio: 4 / 3" aria-label="The chosen HDRI laid on that surface, as the diagram's camera sees it"></canvas>
                    <svg class="ground-annotations" data-field="annotations" aria-hidden="true" style="display: none"></svg>
                </div>
                <span class="view-buttons" slot="start"><button type="button" class="view-icon" data-field="annotate" aria-pressed="false" title="The surface's lines from the diagram over the image: the dome's horizon, the image's lifted horizon, where the bend meets the dome, and the reach" aria-label="Annotations"><Icon name="labels" /></button></span>
            </EnvironmentFrame>
            <figcaption><span class="subfigure-title">the image</span> on it, from the camera</figcaption>
        </figure>
    </div>
    <div class="fig-controls env-exposure grounded-controls">
        {SLIDERS.map(({ name, label, title, min, max, step, value, marks }) => (
            <label class="figure-slider" title={title}>
                <span class="note">{label}</span>
                <span class="figure-slider-rail">
                    <input type="range" data-field={name} min={min} max={max} step={step} value={value} aria-label={title} />
                    <span class="figure-slider-scale" aria-hidden="true">{marks.map((mark, i) => <span class="figure-slider-mark" style={`left: ${i * 100}%`}>{mark}</span>)}</span>
                </span>
                <output data-field={`${name}Reading`}></output>
            </label>
        ))}
    </div>
    <figcaption class="figure-caption">
        The surface an image is laid on: (a) flat out to the reach, a dome for the sky, and between them a bend touching
        both, up to where the image's horizon meets the dome at most. Where a ray from the camera (accent) lands, the image is looked up from the capture point
        (dashed); a lifted horizon shows as a dashed ring. (b) The chosen image on it, as that camera sees it, the surface's lines over it on request.
    </figcaption>
</figure>

<script>
    import "./groundgeometry";
</script>
