---
import EnvironmentFrame from "../environment/EnvironmentFrame.astro";
import "../environment/environments.css";
import "../helldunkel/helldunkel.css";

const SLIDERS = [
    {
        name: "height",
        label: "height",
        title: "How far above the ground the image was taken, in the units the solids stand in",
        min: 0.2,
        max: 8,
        step: 0.1,
        value: 2,
        marks: ["0.2", "8"],
    },
    {
        name: "lift",
        label: "horizon",
        title: "How far the image's horizon is lifted, or lowered, in degrees",
        min: -20,
        max: 20,
        step: 0.5,
        value: 0,
        marks: ["−20°", "+20°"],
    },
    {
        name: "reach",
        label: "reach",
        title: "How far from under the camera that took the image its ground lies flat, about half the dome's radius at most; past it, the image recedes towards the dome",
        min: 0,
        max: 100,
        step: 1,
        value: 21,
        marks: ["3", "∞"],
    },
    {
        name: "radius",
        label: "dome",
        title: "The radius of the dome the image's horizon and sky lie on, at least two and a half heights; at the far end, without bound",
        min: 0,
        max: 100,
        step: 1,
        value: 100,
        marks: ["5", "∞"],
    },
];
---

<figure class="fig scene-frame wide" id="grounded" data-needs-hdri data-loading>
    <EnvironmentFrame fullscreen ownView="Drag to turn around, scroll to move closer. Raytraced with WebGPU.">
        <div class="hdri-view as-seen"><canvas data-field="canvas" aria-label="The five Platonic solids and a sphere, standing on the chosen HDRI's ground"></canvas></div>
    </EnvironmentFrame>
    <div class="fig-controls env-exposure grounded-controls">
        <button type="button" class="environments-button" data-field="flat" aria-pressed="true" title="Lay the image's ground on a plane, as far as its reach; off, all of it lies at infinity">flat ground</button>
        <button type="button" class="environments-button" data-field="even" aria-pressed="true" title="Read the image blurred evenly where the plane stretches it; off, as it is, in streaks">even blur</button>
        {SLIDERS.map(({ name, label, title, min, max, step, value, marks }) => (
            <label class="figure-slider" title={title}>
                <span class="note">{label}</span>
                <span class="figure-slider-rail">
                    <input type="range" data-field={name} min={min} max={max} step={step} value={value} aria-label={title} />
                    <span class="figure-slider-scale" aria-hidden="true">{marks.map((mark, i) => <span class="figure-slider-mark" style={`left: ${i * 100}%`}>{mark}</span>)}</span>
                </span>
                <output data-field={`${name}Reading`}></output>
            </label>
        ))}
    </div>
    <figcaption class="figure-caption">
        The solids on the chosen image's own ground, lit by its nine coefficients and dimmed where they hide its sky. The image
        holds no separate Sun, so there is no sharp shadow, only this soft one. Turn the flat ground off, and they float;
        push the reach to its far end, and whatever stands below the horizon lies smeared across a plane without end.
    </figcaption>
</figure>

<script>
    import "./grounded";
</script>
