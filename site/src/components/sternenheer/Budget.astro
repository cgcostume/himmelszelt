---
import "../sternzeit/sternzeit.css";
import "../nachtgestirn/nachtgestirn.css";
import "./budget.css";
import reference from "./budget-reference.json";
import {
    axisFor,
    BUDGET_ROWS,
    type BudgetMeasure,
    type BudgetRow,
    BY_CONFIGURATION,
    BY_SIZE,
    DEEP,
    FULL,
    filesOf,
    formatMiB,
    formatMs,
    memoryParts,
    ticksOf,
    timeParts,
} from "./budget-rows";

/**
 * What the stars pass costs: per configuration the time a frame takes on the GPU, split by pass, the GPU memory its
 * pass holds and the files it downloads, as the Moon's budget figure draws its own, with its styles. The reference is
 * budget-reference.json, written by `scripts/stars-budget.mjs`; the button measures the same rows on the reader's GPU
 * and draws them hatched under the reference's.
 */
interface Props {
    id?: string;
}
const { id = "budget" } = Astro.props;

const measure = reference as BudgetMeasure;
const MiB = 2 ** 20;
// The colors, as the Moon's figure numbers them: the stars, the Milky Way's map, the halos, the constellations; the
// compose pass and the tile lists it reads in the ink.
const COLORS: Record<string, string> = {
    bin: "budget-part-0",
    stars: "budget-part-0",
    catalog: "budget-part-0",
    faintStars: "budget-part-0",
    deepStars: "budget-part-0",
    catalogFull: "budget-part-0",
    faintStarsFull: "budget-part-0",
    deepStarsFull: "budget-part-0",
    deep: "budget-part-0",
    map: "budget-part-1",
    small: "budget-part-1",
    large: "budget-part-1",
    halo: "budget-part-2",
    halos: "budget-part-2",
    lines: "budget-part-3",
    constellations: "budget-part-3",
};
const NAMES: Record<string, string> = {
    tiles: "tile lists",
    map: "the Milky Way's map",
    lines: "constellations",
    faintStars: "faint stars",
    deepStars: "deep stars",
    catalogFull: "catalog",
    faintStarsFull: "faint stars",
    deepStarsFull: "deep stars",
    small: "the 2K map",
    large: "the 4K map",
};
const named = (parts: [string, number][], unit: string, digits: number) =>
    `${parts.map(([name, value]) => `${NAMES[name] ?? name} ${value.toFixed(digits)}`).join(", ")} ${unit}`;

const cells = BUDGET_ROWS.map((row) => {
    const measured = measure.rows[row.id];
    const memory = Object.entries(memoryParts(measured?.memory ?? {})).map(([name, b]) => [name, b / MiB]) as [
        string,
        number,
    ][];
    const files = filesOf(row).map((name) => [name, (measure.files?.[name] ?? 0) / MiB]) as [string, number][];
    return { row, measured, time: measured ? timeParts(measured) : [], memory, files };
});
const cellOf = (row: BudgetRow) => cells.find((cell) => cell.row === row) ?? cells[0];
// A part under some 5 KiB, the buffers the pass holds for what it does not draw, is left out of the bar.
const shown = (parts: [string, number][]) => parts.filter(([, mib]) => mib >= 0.005);
const sum = (parts: [string, number][]) => parts.reduce((total, [, value]) => total + value, 0);
const AXES = {
    ms: axisFor(Math.max(...cells.map((cell) => cell.measured?.frame ?? 0))),
    mb: axisFor(Math.max(...cells.map((cell) => sum(cell.memory))), 1.2),
    dl: axisFor(Math.max(...cells.map((cell) => sum(cell.files))), 1.45, 3),
};
const GROUPS = [
    {
        title: "What is drawn, each row adding to the one before, into 1920 by 1080 pixels",
        rows: BY_CONFIGURATION.map((row) => ({ row, label: row.label, note: row.note })),
    },
    {
        title: "The sky through the air, by the size of the target",
        rows: BY_SIZE.map((row) => ({
            row,
            label: `${row.width} by ${row.height}`,
            note: `${((row.width * row.height) / 1e6).toFixed(1)} million pixels`,
        })),
    },
    {
        title: "The same sky with the deep stars, which the package makes and does not ship, into 1920 by 1080 pixels",
        rows: DEEP.map((row) => ({ row, label: row.label, note: row.note })),
    },
    {
        title: "The catalogs in their full layouts in place of the compact ones, into 1920 by 1080 pixels",
        rows: FULL.map((row) => ({ row, label: row.label, note: row.note })),
    },
];
// Where and how the reference was measured, as the adapter names the GPU unless it is the one the site was measured on.
const GPUS: Record<string, string> = { "amd rdna-3": "an AMD Radeon RX 7900 XT" };
const credit = `${GPUS[measure.gpu] ?? measure.gpu} in ${measure.browser}, medians of ${measure.rounds} rounds of ${measure.frames} frames`;
const axes = Object.entries(AXES)
    .map(([name, { end, step }]) => `--axis-${name}: ${end}; --step-${name}: ${step}`)
    .join("; ");
---

<figure class="budget-figure stars-budget wide" id={id} data-stars-budget>
    <div class="budget-legend note" aria-hidden="true">
        <span><i class="budget-swatch budget-part-0"></i>stars</span>
        <span><i class="budget-swatch budget-part-3"></i>constellations</span>
        <span><i class="budget-swatch budget-part-2"></i>halos</span>
        <span><i class="budget-swatch budget-part-1"></i>Milky Way map</span>
        <span><i class="budget-swatch"></i>compose pass, tile lists</span>
        <span><i class="budget-swatch budget-defaults"></i>this GPU</span>
    </div>
    <div class="budget-grid" style={axes} role="img" aria-label={`Bar charts of the time a frame of the stars takes, split by pass, the GPU memory and the download, for ${BUDGET_ROWS.length} configurations: by what is drawn, by the size of the target, and with the deep stars`}>
        <span></span>
        <span class="budget-head note">time a frame, ms</span>
        <span class="budget-head note">GPU memory, MiB</span>
        <span class="budget-head note">download, MiB</span>
        {GROUPS.map((group) => (
            <>
                <span class="stars-budget-group note">{group.title}</span>
                {group.rows.map(({ row, label, note }) => {
                    const { measured, time, memory, files } = cellOf(row);
                    return (
                        <>
                            <span class="budget-size">
                                <span>{label}</span>
                                <span class="budget-defaults-note note">{note}</span>
                            </span>
                            <span class="budget-cell stars-budget-ms" data-label="time a frame, ms" data-row={row.id} data-ms={measured?.frame}>
                                {measured ? (
                                    <span class="budget-line" title={`${named(time, "ms", 3)}, the last with the clearing between the passes; ${measured.spread.p10.toFixed(3)} to ${measured.spread.p90.toFixed(3)} over the rounds`}>
                                        {time.map(([name, ms]) => <i class:list={["budget-bar", COLORS[name]]} style={`--v: ${ms}`}></i>)}
                                        <span class="budget-value">{formatMs(measured.frame)}</span>
                                    </span>
                                ) : (
                                    <span class="budget-line"><span class="budget-value">not measured yet</span></span>
                                )}
                                <span class="budget-line" data-field="mine" hidden></span>
                            </span>
                            <span class="budget-cell stars-budget-mb" data-label="GPU memory, MiB">
                                <span class="budget-line" title={named(shown(memory), "MiB", 2)}>
                                    {shown(memory).map(([name, mib]) => <i class:list={["budget-bar", COLORS[name]]} style={`--v: ${mib.toFixed(3)}`}></i>)}
                                    <span class="budget-value">{measured ? formatMiB(sum(memory)) : "–"}</span>
                                </span>
                            </span>
                            <span class="budget-cell stars-budget-dl" data-label="download, MiB">
                                <span class="budget-line" title={named(files, "MiB", 3)}>
                                    {files.map(([name, mib]) => <i class:list={["budget-bar", COLORS[name]]} style={`--v: ${mib.toFixed(4)}`}></i>)}
                                    <span class="budget-value">{formatMiB(sum(files))}</span>
                                </span>
                            </span>
                        </>
                    );
                })}
            </>
        ))}
        <span></span>
        {(["ms", "mb", "dl"] as const).map((axis) => (
            <span class:list={["budget-axis", "note", `stars-budget-${axis}`]} data-axis={axis} aria-hidden="true">
                {ticksOf(AXES[axis]).map((t) => <span style={`--v: ${t}`}>{t}</span>)}
            </span>
        ))}
    </div>
    <p class="stars-budget-run">
        <span class="view-buttons"><button type="button" class="view-toggle" data-field="measure" aria-pressed="false" title="Draw every row offscreen on this GPU and time its passes, the rows in turn: up to nine rounds of 96 frames each, fewer on a slow GPU. Press again to stop">measure on this GPU<span class="stars-budget-progress" aria-hidden="true"></span></button></span>
        <output class="note" data-field="status"></output>
    </p>
    <figcaption class="figure-caption">
        What sternenheer's stars cost: the time a frame takes on the GPU by its passes, the GPU memory the pass holds and
        the files it downloads, in the colors of what they serve, the stars, the constellations' lines, the halos and the
        Milky Way's map, with the compose pass and the tile lists it reads in gray. From the top: what is drawn, each row
        adding to the one before; the sky through the air at four sizes of the target; that sky with the deep
        stars; and three of these rows with the catalogs in their full layouts, as the data has them, in place of the
        compact ones the package loads by default. Hatched, the same rows measured on your GPU. The sky of August 12, 2026 over Berlin, the Milky Way from
        the zenith to the horizon, at EV<sub>100</sub> −9, which at 1920 by 1080 pixels shows stars down to magnitude
        12.5; solid, {credit}.
    </figcaption>
</figure>

<script>
    import { budgetFigure } from "./budget";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-stars-budget]")) budgetFigure(root);
</script>
