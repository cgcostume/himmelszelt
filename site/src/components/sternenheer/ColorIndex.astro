---
import Cite from "../Cite.astro";
import Term from "../Term.astro";
import "../sternzeit/sternzeit.css";
import "../dunstkreis/dunstkreis.css";
import "../dunstkreis/wavelengths.css";
import "./colorindex.css";
import StarPicker from "./StarPicker.astro";

/** From B-V to a color: the Planckian locus in the CIE 1931 diagram, the two formulas' colors over B-V, stars from films. */
interface Props {
    id?: string;
}
const { id = "colorindex" } = Astro.props;

const at = (bv: number) => (((bv + 0.3) / 2.3) * 100).toFixed(2);
const COLUMNS = ["T", "x", "y", "R", "G", "B"];
---

<figure class="eclipse-figure colorindex-figure" id={id} data-colorindex>
    <div class="eclipse-panel colorindex-panel">
        <div class="colorindex-plot">
            <svg data-field="diagram" role="img" aria-label="The Planckian locus in the CIE 1931 chromaticity diagram, magnified, with temperatures, the CIE's white points, sRGB's triangle and a marker at the chosen color index"></svg>
            <figure class="eclipse-view colorindex-inset">
                <svg class="colorindex-whole" data-field="whole" role="img" aria-label="The whole CIE 1931 chromaticity diagram, the spectrum around it, sRGB's triangle and the magnified part outlined"></svg>
                <figcaption><span class="subfigure-title">CIE 1931</span>, the whole diagram</figcaption>
            </figure>
        </div>
        <table class="wavelengths-matrix colorindex-numbers" aria-label="The temperature, the chromaticity and the linear sRGB color at the chosen color index">
            <thead>
                <tr><th></th>{COLUMNS.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
                <tr data-row="ballesteros"><th>Ballesteros</th>{COLUMNS.map((_, i) => <td data-cell={`ballesteros:${i}`}></td>)}</tr>
                <tr data-row="jensen"><th>Jensen</th>{COLUMNS.map((_, i) => <td data-cell={`jensen:${i}`}></td>)}</tr>
            </tbody>
        </table>
    </div>
    <div class="figure-slider" aria-hidden="true">
        <span class="note colorindex-names"><span data-strip="ballesteros">Ballesteros</span><span data-strip="jensen">Jensen et al.</span></span>
        <span class="figure-slider-rail"><svg data-field="band" aria-label="The colors of stars over the color index B−V from −0.3 to 2, by Ballesteros' temperature and by Jensen et al.'s"></svg></span>
        <output class="colorindex-ghost">0.00</output>
    </div>
    <label class="figure-slider" title="The color index B−V: drag, or click the strips or the locus">
        <span class="note">B−V</span>
        <span class="figure-slider-rail">
            <input type="range" data-field="bv" min="-0.3" max="2" step="0.01" value="0.65" aria-label="The color index B−V" />
            <span class="figure-slider-scale colorindex-scale" aria-hidden="true">
                {[0, 0.5, 1, 1.5, 2].map((v) => <span class:list={["figure-slider-mark", v % 1 && "colorindex-half"]} style={`left: ${at(v)}%`}>{v}</span>)}
                <span class="figure-slider-mark colorindex-sun" style={`left: ${at(0.65)}%`}><span class="figure-slider-tick"></span>Sun</span>
            </span>
        </span>
        <output data-field="bvValue">0.65</output>
    </label>
    <StarPicker label="Stars, from films and history" sun />
    <figcaption class="figure-caption">
        From a <Term of="Color index">color index</Term> to a color: the <Term of="Planckian locus">Planckian
        locus</Term> <Cite id="kang2002" /> in the CIE 1931 <Term of="Chromaticity">chromaticity</Term> diagram,
        magnified, with temperatures in kelvin along it, the CIE's white points <Cite id="cie2018" />, A a tungsten
        lamp, D50 to D75 daylight, D65 sRGB's white and E equal energy, and sRGB's triangle dashed; in bold, the part that
        B−V from −0.3 to 2 reaches by Ballesteros' temperature <Cite id="ballesteros2012" />, which the catalog uses, dashed by Jensen et al.'s older approximation <Cite id="jensen2001" />, osgHimmel's. (a) The whole
        diagram, the spectrum around it and the magnified part outlined. Under the locus, each color index as its color
        by either formula in linear sRGB at a luminance of 1, scaled so that its strongest channel is full, on the
        slider's scale; under the slider, stars that films and history name, among
        them Vega, Polaris and Sirius, and the Sun. Spectral locus from CIE 018:2019, CC BY-SA 4.0.
    </figcaption>
</figure>

<script>
    import { colorIndexFigure } from "./colorindex";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-colorindex]")) colorIndexFigure(root);
</script>
