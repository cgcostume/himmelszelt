---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Try from "../Try.astro";
import "./onestar.css";
import { FILM_STARS } from "./filmstars";
import StarPicker from "./StarPicker.astro";

/**
 * One star of the catalog followed through every step to its pixels, as a strip of stages: its row, its place at the
 * chosen moment and place, its light, its color, what the air does to both, and the pass' own pixels, magnified. The
 * stars to follow are the ones films made famous, each row read from the catalog's CSV at build time.
 */
interface Props {
    id?: string;
    try?: { label: string; set: string; text: string };
}
const { id = "onestar", try: experiment } = Astro.props;

// Astro builds and serves from site/, whichever bundle this frontmatter ends up in.
const csv = readFileSync(resolve(process.cwd(), "../packages/sternenheer/data/brightstars.csv"), "utf8");
const rows = csv.trim().split("\n");
const choices = FILM_STARS.map((star) => {
    const line = rows[star.row + 1] ?? "";
    const [magnitude, ra, de, pmRa, pmDe, bv] = line.split(",").map(Number) as number[];
    if (bv !== star.bv) throw new Error(`OneStar: row ${star.row} of brightstars.csv is not ${star.name}'s`);
    return { ...star, line, magnitude, ra, de, pmRa, pmDe, bv };
});
const header = rows[0];
const STAGES = [
    { field: "row", name: "its row", fn: "brightstars.csv" },
    { field: "place", name: "its place tonight", fn: "stars.horizontalMatrix" },
    { field: "light", name: "its light", fn: "illuminanceFromMagnitude" },
    { field: "color", name: "its color", fn: "colorFromColorIndex" },
    { field: "air", name: "through the air", fn: "liftedDirection, airAt" },
    { field: "pixels", name: "its pixels", fn: "createStarsPass" },
];
---

<figure class="fig onestar-figure wide" id={id} data-one-star data-choices={JSON.stringify(choices)} data-header={header} data-actions="copy">
    <StarPicker label="The star to follow" class="onestar-pick" />
    <ol class="onestar-strip">
        {STAGES.map((stage, i) => (
            <li class="onestar-stage" data-stage={stage.field}>
                <span class="onestar-name"><span class="onestar-step">{i + 1}</span> {stage.name}</span>
                <div class:list={["onestar-visual", stage.field === "pixels" && "as-seen"]} data-field={`${stage.field}Visual`}>
                    {stage.field === "pixels" && <canvas data-field="patch" aria-label="The star's pixels as sternenheer's pass draws them, magnified, rendered with WebGPU"></canvas>}
                </div>
                <dl class="onestar-numbers" data-field={stage.field}></dl>
                <code class="onestar-fn" set:html={stage.fn.replace(/(?=[A-Z])|(?<=\.)/g, "<wbr>")} />
            </li>
        ))}
    </ol>
    <div class="fig-controls">
        <label class="figure-slider" style="--output-ch: 4ch" title="The exposure the pixels are shown at: a moonless night meters about EV100 −9. Brighter to the right">
            <span class="note">EV<sub>100</sub></span>
            <span class="figure-slider-rail">
                <input type="range" data-field="exposure" min="0" max="14" step="0.5" value="9" aria-label="The exposure of the pixels, as minus the EV100" />
            </span>
            <output data-field="ev"></output>
        </label>
        <span class="view-buttons">
            <button type="button" class="view-toggle" data-field="halo" aria-pressed="true" title="The halo: the light the core cannot show beyond display white, spread around it, falling with the cube of the distance">glare</button>
        </span>
    </div>
    <figcaption class="figure-caption">
        One star of the Yale catalog followed step by step to the screen, its pixels magnified, 2 arcminutes each;
        under them, its middle row's brightness on a logarithmic scale, the knee dashed.
        {experiment && <Try label={experiment.label} set={experiment.set} fig={id}>{experiment.text}</Try>}
    </figcaption>
</figure>

<script>
    import { oneStarFigure } from "./onestar";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-one-star]")) oneStarFigure(root);
</script>
