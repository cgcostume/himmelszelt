---
import "./passes.css";
import StarGroups from "./StarGroups.astro";

/**
 * A frame of the stars pass as a frame graph: what the pass reads at the left, a box per dispatch labeled with what it
 * runs over, and what each leaves for the next as a thumbnail on its arrow, read back from the pass made with `debug`
 * (passes-graph.ts lays it out). Sliders for the tiles' size and capacity, the catalog's buttons, and switches for
 * nachtgestirn's Moon and dunstkreis' air.
 */
interface Props {
    id?: string;
}
const { id = "passes" } = Astro.props;
const THUMBS = [
    ["tiles", "The tile lists, by the stars that reach each tile, the full ones in the accent"],
    ["points", "The halos' grid as the bin pass leaves it: each star's light past the knee, a point"],
    ["spread", "The halos: the grid halved and added back up, each level its share"],
    ["lines", "The lines' tiles, by the pieces of the constellations' lines in each"],
    ["image", "The frame as the last pass leaves it, tone mapped"],
];
---

<figure class="fig wide passes-figure" id={id} data-passes>
    <div class="passes-graph" data-actions="png copy">
        <svg data-field="graph" role="img" aria-label="The passes of a frame of sternenheer's stars, what each reads and what it leaves for the next"></svg>
        {THUMBS.map(([field, label]) => (
            <canvas data-field={field} class:list={["passes-canvas", (field === "tiles" || field === "lines") && "passes-blocky"]} aria-label={label}></canvas>
        ))}
    </div>
    <label class="figure-slider" title="How many pixels a side of a tile spans: wider tiles hold more stars each, and every pixel has more of them to look through">
        <span class="note">tile size</span>
        <span class="figure-slider-rail"><input type="range" data-field="tileSize" min="3" max="6" step="1" value="4" aria-label="The tiles' size, as a power of two in pixels" /></span>
        <output data-field="tileSizeValue"></output>
    </label>
    <label class="figure-slider" title="How many stars a tile holds: a full one keeps its brightest and drops the rest">
        <span class="note">capacity</span>
        <span class="figure-slider-rail"><input type="range" data-field="capacity" min="3" max="8" step="1" value="8" aria-label="The stars a tile holds, as a power of two" /></span>
        <output data-field="capacityValue"></output>
    </label>
    <p class="view-status">
        <span class="passes-switches">
            <StarGroups offsets={[]} />
            <span class="view-buttons">
                <button type="button" class="view-toggle" data-field="moon" aria-pressed="true" title="nachtgestirn's Moon over the frame, lighting the sky and hiding the stars behind its disc: one more pass, over every pixel">Moon</button>
                <button type="button" class="view-toggle" data-field="air" aria-pressed="true" title="dunstkreis' air: every star lifted by the refraction, dimmed and reddened by the extinction, the ground below the horizon and the sky's own light behind, one more pass; off, the stars from above the air, over black">air</button>
            </span>
        </span>
        <span data-field="status" aria-live="polite"></span>
    </p>
    <figcaption class="figure-caption">
        The passes of one frame of sternenheer's stars, 960 by 540 pixels, looking south 35° up at the chosen moment and
        place: what they read at the left, a box per dispatch, and what each leaves for the next on its arrow, the halos
        on their logarithmic curve. Dimmed, what does not run.
    </figcaption>
</figure>

<script>
    import { passesFigure } from "./passes";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-passes]")) passesFigure(root);
</script>
