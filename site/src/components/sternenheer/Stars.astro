---
import "../dunstkreis/dunstkreis.css";
import { CONSTELLATIONS } from "@himmelszelt/sternenheer";
import Choice from "../dunstkreis/Choice.astro";
import Hdr from "../dunstkreis/Hdr.astro";
import Lens from "../dunstkreis/Lens.astro";
import OptionGroup from "../dunstkreis/OptionGroup.astro";
import SkyFrame from "../dunstkreis/SkyFrame.astro";
import Try from "../Try.astro";
import StarGroups from "./StarGroups.astro";

/**
 * The stars figure: sternenheer's stars and Milky Way over dunstkreis' sky in cd/m², nachtgestirn's Moon over them,
 * composed and tone mapped by the Moon pass, in the shared frame, a wide view towards the south. Its buttons pick the
 * catalog and the light of the stars and the Milky Way; its options switch the air, the twinkling, the halo and the eye
 * at night, the Moon, and set the exposure.
 */
interface Props {
    id?: string;
    caption?: string;
    try?: { label: string; set: string; text: string };
}
const {
    id = "stars",
    caption = "The stars at the chosen moment and place over dunstkreis' sky, under nachtgestirn's Moon: the catalogs the buttons pick, each star at its light in lux, and NASA's Milky Way, all seen through the air.",
    try: experiment,
} = Astro.props;

const MAPS = {
    name: "maps",
    label: "Milky Way map",
    title: "Which of sternenheer's maps of the Milky Way is drawn: by default the one the view needs, the 8K map (18.5 MB, a texel 2.6 arcminutes) fetched only once a pixel spans less than a texel of the 4K map, 5.3 arcminutes; or the 2K map (810 KB, a texel ten arcminutes) or the 4K map (4 MB) throughout",
    options: [
        ["auto", "auto"],
        ["small", "2K"],
        ["large", "4K"],
    ],
    checked: "auto",
};
const TONE = {
    name: "tone",
    label: "Tone curve",
    title: "Khronos PBR Neutral keeps colors as they are and compresses only the brightest, AgX fades bright colors towards white as film does, ACES is the saturated filmic curve used before, none cuts the light off where it saturates",
    options: [
        ["clip", "none"],
        ["neutral", "neutral"],
        ["agx", "AgX"],
        ["aces", "ACES"],
    ],
    checked: "neutral",
};
---

<figure class="fig scene-frame wide" id={id} data-stars>
    <SkyFrame png fly ownHeight marks={1} locked={false} lockIcon="moonLock" lockTitle="Keep the view on the Moon; dragging lets go" hint="Drag to look around, scroll to zoom. Rendered with WebGPU, the stars and the Moon over dunstkreis' sky.">
        <canvas data-field="canvas" aria-label="The stars at the chosen moment and place"></canvas>
        <div class="sky-compass" data-field="compassLabels"></div>
        <Fragment slot="bar">
            <StarGroups />
        </Fragment>
        <Fragment slot="options">
            <OptionGroup name="exposure">
                <label class="sky-ev">EV<sub>100</sub> <input data-field="exposure" type="range" min="-20" max="14" step="0.1" value="9" title="Brighter to the right: a lower EV lets in more light" /> <output data-field="ev" /></label>
                <button type="button" class="view-toggle" data-field="auto" aria-pressed="true" title="Expose for the sky where it is brighter than the stars, by day and by moonlight, else for the Milky Way">metered</button>
            </OptionGroup>
            <OptionGroup name="sky">
                <button type="button" class="view-toggle" data-field="moon" aria-pressed="true" title="nachtgestirn's Moon, lighting the sky and hiding the stars behind its disc, lit or not">Moon</button>
                <Choice figure={id} {...MAPS} />
            </OptionGroup>
            <OptionGroup name="constellations">
                <button type="button" class="view-toggle" data-field="lines" aria-pressed="false" title="The constellations' lines, a hint between the stars that stops short of each of them">lines</button>
                <select class="stars-constellations" data-field="constellations" aria-label="Which constellations" title="Which constellations to draw the lines of">
                    <option value="all">all 88</option>
                    <option value="zodiac">the zodiac</option>
                    {CONSTELLATIONS.map(([abbreviation, name]) => <option value={abbreviation}>{name}</option>)}
                </select>
            </OptionGroup>
            <OptionGroup name="air">
                <button type="button" class="view-toggle" data-field="air" aria-pressed="true" title="The air: every star lifted by the refraction, dimmed and reddened by the extinction, and the sky's own light in front; off, the stars from space, over black">air</button>
                <button type="button" class="view-toggle" data-field="twinkle" aria-pressed="false" title="The twinkling: each star's light flickers by the air's turbulence, more near the horizon, where its colors come apart. Runs on while pressed">twinkle</button>
            </OptionGroup>
            <OptionGroup name="eye">
                <button type="button" class="view-toggle" data-field="glare" aria-pressed="true" title="The halo around a bright star: the light its core cannot show, spread around it, falling with the cube of the distance, wider the brighter the star">glare</button>
                <button type="button" class="view-toggle" data-field="eye" aria-pressed="true" title="As the dark-adapted eye sees the night rather than a camera: below some 4 cd/m² the rods take over from the cones, colors fade and what is left shifts towards blue">night vision</button>
            </OptionGroup>
            <Lens />
            <OptionGroup name="HDR (× SDR white)">
                <Hdr figure={id} />
            </OptionGroup>
            <OptionGroup name="tone mapping">
                <Choice figure={id} {...TONE} />
            </OptionGroup>
        </Fragment>
    </SkyFrame>
    <label class="figure-slider" title="How much of the light past a star's knee its halo shows: none at the left, all of it at the right, where the halo adds no light and takes none">
        <span class="note">halo</span>
        <span class="figure-slider-rail"><input type="range" data-field="halo" min="0" max="1" step="0.05" value="1" aria-label="The share of the light past the knee the halos show" /></span>
        <output data-field="haloValue"></output>
    </label>
    <p class="view-status"><span data-field="status" /> <span class="sky-timing" data-field="timing" /></p>
    <figcaption class="figure-caption">
        {caption}
        {experiment && <Try label={experiment.label} set={experiment.set} fig={id}>{experiment.text}</Try>}
    </figcaption>
</figure>

<script>
    import { starsFigure } from "./stars";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-stars]")) starsFigure(root);
</script>
