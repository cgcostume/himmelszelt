---
import Term from "../Term.astro";
import "../sternzeit/sternzeit.css";
import "../dunstkreis/dunstkreis.css";
import "./storedark.css";
import data from "./storedark.json";

/**
 * One dark patch of the Milky Way's map three ways side by side: the half floats of NASA's source, 8-bit sRGB and
 * sternenheer's logarithm in 8 bits, at one exposure, with the levels each spends on every stop under it. The patches and the
 * sizes come from `scripts/milkyway-crops.mjs`.
 */
interface Props {
    id?: string;
}
const { id = "store-dark" } = Astro.props;

const BASE = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/milkyway`;
const megabytes = (bytes: number) => `${(bytes / 1e6).toFixed(bytes < 5e6 ? 1 : 0)} MB`;
// The whole map's bytes at 2048 texels around: the shipped 2K WebP, sRGB encoded the same way from the floats averaged
// down, and the half floats as an EXR compressed as NASA's 4K one, which NASA does not publish at 2K.
const PANELS = [
    { kind: "float", title: "half floats", small: 8906134, large: data.sizes.exr },
    { kind: "srgb", title: "8-bit sRGB", small: 605850, large: data.sizes.srgb },
    { kind: "log", title: "8-bit logarithm", small: 812714, large: data.sizes.log },
];
const PATCHES = [
    { name: "pole", label: "pole", title: "Around the north galactic pole, the darkest sky in the map" },
    {
        name: "band",
        label: "Cygnus",
        title: "Across the band in Cygnus, the Great Rift's dark lanes beside the star clouds",
    },
];
const DEGREES_PER_TEXEL = 360 / 4096;
const EV_MARKS = [6, 10, 14, 18];
const at = (v: number) => `${(((v - 6) / 12) * 100).toFixed(2)}%`;
---

<figure class="eclipse-figure storedark-figure" id={id} data-storedark data-base={BASE} data-patches={JSON.stringify(data.patches)} data-stops={data.stops}>
    <div class="eclipse-views storedark-views">
        {PANELS.map((panel) => (
            <figure class="eclipse-view" data-panel={panel.kind}>
                <div class="storedark-panel as-seen">
                    <canvas aria-label={`The patch stored as ${panel.title}, rendered with WebGPU`}></canvas>
                </div>
                <svg class="storedark-levels" data-levels={panel.kind} role="img" aria-label={`The levels ${panel.title} spends on each stop below white, the patch's stops shaded`}></svg>
                <figcaption><span class="subfigure-title">{panel.title}</span> ({megabytes(panel.small)} at 2K, {megabytes(panel.large)} at 4K), <span data-field="levels"></span> a stop</figcaption>
            </figure>
        ))}
    </div>
    <p class="lut-controls">
        <span class="steps" role="radiogroup" aria-label="The patch of sky">
            <span class="steps-heading" aria-hidden="true">patch</span>
            {PATCHES.map((patch, i) => (
                <label title={patch.title}>
                    <input type="radio" name={`${id}-patch`} value={patch.name} checked={i === 0} />
                    <span>{patch.label}</span>
                </label>
            ))}
        </span>
        <button type="button" class="view-toggle" data-field="webp" aria-pressed="true" title="The 8-bit patches as the whole map's WebP at quality 95 decodes, as the package ships it; off, their bytes rounded from the floats, before the compression">WebP</button>
        <button type="button" class="view-toggle" data-field="zoom" aria-pressed="true" title="The middle of each patch four times as large, a texel four times as wide, filtered as the package filters it">4 × as large</button>
    </p>
    <label class="figure-slider" title="The exposure, in EV100: each step of 1 lets in twice the light. The patch's meter reading when it is chosen. Brighter to the right">
        <span class="note">EV<sub>100</sub></span>
        <span class="figure-slider-rail">
            <input type="range" data-field="exposure" min="6" max="18" step="0.1" value="14.8" aria-label="The exposure, as minus the EV100" />
            <span class="figure-slider-scale" aria-hidden="true">{EV_MARKS.map((v) => <span class="figure-slider-mark" style={`left: ${at(v)}`}>−{v}</span>)}</span>
        </span>
        <output data-field="exposureValue"></output>
    </label>
    <p class="view-status" data-field="status" aria-live="polite" hidden></p>
    <figcaption class="figure-caption">
        One patch of the Milky Way's map, {data.size} texels or {Math.round(data.size * DEGREES_PER_TEXEL)}° square,
        stored three ways and shown at the chosen exposure through the page's tone curve, its middle magnified four
        times: (a) as the half floats of NASA's source, the reference, (b) as 8-bit sRGB, (c) as sternenheer's logarithm
        over {data.stops} stops. The 8-bit patches are cut from the whole map encoded as the package ships it, a WebP at
        quality 95, or at a switch rounded from the floats before the compression, and decoded as
        <code>createMilkyWay</code> reads them. Under each, the levels it spends on every <Term of="Stop">stop</Term>
        below the map's white, the first to the twelfth on a logarithmic scale, the stops of the patch's middle 96% in
        the accent; in parentheses the size of the whole map at 2048 and 4096 texels around, as WebP at quality 95 or as
        EXR, the 2K EXR computed, as NASA publishes none. The patch around the north galactic pole, or across the band
        in Cygnus, both with the stars taken out as in the shipped maps. Map from NASA's Scientific Visualization
        Studio, Deep Star Maps 2020.
    </figcaption>
</figure>

<script>
    import { storeDarkFigure } from "./storedark";

    for (const root of document.querySelectorAll<HTMLElement>("figure[data-storedark]")) storeDarkFigure(root);
</script>
