---
import glossary from "../../data/glossary.json";
import Icon from "../Icon.astro";
import "./sternzeit.css";

interface Props {
    /** Starts unfolded; folded sets show just a one-line summary of the current moment and place. */
    open?: boolean;
    /** Offers the observer's height, for where it matters; it stays part of the moment and place either way. */
    height?: boolean;
}
const { open = false, height = true } = Astro.props;
// Unique per instance, so every label still points at its own input when a page has several sets of controls.
const uid = `moment-${Math.random().toString(36).slice(2, 8)}`;
// The step sizes of each field, as a group of radio buttons: one tap on a touch screen, and the current one stays visible.
// A unit follows its number after a narrow no-break space (U+202F), as everywhere on the site.
const jdSteps = [
    { label: "year", value: "365.25", calendar: "year" },
    { label: "month", value: "30.436875", calendar: "month" },
    { label: "week", value: "7", calendar: "week" },
    { label: "day", value: "1", calendar: "day", checked: true },
    { label: "hour", value: "0.0416666666667" },
    { label: "min", value: "0.0006944444444" },
    { label: "sec", value: "0.0000115740741" },
];
const angleSteps = [
    { label: "deg", title: "One degree", value: "1", checked: true },
    { label: "min", title: "One arcminute, a sixtieth of a degree", value: "0.0166666666667" },
    { label: "sec", title: "One arcsecond, a sixtieth of an arcminute", value: "0.0002777777778" },
];
const heightSteps = [
    { label: "1\u202fm", value: "1" },
    { label: "10\u202fm", value: "10", checked: true },
    { label: "100\u202fm", value: "100" },
    { label: "1\u202fkm", value: "1000" },
    { label: "10\u202fkm", value: "10000" },
];
---

<details class="moment" open={open}>
    <summary>
        <span class="moment-title">Moment and place</span> <span class="note" data-field="summary"></span>
        {/* Inside the summary, so it is there while the set is folded away too; the click does not toggle it. */}
        <button type="button" data-field="copy" class="icon-button" title="Copy this moment and place as JSON" aria-label="Copy this moment and place as JSON">
            <Icon name="copy" />
        </button>
    </summary>
    <div class="input-grid">
        <label for={`${uid}-jd`}>Julian Day</label>
        <span class="stepper">
            <button type="button" data-step="-1" aria-label="Julian Day, one step back">&#8722;</button>
            <input id={`${uid}-jd`} data-field="jd" type="number" />
            <button type="button" data-step="1" aria-label="Julian Day, one step forward">+</button>
            <button type="button" data-field="live" aria-pressed="false">now</button>
            <button type="button" data-field="animate" aria-pressed="false" title="Step on by itself, thirty times a second">animate</button>
        </span>
        <span class="note" aria-hidden="true">Step</span>
        <span class="input-grid-subrow">
            <span class="steps" role="radiogroup" aria-label="Julian Day step" data-field="jdStep">
                {
                    jdSteps.map((step) => (
                        <label>
                            <input
                                type="radio"
                                name={`${uid}-jd-step`}
                                value={step.value}
                                data-calendar={step.calendar}
                                checked={step.checked}
                            />
                            <span>{step.label}</span>
                        </label>
                    ))
                }
            </span>
        </span>

        <span class="note" aria-hidden="true">Clock</span>
        <span class="input-grid-subrow">
            <span class="steps" role="radiogroup" aria-label="Time zone of the clock time" data-field="timeZone">
                <label title="Your own time zone, as your browser has it">
                    <input type="radio" name={`${uid}-time-zone`} value="yours" checked />
                    <span>yours</span>
                </label>
                <label title={glossary["Local time"]}>
                    <input type="radio" name={`${uid}-time-zone`} value="local" />
                    <span>local</span>
                </label>
                <label title={glossary["Local mean time"]}>
                    <input type="radio" name={`${uid}-time-zone`} value="mean" />
                    <span>mean</span>
                </label>
            </span>
        </span>

        <label for={`${uid}-latitude`}>Latitude</label>
        <span class="stepper">
            <button type="button" data-step="-1" aria-label="Latitude, one step back">&#8722;</button>
            <input id={`${uid}-latitude`} data-field="latitude" class="latlong" type="number" />
            <button type="button" data-step="1" aria-label="Latitude, one step forward">+</button>
            <button type="button" data-field="geolocate" title="Use browser location" aria-label="Use browser location">
                <Icon name="locate" />
            </button>
        </span>

        <label for={`${uid}-longitude`}>Longitude</label>
        <span class="stepper">
            <button type="button" data-step="-1" aria-label="Longitude, one step back">&#8722;</button>
            <input id={`${uid}-longitude`} data-field="longitude" class="latlong" type="number" />
            <button type="button" data-step="1" aria-label="Longitude, one step forward">+</button>
        </span>

        <span class="note" aria-hidden="true">Step</span>
        <span class="input-grid-subrow">
            <span class="steps" role="radiogroup" aria-label="Latitude and longitude step" data-field="latlongStep">
                {
                    angleSteps.map((step) => (
                        <label title={step.title}>
                            <input type="radio" name={`${uid}-latlong-step`} value={step.value} checked={step.checked} />
                            <span>{step.label}</span>
                        </label>
                    ))
                }
            </span>
            <span data-field="location" class="note"></span>
        </span>

        {
            height && (
                <>
                    <label for={`${uid}-height`}>Height</label>
                    <span class="stepper">
                        <button type="button" data-step="-1" aria-label="Height, one step back">&#8722;</button>
                        <input id={`${uid}-height`} data-field="height" class="latlong" type="number" min="1" max="408000" />
                        <button type="button" data-step="1" aria-label="Height, one step forward">+</button>
                    </span>
                    <span class="note" aria-hidden="true">Step</span>
                    <span class="input-grid-subrow">
                        <span class="steps" role="radiogroup" aria-label="Height step" data-field="heightStep">
                            {
                                heightSteps.map((step) => (
                                    <label>
                                        <input type="radio" name={`${uid}-height-step`} value={step.value} checked={step.checked} />
                                        <span>{step.label}</span>
                                    </label>
                                ))
                            }
                        </span>
                    </span>
                </>
            )
        }
    </div>
</details>

<script>
    import "./controls";
</script>
