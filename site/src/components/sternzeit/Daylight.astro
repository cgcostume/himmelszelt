---
import Term from "../Term.astro";
import Try from "../Try.astro";
import LatitudeSlider from "./LatitudeSlider.astro";
import "./sternzeit.css";
---

<figure class="strip-figure" id="daylight">
    <div class="strip-panel daylight-panel" data-export="daylight">
        <svg aria-hidden="true"></svg>
    </div>
    <LatitudeSlider />
    <figcaption class="figure-caption">
        The year at the chosen place, day by day from left to right, midnight to midnight from top to bottom on the chosen
        clock, its daylight saving time included: <span class="daylight-key daylight-day">day</span>, the <span class="daylight-key daylight-golden"
            >golden</span
        > and the <span class="daylight-key daylight-blue">blue</span> hour, then nautical and astronomical <Term of="Twilight">twilight</Term>,
        each a shade darker, and night. The line through the golden hour is sunrise and sunset. The slider's ticks are the
        tropics and the polar circles.
        <Try label="Tromsø" set="lat=69.65&lon=18.96" fig="daylight">
            midnight sun from May 18 to July 24, polar night from November 28 to January 14.
        </Try>
    </figcaption>
</figure>

<script>
    import "./daylight";
</script>
