---
import Term from "../Term.astro";
import Try from "../Try.astro";
import "./sternzeit.css";
---

<figure class="strip-figure wide" id="delta-t">
    <div class="strip-panel deltat-panel" data-export="delta-t">
        <svg aria-hidden="true"></svg>
    </div>
    <figcaption class="figure-caption">
        <Term of="Delta T">ΔT</Term> after Espenak and Meeus, measured by the IERS since 1962, and at the chosen moment, on a
        logarithmic scale. The years before 1800 are compressed on one too. Before −500 the curve is their long-term
        parabola, fitted to ancient eclipses, and before −2000 only extrapolated, as are the years after today.
        <Try label="The year 1000" set="date=1000-07-01T12:00Z" fig="delta-t">
            ΔT was 26 minutes. Leave it out, and an eclipse of that time lands 6.5° of longitude off.
        </Try>
    </figcaption>
</figure>

<script>
    import "./deltat";
</script>
