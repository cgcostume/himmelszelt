---
import Term from "../Term.astro";
import "./sternzeit.css";
---

<figure class="strip-figure wide" id="delta-t">
    <div class="strip-panel deltat-panel" data-export="delta-t">
        <svg aria-hidden="true"></svg>
    </div>
    <figcaption class="figure-caption">
        <Term of="Delta T">ΔT</Term> on a logarithmic scale from the year −2000 to 2150, the years before 1750 compressed
        on one as well: after Espenak and Meeus, measured by the IERS since 1962, and at the chosen moment. Years in
        astronomical numbering, with a year 0. Hover to read off any other.
    </figcaption>
</figure>

<script>
    import "./deltat.js";
</script>
