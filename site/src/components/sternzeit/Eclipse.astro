---
import Term from "../Term.astro";
import "./sternzeit.css";
---

<figure class="eclipse-figure" id="eclipse-views">
<div class="eclipse-views">
    <figure class="eclipse-view" data-kind="solar" data-export="solar-eclipse">
        <div class="eclipse-panel">
        <svg viewBox="-100 -100 200 200" aria-hidden="true"></svg>
        <span class="eclipse-jump">
            <button type="button" data-jump="solar" data-step="-1" title="The eclipse before this moment" aria-label="The eclipse before this moment">prev</button>
            nearby eclipse
            <button type="button" data-jump="solar" data-step="1" title="The eclipse after this moment" aria-label="The eclipse after this moment">next</button>
        </span>
        </div>
        <figcaption>
            <span class="subfigure-title">solar eclipse</span>, as seen from the chosen place:{" "}
            <span data-field="status"></span>
            <span class="eclipse-orientation">zenith up, azimuth increasing to the right</span>
        </figcaption>
    </figure>
    <figure class="eclipse-view" data-kind="lunar" data-export="lunar-eclipse">
        <div class="eclipse-panel">
        <svg viewBox="-100 -100 200 200" aria-hidden="true"></svg>
        <span class="eclipse-jump">
            <button type="button" data-jump="lunar" data-step="-1" title="The eclipse before this moment" aria-label="The eclipse before this moment">prev</button>
            nearby eclipse
            <button type="button" data-jump="lunar" data-step="1" title="The eclipse after this moment" aria-label="The eclipse after this moment">next</button>
        </span>
        </div>
        <figcaption>
            <span class="subfigure-title">lunar eclipse</span>, the same from anywhere: <span data-field="status"></span>
            <span class="eclipse-orientation">ecliptic north up, east left, as on the sky</span>
        </figcaption>
    </figure>
</div>
    <figcaption class="figure-caption">
        Eclipses. (a) The Moon in front of the Sun. (b) The Moon in Earth's{" "}
        <Term of="Umbra">umbra</Term> and <Term of="Penumbra">penumbra</Term>. Magnified,
        discs, shadows and horizon true to each other. Corona modified from a{" "}
        <a href="https://philhart.com/exmouth-eclipse/" target="_blank" rel="noopener">photograph by Phil Hart</a> of the
        total eclipse of 20 April 2023, from Exmouth, Western Australia.
    </figcaption>
</figure>

<script>
    import "./eclipse.js";
</script>
