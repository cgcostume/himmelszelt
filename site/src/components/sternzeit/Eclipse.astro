---
import Term from "../Term.astro";
import "./sternzeit.css";
---

<figure class="eclipse-figure" id="eclipse-views">
<div class="eclipse-views">
    <figure class="eclipse-view" data-kind="solar" data-export="solar-eclipse">
        <div class="eclipse-panel">
        <svg viewBox="-100 -100 200 200" aria-hidden="true"></svg>
        <span class="eclipse-jump">
            <button type="button" data-jump="solar" data-step="-1" title="The eclipse before this moment" aria-label="The eclipse before this moment">earlier</button>
            eclipse
            <button type="button" data-jump="solar" data-step="1" title="The eclipse after this moment" aria-label="The eclipse after this moment">later</button>
        </span>
        </div>
        <label class="figure-slider" title="The moment, up to 2 hours either way from where it was set: drag, or turn the mouse wheel for a minute a notch">
            <span class="figure-slider-rail">
                <input type="range" data-field="offset" min="-120" max="120" step="1" value="0" aria-label="Minutes from the moment" />
                <span class="figure-slider-scale" aria-hidden="true">{["−2", "0", "+2"].map((mark, i) => <span class="figure-slider-mark" style={`left: ${i * 50}%`}>{mark}{i !== 1 && <span class="figure-slider-unit"> h</span>}</span>)}</span>
            </span>
            <output data-field="offsetValue"></output>
        </label>
        <figcaption>
            <span class="subfigure-title">solar eclipse</span>, as seen from the chosen place
            <span data-field="status" class="result"></span>
        </figcaption>
    </figure>
    <figure class="eclipse-view" data-kind="lunar" data-export="lunar-eclipse">
        <div class="eclipse-panel">
        <svg viewBox="-100 -100 200 200" aria-hidden="true"></svg>
        <span class="eclipse-jump">
            <button type="button" data-jump="lunar" data-step="-1" title="The eclipse before this moment" aria-label="The eclipse before this moment">earlier</button>
            eclipse
            <button type="button" data-jump="lunar" data-step="1" title="The eclipse after this moment" aria-label="The eclipse after this moment">later</button>
        </span>
        </div>
        <label class="figure-slider" title="The moment, up to 3 hours either way from where it was set: drag, or turn the mouse wheel for a minute a notch">
            <span class="figure-slider-rail">
                <input type="range" data-field="offset" min="-180" max="180" step="1" value="0" aria-label="Minutes from the moment" />
                <span class="figure-slider-scale" aria-hidden="true">{["−3", "0", "+3"].map((mark, i) => <span class="figure-slider-mark" style={`left: ${i * 50}%`}>{mark}{i !== 1 && <span class="figure-slider-unit"> h</span>}</span>)}</span>
            </span>
            <output data-field="offsetValue"></output>
        </label>
        <figcaption>
            <span class="subfigure-title">lunar eclipse</span>, the same from anywhere
            <span data-field="status" class="result"></span>
        </figcaption>
    </figure>
</div>
    <figcaption class="figure-caption">
        Eclipses, both zenith up. (a) The Moon in front of the Sun. (b) The Moon in Earth's{" "}
        <Term of="Umbra">umbra</Term> and <Term of="Penumbra">penumbra</Term>. Magnified,
        discs, shadows and horizon true to each other. Corona modified from a{" "}
        <a href="https://philhart.com/exmouth-eclipse/" target="_blank" rel="noopener">photograph by Phil Hart</a> of the
        total eclipse of April 20, 2023, from Exmouth, Western Australia. The sliders move the moment two hours either
        way under (a), and three under (b), from wherever it was last set, the maximum after a jump.
    </figcaption>
</figure>

<script>
    import "./eclipse";
</script>
