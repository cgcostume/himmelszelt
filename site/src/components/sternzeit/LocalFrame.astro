---
import Term from "../Term.astro";
import Try from "../Try.astro";
import "./sternzeit.css";
import TimeSlider from "./TimeSlider.astro";
---

<figure class="scene-frame" id="local-frame">
    <div class="frame-scene" data-export="local-frame" data-download-beside=".frame-options > .view-toggle">
        <svg class="dome-layer zdog" data-layer="below" aria-hidden="true"></svg>
        <svg class="dome-layer zdog" data-layer="ground" aria-hidden="true"></svg>
        <svg class="dome-layer zdog" data-layer="above" aria-hidden="true"></svg>
        <div class="frame-labels" aria-hidden="true"></div>
        <div class="frame-options">
            <button type="button" class="view-toggle" data-field="labels" aria-pressed="true" title="Show or hide the annotations, all but the axes and the compass">show labels</button>
        </div>
        <p class="vis-credit footnote">
            Drag to rotate. Visualized with <a href="https://zzz.dog/" target="_blank" rel="noopener">Zdog</a>.
        </p>
    </div>
    <TimeSlider />
    <figcaption class="figure-caption">
        The observer's frame at the chosen place and moment: the horizon, the ENU axes (x east, y north, z up) and the
        meridian (dotted). The Sun,
        the Moon (gray) and the direction to one of them (arrow), with its{" "}
        <Term of="Horizontal coordinates">horizontal coordinates</Term> (accent), the azimuth A and the altitude h. The
        celestial pole at the latitude φ, and the celestial equator, dashed below the horizon. To no scale but the
        angles.
        <Try label="Berlin at sunset on June 21" set="date=2026-06-21T19:34Z&lat=52.52&lon=13.4" fig="local-frame">
            the Sun sets in the northwest, at an azimuth of 312°, 42° past due west.
        </Try>
    </figcaption>
</figure>

<script>
    import "./localframe";
</script>
