---
import Term from "../Term.astro";
import "./sternzeit.css";

// The coordinate systems from a body's ecliptical position to the renderer's vector: down the middle each position and
// the conversion that turns it into the next one, with its arguments; to the left of each position the call in sun.*
// and moon.* that returns it directly, all the steps before it in one.
type Space = { term: string | null; name: string; coords: string; direct: string; likely?: boolean };
type Step = { fn: string; args: string; space: Space };
const start: Space = {
    term: "Ecliptic coordinates",
    name: "ecliptic",
    coords: "l, β",
    direct: "apparentEclipticalPosition(t)",
};
const steps: Step[] = [
    {
        fn: "eclipticalToEquatorial",
        args: "({ l, β }, ε)",
        space: { term: "Equatorial coordinates", name: "equatorial", coords: "α, δ", direct: "apparentPosition(t)" },
    },
    {
        fn: "equatorialToTopocentric",
        args: "({ α, δ }, π, θ, observer)",
        space: {
            term: "Topocentric",
            name: "topocentric",
            coords: "α′, δ′",
            direct: "topocentricPosition(time, observer)",
        },
    },
    {
        fn: "equatorialToHorizontal",
        args: "({ α′, δ′ }, θ, observer)",
        space: {
            term: "Horizontal coordinates",
            name: "horizontal",
            coords: "A, h",
            direct: "horizontalPosition(time, observer)",
            likely: true,
        },
    },
    {
        fn: "horizontalToDirection",
        args: "({ A, h })",
        space: { term: null, name: "ENU", coords: "x, y, z", direct: "direction(time, observer)", likely: true },
    },
];
// Rows: the ecliptical position, then a conversion and its result a step, with the divider after the first.
const DIVIDER_ROW = 4;
const rowOf = (i: number) => 2 + 2 * i + (i >= 1 ? 1 : 0);
---

<figure class="scene-frame pipeline-figure" id="coordinate-pipeline">
    <div class="pipeline-givens">
        <div class="flow flow-moment">
            <span class="flow-node flow-concept" style="grid-area: 2 / 1">moment</span>
            <span class="flow-edge" style="grid-area: 1 / 2 / 3"></span>
            <span class="flow-node" style="grid-area: 2 / 3">Date</span>
            <span class="flow-edge" style="grid-area: 1 / 4 / 3"><code>fromDate</code></span>
            <span class="flow-node" style="grid-area: 2 / 5">time</span>
            <span class="flow-edge" style="grid-area: 1 / 6 / 3"><code>apparentSiderealTime</code></span>
            <span class="flow-node" style="grid-area: 2 / 7">θ</span>
            <span class="flow-elbow" style="grid-area: 2 / 6 / 5"></span>
            <span class="flow-edge branch" style="grid-area: 3 / 6 / 5"><code>julianEphemerisDay</code></span>
            <span class="flow-node flow-continues" style="grid-area: 4 / 7">t</span>
            <span class="flow-node flow-resumed" style="grid-area: 7 / 2 / 8 / 6">t</span>
            <span class="flow-edge" style="grid-area: 6 / 6 / 8"><code>earth.trueObliquity</code></span>
            <span class="flow-node" style="grid-area: 7 / 7">ε</span>
            <span class="flow-elbow" style="grid-area: 7 / 6 / 10"></span>
            <span class="flow-edge branch" style="grid-area: 8 / 6 / 10"><code>equatorialHorizontalParallax</code></span>
            <span class="flow-node" style="grid-area: 9 / 7">π</span>
        </div>
        <div class="flow">
            <span class="flow-node flow-concept" style="grid-area: 2 / 1">place</span>
            <span class="flow-edge" style="grid-area: 1 / 2 / 3"></span>
            <span class="flow-node" style="grid-area: 2 / 3">
                observer = &lbrace; latitude, longitude,&nbsp;<span class="flow-optional" title="Optional">heightM</span>&nbsp;&rbrace;
            </span>
        </div>
    </div>
    <div class="pipeline">
        <div class="pipeline-direct" style="grid-row: 1"><code>{start.direct}</code></div>
        <div class="pipeline-space first" style="grid-row: 1">
            <span class="pipeline-space-name"><Term of={start.term!}>{start.name}</Term> {start.coords}</span>
        </div>
        {
            steps.map(({ fn, args, space: { term, name, coords, direct, likely } }, i) => (
                <>
                    <div class="pipeline-function" style={`grid-row: ${rowOf(i)}`}>
                        <code>{fn}</code>
                        <code class="pipeline-args">{args}</code>
                    </div>
                    <div
                        class={`pipeline-direct${likely ? " likely" : ""}${i === 0 ? " into-divider" : ""}`}
                        style={`grid-row: ${rowOf(i) + 1}`}
                    >
                        <code>{direct}</code>
                    </div>
                    <div
                        class={`pipeline-space${i === steps.length - 1 ? " last" : i === 0 ? " into-divider" : ""}`}
                        style={`grid-row: ${rowOf(i) + 1}`}
                    >
                        <span class="pipeline-space-name">
                            {term ? <Term of={term}>{name}</Term> : name} {coords}
                        </span>
                    </div>
                </>
            ))
        }
        <div class="pipeline-through" style={`grid-row: ${DIVIDER_ROW}`}></div>
        <div class="pipeline-divider" style={`grid-row: ${DIVIDER_ROW}`}>
            <span class="pipeline-scope">the same for everyone on Earth</span>
            <span class="pipeline-divider-line"></span>
            <span class="pipeline-scope">specific to the observer</span>
        </div>
    </div>
    <figcaption class="figure-caption">
        From the moment and the place to the renderer's vector. Over the line, where the inputs come from, each function
        on its arrow. Under it, the positions (accent), each conversion with its arguments, and to the left the call that
        returns each position directly, highlighted the two a renderer mostly needs.
    </figcaption>
</figure>
