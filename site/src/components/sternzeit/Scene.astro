---
import Term from "../Term.astro";
import "./sternzeit.css";
import TimeSlider from "./TimeSlider.astro";
---

<figure class="scene-frame wide" id="armillary-sphere">
    <div id="scene" data-export="armillary-sphere">
        <button type="button" class="view-toggle" data-field="labels" aria-pressed="true" title="Show or hide the labels">show labels</button>
        <svg id="stage" class="zdog" aria-hidden="true"></svg>
        <svg class="scene-annotations" aria-hidden="true">
            <path class="annotation-arrow" data-annotation="observer"></path>
            <polygon class="annotation-arrowhead" data-annotation="observer"></polygon>
            <path class="annotation-arrow" data-annotation="equinox"></path>
            <polygon class="annotation-arrowhead" data-annotation="equinox"></polygon>
            <path class="annotation-arrow" data-annotation="eclipticAxis"></path>
            <polygon class="annotation-arrowhead" data-annotation="eclipticAxis"></polygon>
        </svg>
        <span class="scene-annotation" data-annotation="observer" data-export-text>observer</span>
        <span class="scene-annotation" data-annotation="ecliptic" data-export-text>ecliptic</span>
        <span class="scene-annotation" data-annotation="equinox" data-export-text>vernal equinox</span>
        <span class="scene-annotation pole-label" data-annotation="north" data-export-text>N</span>
        <span class="scene-annotation pole-label" data-annotation="south" data-export-text>S</span>
        <span class="scene-annotation" data-annotation="eclipticAxis" data-export-text>ecliptic axis</span>
        <div class="altaz-panels">
            <div class="altaz-panel altaz-panel-sun" data-export="sun-locked">
                <svg id="sunView" aria-hidden="true"></svg>
                <span class="altaz-caption"><span class="subfigure-title">sun-locked</span></span>
            </div>
            <div class="altaz-panel altaz-panel-moon" data-export="moon-locked">
                <svg id="moonView" aria-hidden="true"></svg>
                <span class="altaz-caption"><span class="subfigure-title">moon-locked</span></span>
            </div>
        </div>
        <p class="vis-credit footnote">
            Drag to rotate. Visualized with <a href="https://zzz.dog/" target="_blank" rel="noopener">Zdog</a>.
        </p>
    </div>
    <TimeSlider />
    <figcaption class="figure-caption">
        An <Term of="Armillary sphere">armillary sphere</Term>: Earth's equator and axis, its north (N) and south (S)
        pole, the ecliptic and its axis, the vernal equinox, the observer's latitude circle and meridian, and the Sun and
        the Moon in their directions from Earth's center, all in geocentric equatorial coordinates. Distances are
        schematic, the Sun and the Moon symbols, not to scale. (a, b) The sky of the chosen place around the Sun and
        around the Moon, each held at the center while the horizon moves; an arrow points to
        the other body when it is out of view.
    </figcaption>
</figure>

<script>
    import "./scene";
</script>
