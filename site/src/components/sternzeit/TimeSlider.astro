---
// The time of day on the chosen clock, the date kept: under the moon calendar and the armillary sphere (see timeofday.ts).
---

<label class="figure-slider" data-time-of-day title="The time of day on the chosen clock: drag, or turn the mouse wheel">
    <span class="note">Time</span>
    <span class="figure-slider-rail">
        <input type="range" data-field="time" min="0" max="1440" step="5" aria-label="Time of day" />
        <span class="figure-slider-scale" aria-hidden="true">
            {["00", "06", "12", "18", "24"].map((hour, i) => <span class="figure-slider-mark" style={`left: ${i * 25}%`}>{hour}</span>)}
        </span>
    </span>
    <output data-field="timeValue"></output>
</label>

<script>
    import { timeOfDaySliders } from "./timeofday";
    timeOfDaySliders();
</script>
