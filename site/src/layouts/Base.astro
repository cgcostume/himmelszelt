---
import { getCollection } from "astro:content";
import Cyanometer from "../components/Cyanometer.astro";
import { CYANOMETER_STEPS, DEFAULT_STEPS, LIGHT_FROM_STEP, STORAGE_KEY, stepColor } from "../lib/cyanometer";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
const current = Astro.url.pathname.replace(/\/$/, "");
const colors = Array.from({ length: CYANOMETER_STEPS }, (_, step) => stepColor(step));
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark light" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@300..700&family=Roboto+Mono:wght@300..700&display=swap"
            rel="stylesheet"
        />
        {/* The accent a reader picked on the cyanometer (see Cyanometer.astro), and the theme it picks, before the first paint. */}
        <script is:inline define:vars={{ key: STORAGE_KEY, colors, lightFrom: LIGHT_FROM_STEP, defaults: DEFAULT_STEPS }}>
            let step = defaults[matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark"];
            try {
                const stored = localStorage.getItem(key);
                if (stored !== null && colors[Number(stored)]) step = Number(stored);
            } catch {}
            document.documentElement.style.setProperty("--cyanometer", colors[step]);
            document.documentElement.dataset.theme = step >= lightFrom ? "light" : "dark";
        </script>
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href={`${base}/`}>himmelszelt / sternwarte</a>
            <span class="beta" title="Pre-1.0: the APIs can still change">beta</span>
            {/* The chapters' burger where they fold, the repository and the theme, together, apart from the chapters. */}
            <span class="header-tools">
                {/* Only shown where the chapters no longer fit on one line; see the script at the end of the body. */}
                <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Chapters">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5h12M2 8h12M2 11.5h12" /></svg>
                </button>
                <a class="header-github" href="https://github.com/cgcostume/himmelszelt" target="_blank" rel="noopener" aria-label="himmelszelt on GitHub" title="himmelszelt on GitHub">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
                </a>
                {/* Turns the page light or dark, by moving the cyanometer's step (see Cyanometer.astro). One icon that turns from the
                    Sun into the Moon and back: a shadow disc slides over the Sun's disc and leaves a crescent, while the rays draw in. */}
                <button class="theme-toggle" type="button" aria-label="A light or a dark page" title="A light or a dark page; most figures read better with dark around them">
                    <svg class="theme-icon" viewBox="0 0 16 16" aria-hidden="true">
                        <mask id="theme-bite" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="16">
                            <rect width="16" height="16" fill="white" />
                            <circle class="theme-shadow" cx="10.6" cy="6.2" r="4" fill="black" />
                        </mask>
                        <g class="theme-rays">
                            {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => <line x1="8" y1="1" x2="8" y2="2.6" transform={`rotate(${a} 8 8)`} />)}
                        </g>
                        <circle class="theme-disc" cx="8" cy="8" r="4" mask="url(#theme-bite)" />
                    </svg>
                </button>
            </span>
            <nav id="site-nav">
                {
                    chapters.map((c) => (
                        <a href={`${base}/${c.id}/`} aria-current={current === `${base}/${c.id}` ? "page" : undefined}>
                            {c.data.title}
                        </a>
                    ))
                }
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <span>
                <a href={`${base}/#about`}>himmelszelt</a>, small TypeScript + WebGPU libraries for rendering the sky, is
                the successor of <a href="https://github.com/cgcostume/osghimmel" target="_blank" rel="noopener">osgHimmel</a>.
                <br />
                Designed and directed by <a href="https://daniellimberger.de" target="_blank" rel="noopener">Daniel Limberger</a>,
                implemented with <a href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code</a>.
            </span>
            <span>
                &copy; {new Date().getFullYear()} Daniel Limberger. Code{" "}
                <a href="https://github.com/cgcostume/himmelszelt/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>,
                text and figures <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>.
            </span>
            <Cyanometer />
        </footer>
        <script>
            // A copy button on every code block, the chapters' own and those a figure builds later: wrapped, so the button
            // stays in the corner while the block scrolls sideways under it.
            const COPY_ICON =
                '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />' +
                '<path d="M10.5 3.5v-1a1 1 0 0 0-1-1h-7a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h1" /></svg>';
            const addCopy = (pre: HTMLPreElement) => {
                if (pre.parentElement?.classList.contains("code-block")) return;
                const block = Object.assign(document.createElement("div"), { className: "code-block" });
                pre.replaceWith(block);
                const button = Object.assign(document.createElement("button"), {
                    type: "button",
                    className: "code-copy",
                    title: "Copy the code",
                    innerHTML: COPY_ICON,
                });
                button.setAttribute("aria-label", "Copy the code");
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ""));
                        button.title = "Copied";
                    } catch {
                        button.title = "Copying failed, this browser did not allow it";
                    }
                    button.toggleAttribute("data-copied", true);
                    setTimeout(() => {
                        button.removeAttribute("data-copied");
                        button.title = "Copy the code";
                    }, 1500);
                });
                block.append(pre, button);
            };
            const addCopies = (root: ParentNode) => root.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach(addCopy);
            addCopies(document);
            new MutationObserver((records) => {
                for (const record of records) {
                    for (const node of record.addedNodes) {
                        if (node instanceof HTMLPreElement && node.matches(".astro-code")) addCopy(node);
                        else if (node instanceof Element) addCopies(node);
                    }
                }
            }).observe(document.body, { childList: true, subtree: true });

            // Figure references get the numbers the captions count in CSS: figures with a caption, in page order.
            const figures = [...document.querySelectorAll("figure[id]:has(> .figure-caption)")].map((f) => f.id);
            for (const ref of document.querySelectorAll<HTMLAnchorElement>("a.figref")) {
                const number = figures.indexOf(ref.hash.slice(1)) + 1;
                if (number > 0) ref.textContent = `Figure\u00a0${number}`;
            }
            // Table references likewise, and a folded table opens when one is followed.
            const tables = [...document.querySelectorAll("[data-table][id]")].map((t) => t.id);
            for (const ref of document.querySelectorAll<HTMLAnchorElement>("a.tabref")) {
                const number = tables.indexOf(ref.hash.slice(1)) + 1;
                if (number > 0) ref.textContent = `Table\u00a0${number}`;
                ref.addEventListener("click", () => {
                    const fold = document.querySelector(`${ref.hash} details`);
                    if (fold instanceof HTMLDetailsElement) fold.open = true;
                });
            }
            // A reference stays on the line of the word before it, so it never ends a paragraph alone: "here (Table 4)."
            // wraps as one word, which text-wrap: pretty then keeps company.
            for (const ref of document.querySelectorAll("a.figref, a.tabref")) {
                const before = ref.previousSibling;
                if (before instanceof Text) before.data = before.data.replace(/ (\(?)$/, "\u00a0$1");
            }
            // Keeps glossary and citation tooltips inside the viewport: shifted left by however far they would overflow.
            const host = (event: Event) => (event.target as Element).closest?.(".term, .cite") ?? null;
            const fit = (element: Element | null) => {
                const tip = element?.querySelector<HTMLElement>(".term-tip");
                if (!tip) return;
                tip.style.setProperty("--tip-shift", "0px");
                const overflow = tip.getBoundingClientRect().right - (document.documentElement.clientWidth - 16);
                if (overflow > 0) tip.style.setProperty("--tip-shift", `${-overflow}px`);
            };
            document.addEventListener("pointerover", (event) => fit(host(event)));
            document.addEventListener("focusin", (event) => fit(host(event)));

            // A finger cannot hover: on a touch screen the browser fakes it for a moment and then drops it again, taking
            // the definition with it. So a tap on a term keeps it open, until the next tap on it or anywhere else.
            document.addEventListener("click", (event) => {
                // The cyanometer's term opens the instrument instead (see Cyanometer.astro).
                const target = event.target as Element;
                const term = target.closest?.(".cyanometer-trigger") ? null : (target.closest?.(".term") ?? null);
                for (const open of document.querySelectorAll("[data-tip-open]")) {
                    if (open !== term) open.removeAttribute("data-tip-open");
                }
                if (!term) return;
                term.toggleAttribute("data-tip-open");
                fit(term);
            });

            // The chapter list folds behind the burger on a narrow screen (the CSS decides where); it opens on a
            // press and closes again on the next one, on Escape, or on a press anywhere else.
            const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
            const nav = document.getElementById("site-nav");
            const setNav = (open: boolean) => {
                nav?.toggleAttribute("data-open", open);
                toggle?.setAttribute("aria-expanded", String(open));
            };
            toggle?.addEventListener("click", (event) => {
                event.stopPropagation();
                setNav(!nav?.hasAttribute("data-open"));
            });
            document.addEventListener("click", (event) => {
                if (!nav?.contains(event.target as Node)) setNav(false);
            });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") setNav(false);
            });
        </script>
    </body>
</html>
