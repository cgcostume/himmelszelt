---
import { getCollection } from "astro:content";
import Term from "../components/Term.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const chapters = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
const current = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&family=Roboto+Mono:wght@300;400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href={`${base}/`}>himmelszelt / sternwarte</a>
            <span class="beta" title="Pre-1.0: the APIs can still change">beta</span>
            {/* Only shown where the chapters no longer fit on one line; see the script at the end of the body. */}
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Chapters">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5h12M2 8h12M2 11.5h12" /></svg>
            </button>
            <nav id="site-nav">
                {
                    chapters.map((c) => (
                        <a href={`${base}/${c.id}/`} aria-current={current === `${base}/${c.id}` ? "page" : undefined}>
                            {c.data.title}
                        </a>
                    ))
                }
                <a href="https://github.com/cgcostume/himmelszelt" target="_blank" rel="noopener">GitHub ↗</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <span>
                Designed and directed by{" "}
                <a href="https://daniellimberger.de" target="_blank" rel="noopener">Daniel Limberger</a>, implemented with{" "}
                <a href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code</a>. The successor of{" "}
                <a href="https://github.com/cgcostume/osghimmel" target="_blank" rel="noopener">osgHimmel</a>.
            </span>
            <span>
                &copy; {new Date().getFullYear()} Daniel Limberger. Code under the{" "}
                <a href="https://github.com/cgcostume/himmelszelt/blob/main/LICENSE" target="_blank" rel="noopener">MIT
                license</a>, text and figures under{" "}
                <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>.
            </span>
            <span>The accent blue is modeled on a step of Saussure's <Term of="Cyanometer">cyanometer</Term>.</span>
        </footer>
        <script>
            // A copy button on every code block, the chapters' own and those a figure builds later: wrapped, so the button
            // stays in the corner while the block scrolls sideways under it.
            const COPY_ICON =
                '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />' +
                '<path d="M10.5 3.5v-1a1 1 0 0 0-1-1h-7a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h1" /></svg>';
            const addCopy = (pre: HTMLPreElement) => {
                if (pre.parentElement?.classList.contains("code-block")) return;
                const block = Object.assign(document.createElement("div"), { className: "code-block" });
                pre.replaceWith(block);
                const button = Object.assign(document.createElement("button"), {
                    type: "button",
                    className: "code-copy",
                    title: "Copy the code",
                    innerHTML: COPY_ICON,
                });
                button.setAttribute("aria-label", "Copy the code");
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ""));
                        button.title = "Copied";
                    } catch {
                        button.title = "Copying failed, this browser did not allow it";
                    }
                    button.toggleAttribute("data-copied", true);
                    setTimeout(() => {
                        button.removeAttribute("data-copied");
                        button.title = "Copy the code";
                    }, 1500);
                });
                block.append(pre, button);
            };
            const addCopies = (root: ParentNode) => root.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach(addCopy);
            addCopies(document);
            new MutationObserver((records) => {
                for (const record of records) {
                    for (const node of record.addedNodes) {
                        if (node instanceof HTMLPreElement && node.matches(".astro-code")) addCopy(node);
                        else if (node instanceof Element) addCopies(node);
                    }
                }
            }).observe(document.body, { childList: true, subtree: true });

            // Figure references get the numbers the captions count in CSS: figures with a caption, in page order.
            const figures = [...document.querySelectorAll("figure[id]:has(> .figure-caption)")].map((f) => f.id);
            for (const ref of document.querySelectorAll<HTMLAnchorElement>("a.figref")) {
                const number = figures.indexOf(ref.hash.slice(1)) + 1;
                if (number > 0) ref.textContent = `figure ${number}`;
            }
            // Keeps glossary and citation tooltips inside the viewport: shifted left by however far they would overflow.
            const host = (event: Event) => (event.target as Element).closest?.(".term, .cite") ?? null;
            const fit = (element: Element | null) => {
                const tip = element?.querySelector<HTMLElement>(".term-tip");
                if (!tip) return;
                tip.style.setProperty("--tip-shift", "0px");
                const overflow = tip.getBoundingClientRect().right - (document.documentElement.clientWidth - 16);
                if (overflow > 0) tip.style.setProperty("--tip-shift", `${-overflow}px`);
            };
            document.addEventListener("pointerover", (event) => fit(host(event)));
            document.addEventListener("focusin", (event) => fit(host(event)));

            // A finger cannot hover: on a touch screen the browser fakes it for a moment and then drops it again, taking
            // the definition with it. So a tap on a term keeps it open, until the next tap on it or anywhere else.
            document.addEventListener("click", (event) => {
                const term = (event.target as Element).closest?.(".term") ?? null;
                for (const open of document.querySelectorAll("[data-tip-open]")) {
                    if (open !== term) open.removeAttribute("data-tip-open");
                }
                if (!term) return;
                term.toggleAttribute("data-tip-open");
                fit(term);
            });

            // The chapter list folds behind the burger on a narrow screen (the CSS decides where); it opens on a
            // press and closes again on the next one, on Escape, or on a press anywhere else.
            const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
            const nav = document.getElementById("site-nav");
            const setNav = (open: boolean) => {
                nav?.toggleAttribute("data-open", open);
                toggle?.setAttribute("aria-expanded", String(open));
            };
            toggle?.addEventListener("click", (event) => {
                event.stopPropagation();
                setNav(!nav?.hasAttribute("data-open"));
            });
            document.addEventListener("click", (event) => {
                if (!nav?.contains(event.target as Node)) setNav(false);
            });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") setNav(false);
            });
        </script>
    </body>
</html>
